{
  "name": "campusmate-web-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/**/*.test.mjs",
    "test:e2e:study": "node scripts/run-python.mjs tests/e2e/run_study_e2e.py",
    "test:e2e:agent": "node scripts/run-python.mjs tests/e2e/run_agent_golden_paths.py",
    "test:e2e:classroom": "node scripts/run-python.mjs tests/e2e/run_classroom_e2e.py",
    "test:e2e:learner-state": "node scripts/run-python.mjs tests/e2e/learner-state-closed-loop.py",
    "test:all": "npm test && npm run test:e2e:study && npm run test:e2e:agent && npm run test:e2e:learner-state"
  },
  "dependencies": {
    "@designcodeio/threeui": "^1.2.0",
    "@phosphor-icons/react": "^2.1.7",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "axios": "^1.11.0",
    "gsap": "^3.15.0",
    "marked": "^18.0.7",
    "motion": "^13.2.0",
    "ogl": "^1.0.11",
    "open-glass-ui": "^0.3.0",
    "postprocessing": "^6.39.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-flip-toolkit": "7.2.4",
    "react-router-dom": "^6.30.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
