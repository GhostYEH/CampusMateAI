.extract-panel {
  padding: 24rpx;
  border-left: 7rpx solid var(--primary);
  border-radius: 30rpx;
}

.notice-page-body{padding-bottom:72rpx}.source-card{padding:28rpx;border-radius:30rpx}.source-row{min-height:106rpx;display:flex;align-items:center;gap:18rpx;border-top:1rpx solid var(--line)}.source-row:nth-child(2){margin-top:12rpx;border-top:0}.source-mark{width:66rpx;height:66rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:20rpx;color:#fff;background:#55a66f;font-size:22rpx;font-weight:750}.source-mark.learning{background:#ff9a52}.source-mark.campus{background:var(--primary)}.source-copy{min-width:0;flex:1}.source-copy view{color:var(--text);font-size:22rpx;font-weight:680}.source-copy text{display:block;margin-top:7rpx;color:var(--muted);font-size:17rpx;line-height:1.45}.source-state{flex:none;padding:7rpx 10rpx;border-radius:9rpx;color:var(--primary);background:var(--primary-soft);font-size:16rpx}.source-state.limited{color:var(--accent);background:var(--accent-soft)}.source-state.online{color:var(--success);background:var(--success-soft)}.capability-note{padding:20rpx;border-radius:18rpx;color:var(--muted);background:var(--background);font-size:17rpx;line-height:1.6}.capability-title{margin-bottom:4rpx;color:var(--text);font-size:19rpx;font-weight:700}.clipboard-button{width:100%;height:70rpx;margin-top:20rpx;border:1rpx solid var(--primary);color:var(--primary);background:var(--primary-soft);font-size:20rpx;font-weight:680}.inbox-section{margin-top:28rpx}.filter-scroll{width:100%;margin-top:16rpx;white-space:nowrap}.filter-row{display:inline-flex;gap:12rpx;padding-right:24rpx}.filter-chip{width:auto;min-width:94rpx;height:58rpx;margin:0;padding:0 20rpx;border:1rpx solid var(--line);border-radius:999rpx;color:var(--muted);background:var(--surface);font-size:18rpx}.filter-chip.active{border-color:var(--primary);color:#fff;background:var(--primary)}.inbox-search{height:68rpx;margin-top:16rpx;padding:0 20rpx;border:1rpx solid var(--line);border-radius:16rpx;color:var(--text);background:var(--surface);font-size:19rpx}.clear-button,.retry-button{width:auto;margin:0;padding:8rpx 15rpx;color:var(--primary);background:var(--primary-soft);font-size:18rpx}.local-item{width:100%;margin:0;text-align:left}.notice-preview{margin-top:7rpx;overflow:hidden;color:var(--muted);font-size:17rpx;text-overflow:ellipsis;white-space:nowrap}.detail-arrow{color:var(--muted);font-size:38rpx}.result-field-label{margin-top:17rpx;color:var(--muted);font-size:17rpx}.result-input{height:66rpx;margin-top:7rpx;padding:0 14rpx;border:1rpx solid var(--line);border-radius:12rpx;color:var(--text);background:var(--background);font-size:20rpx}.result-field-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.detail-mask{position:fixed;z-index:999;inset:0;display:flex;align-items:flex-end;background:rgba(17,25,39,.48)}.detail-sheet{width:100%;padding:14rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:34rpx 34rpx 0 0;background:var(--surface);box-sizing:border-box}.detail-grabber{width:72rpx;height:8rpx;margin:0 auto 24rpx;border-radius:999rpx;background:var(--line)}.detail-title{color:var(--text);font-size:30rpx;font-weight:760}.detail-meta{margin-top:8rpx;color:var(--muted);font-size:18rpx}.detail-content{max-height:340rpx;margin:24rpx 0;padding:20rpx;border-radius:18rpx;color:var(--text);background:var(--background);font-size:21rpx;line-height:1.7;box-sizing:border-box}.danger-link{margin-top:10rpx;color:#d65f58;background:transparent;font-size:19rpx}

.extract-head,
.section-head,
.result-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-label {
  flex: none;
  padding: 7rpx 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 17rpx;
  font-weight: 650;
}

.notice-input {
  width: 100%;
  height: 218rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--text);
  background: var(--background);
  font-size: 21rpx;
  line-height: 1.6;
}

.extract-button {
  margin-top: 14rpx;
}

.extract-panel .mock-note {
  margin-top: 11rpx;
  text-align: center;
}

.result-panel {
  margin-top: 16rpx;
  display: flex;
  overflow: hidden;
  border: 1rpx solid rgba(78, 140, 106, 0.22);
  border-radius: 30rpx;
  background: var(--surface);
}

.result-accent {
  width: 6rpx;
  flex: none;
  background: var(--success);
}

.result-content {
  min-width: 0;
  flex: 1;
  padding: 22rpx;
}

.result-title {
  color: var(--text);
  font-size: 23rpx;
  font-weight: 700;
}

.confidence {
  padding: 6rpx 9rpx;
  border-radius: 7rpx;
  color: var(--success);
  background: var(--success-soft);
  font-size: 16rpx;
}

.result-name {
  margin-top: 18rpx;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 720;
}

.result-meta {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 19rpx;
}

.step-title {
  margin-top: 21rpx;
  color: var(--muted);
  font-size: 18rpx;
  font-weight: 650;
}

.result-step {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  color: var(--text);
  font-size: 20rpx;
  line-height: 1.45;
}

.step-index {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  border-radius: 9rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 16rpx;
  font-weight: 700;
}

.save-button {
  margin-top: 22rpx;
}

.view-task-button {
  margin: 9rpx auto 0;
  color: var(--primary);
  background: transparent;
  font-size: 19rpx;
}

.notice-section {
  margin-top: 24rpx;
}

.notice-section .section-title {
  font-size: 29rpx;
}

.search {
  width: 238rpx;
  height: 62rpx;
  padding: 0 15rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  color: var(--text);
  background: var(--surface);
  font-size: 19rpx;
}

.notice-list {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--surface);
}

.notice-item {
  min-height: 100rpx;
  padding: 18rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-top: 1rpx solid var(--line);
  box-sizing: border-box;
}

.notice-item:first-child {
  border-top: 0;
}

.notice-status {
  width: 8rpx;
  height: 36rpx;
  flex: none;
  border-radius: 999rpx;
  background: var(--line);
}

.notice-status.unread {
  background: var(--accent);
}

.notice-main {
  min-width: 0;
  flex: 1;
}

.notice-title {
  overflow: hidden;
  color: var(--text);
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-meta {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.unread-label {
  flex: none;
  padding: 5rpx 7rpx;
  border-radius: 6rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 16rpx;
}

@media (max-width: 350px) {
  .search {
    width: 205rpx;
  }
}
