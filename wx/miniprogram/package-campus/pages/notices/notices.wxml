<view class="page {{darkMode ? 'dark' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}">
  <campus-header title="通知与提醒" subtitle="重要信息，清楚整理" mode="{{mockMode ? '演示数据' : '真实后端'}}" back />
  <view class="page-body notice-page-body">
    <view class="source-card surface enter">
      <view class="section-title">通知来源</view>
      <view class="source-row"><view class="source-mark">微</view><view class="source-copy"><view>微信、企业微信与 QQ</view><text>通过剪贴板主动导入；小程序不能监听其他应用通知</text></view><view class="source-state limited">平台受限</view></view>
      <view class="source-row"><view class="source-mark learning">学</view><view class="source-copy"><view>学习通</view><text>通过校园账户同步课程、作业与通知</text></view><view class="source-state">后端同步</view></view>
      <view class="source-row"><view class="source-mark campus">校</view><view class="source-copy"><view>校园后端</view><text>站内通知与教务数据</text></view><view class="source-state online">{{error ? '暂不可用' : '已连接'}}</view></view>
      <view class="capability-note"><view class="capability-title">平台能力说明</view><text>Android 可经系统授权监听通知；微信小程序只能在你点击后读取剪贴板。所有导入内容仅保存在本机，提取时才发送通知正文到已配置的校园后端。</text></view>
    </view>

    <view id="manual-extract" class="extract-panel surface enter enter-delay-1">
      <view class="extract-head"><view><view class="section-title">手动整理</view><view class="section-subtitle">粘贴通知，提取标题、来源、截止时间与步骤</view></view><view class="ai-label">AI 辅助</view></view>
      <button class="clipboard-button" bindtap="importClipboard">读取剪贴板</button>
      <textarea class="notice-input" value="{{sourceText}}" maxlength="2000" placeholder="粘贴班群、公众号、学习通或教务通知正文" bindinput="onSourceText"></textarea>
      <button class="primary-button extract-button" disabled="{{!sourceText || extracting}}" loading="{{extracting}}" bindtap="extract">{{extracting ? '正在提取…' : '开始智能提取'}}</button>
      <view class="mock-note">提取结果仅供确认，保存前请核对原通知。</view>
    </view>

    <view wx:for="{{results}}" wx:key="id" wx:for-item="result" class="result-panel enter">
      <view class="result-accent"></view><view class="result-content">
        <view class="result-top"><view class="result-title">提取结果</view><view class="confidence">置信度 {{result.confidence * 100}}%</view></view>
        <view class="result-field-label">标题</view><input class="result-input" value="{{result.title}}" data-id="{{result.id}}" data-field="title" bindinput="updateResultField" />
        <view class="result-field-row"><view><view class="result-field-label">来源</view><input class="result-input" value="{{result.source}}" data-id="{{result.id}}" data-field="source" bindinput="updateResultField" /></view><view><view class="result-field-label">截止时间</view><input class="result-input" value="{{result.deadline}}" data-id="{{result.id}}" data-field="deadline" bindinput="updateResultField" /></view></view>
        <view class="step-title">识别出的事项</view><view wx:for="{{result.tasks}}" wx:key="*this" class="result-step"><view class="step-index">{{index + 1}}</view><view>{{item}}</view></view>
        <button class="{{result.saved ? 'secondary-button' : 'primary-button'}} save-button" disabled="{{result.saved || !result.title}}" data-id="{{result.id}}" bindtap="saveTask">{{result.saved ? '已保存到待办' : '确认并保存到待办'}}</button>
        <button wx:if="{{result.saved}}" class="view-task-button" bindtap="openTasks">去待办中查看</button>
      </view>
    </view>

    <view class="inbox-section enter">
      <view class="section-head"><view><view class="section-title">最近导入</view><view class="section-subtitle">{{filteredLocalNotices.length}} 条本机记录</view></view><button wx:if="{{localNotices.length}}" class="clear-button" bindtap="clearLocalNotices">清空</button></view>
      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="filter-row"><button wx:for="{{sourceFilters}}" wx:key="value" class="filter-chip {{activeSource === item.value ? 'active' : ''}}" data-source="{{item.value}}" bindtap="selectSource">{{item.label}}</button></view></scroll-view>
      <input class="inbox-search" value="{{query}}" placeholder="搜索标题、来源或正文" bindinput="onQuery" />
      <state-view wx:if="{{filteredLocalNotices.length === 0}}" state="empty" title="暂无匹配导入" description="点击读取剪贴板，或在上方手动粘贴通知" />
      <view wx:else class="notice-list"><button wx:for="{{filteredLocalNotices}}" wx:key="id" class="notice-item local-item" data-id="{{item.id}}" bindtap="openLocalNotice"><view class="notice-status unread"></view><view class="notice-main"><view class="notice-title">{{item.title}}</view><view class="notice-meta">{{item.sourceName}} · 本机导入</view><view class="notice-preview">{{item.content}}</view></view><view class="detail-arrow">›</view></button></view>
    </view>

    <view class="notice-section enter">
      <view class="section-head"><view><view class="section-title">校园通知</view><view class="section-subtitle">{{filteredNotices.length}} 条后端结果</view></view><button class="retry-button" bindtap="load">刷新</button></view>
      <state-view wx:if="{{loading}}" state="loading" title="正在同步通知" description="重要信息马上就好" />
      <state-view wx:elif="{{error}}" state="error" title="通知加载失败" description="{{error}}" actionText="重试" bindaction="load" />
      <state-view wx:elif="{{filteredNotices.length === 0}}" state="empty" title="没有匹配通知" description="换个关键词试试" />
      <view wx:else class="notice-list"><view wx:for="{{filteredNotices}}" wx:key="id" class="notice-item"><view class="notice-status {{item.unread ? 'unread' : ''}}"></view><view class="notice-main"><view class="notice-title">{{item.title}}</view><view class="notice-meta">{{item.source}} · {{item.time}}</view></view><view wx:if="{{item.unread}}" class="unread-label">未读</view></view></view>
    </view>
  </view>
  <view wx:if="{{selectedLocalNotice}}" class="detail-mask" bindtap="closeLocalNotice"><view class="detail-sheet" catchtap="noop"><view class="detail-grabber"></view><view class="detail-title">{{selectedLocalNotice.title}}</view><view class="detail-meta">{{selectedLocalNotice.sourceName}} · 本机导入</view><scroll-view class="detail-content" scroll-y>{{selectedLocalNotice.content}}</scroll-view><button class="primary-button" bindtap="useSelectedNotice">整理为待办</button><button class="danger-link" data-id="{{selectedLocalNotice.id}}" bindtap="deleteLocalNotice">删除本机记录</button></view></view>
</view>
