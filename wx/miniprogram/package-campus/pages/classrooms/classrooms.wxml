<view class="campus-page room-page">
  <secondary-nav title="空教室"></secondary-nav>
  <view class="campus-page-body room-body">
    <view class="room-hero campus-enter">
      <image src="/package-campus/assets/classroom-hero.jpg" mode="aspectFill"></image>
      <view class="room-shade"></view>
      <view class="room-copy"><view>寻找一间安静教室</view><text>按日期和教学楼查询真实空闲时段</text></view>
    </view>

    <view class="query-card campus-enter">
      <view class="query-title">查询条件</view>
      <view class="field-label">日期</view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="select-field">{{date}}<text>›</text></view></picker>
      <view class="field-label">教学楼</view>
      <input class="select-field" value="{{building}}" placeholder="输入教学楼名称（可选）" bindinput="onBuildingInput"></input>
      <button class="query-button" hover-class="button-pressed" bindtap="query">查询空教室</button>
    </view>

    <view class="section-heading"><view>查询结果</view><text>{{classrooms.length}} 间</text></view>
    <state-view wx:if="{{loading}}" state="loading" title="正在查询可用教室"></state-view>
    <state-view wx:elif="{{error}}" state="error" title="查询失败" description="{{error}}" actionText="重试" bindaction="query"></state-view>
    <state-view wx:elif="{{queried && !classrooms.length}}" state="empty" title="暂未查到空教室" description="当前学校后端没有返回符合条件的教室"></state-view>
    <view wx:else class="room-list">
      <view wx:for="{{classrooms}}" wx:key="id" class="room-card campus-enter">
        <view class="room-icon"><image src="/assets/icons/quick-counselor.svg" mode="aspectFit"></image></view>
        <view class="room-detail"><view class="room-name">{{item.building || '教学楼'}} · {{item.room || '教室'}}</view><view class="room-meta">可容纳 {{item.capacity || '--'}} 人</view><view class="slot-list"><text wx:for="{{item.available_slots}}" wx:key="*this">{{item}}</text></view></view>
      </view>
    </view>
  </view>
</view>
