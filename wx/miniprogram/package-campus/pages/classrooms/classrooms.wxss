.room-body{padding-top:116px}.room-hero{position:relative;height:210px;overflow:hidden;border-radius:28px}.room-hero image,.room-shade{position:absolute;inset:0;width:100%;height:100%}.room-shade{background:linear-gradient(90deg,rgba(35,49,75,.82),rgba(41,58,95,.22))}.room-copy{position:relative;z-index:1;width:64%;padding:58px 0 0 27px;color:#fff}.room-copy view{font-size:28px;line-height:1.25;font-weight:800}.room-copy text{display:block;margin-top:15px;color:rgba(255,255,255,.82);font-size:13px;line-height:1.6}.query-card{margin-top:16px;padding:22px;border:1px solid var(--campus-line);border-radius:22px;background:#fff}.query-title{font-size:21px;font-weight:780}.field-label{margin:18px 2px 8px;color:var(--campus-muted);font-size:12px}.select-field{width:100%;height:48px;padding:0 15px;display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;border:1px solid var(--campus-line);border-radius:14px;background:#f8fafb;color:var(--campus-text);font-size:14px}.select-field text{color:var(--campus-muted);font-size:22px}.query-button{height:50px;margin:20px 0 0;border-radius:16px;color:#fff;background:var(--campus-primary);font-size:15px;font-weight:700;line-height:50px}.section-heading{margin:28px 4px 14px;display:flex;align-items:center;justify-content:space-between}.section-heading view{font-size:24px;font-weight:800}.section-heading text{color:var(--campus-muted);font-size:12px}.room-list{display:flex;flex-direction:column;gap:12px}.room-card{padding:18px;display:flex;gap:15px;border:1px solid var(--campus-line);border-radius:20px;background:#fff}.room-icon{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:15px;background:var(--campus-primary-soft)}.room-icon image{width:25px;height:25px}.room-detail{min-width:0;flex:1}.room-name{font-size:17px;font-weight:760}.room-meta{margin-top:6px;color:var(--campus-muted);font-size:12px}.slot-list{margin-top:10px;display:flex;flex-wrap:wrap;gap:6px}.slot-list text{padding:5px 8px;border-radius:999px;color:var(--campus-primary);background:var(--campus-primary-soft);font-size:10px}
.room-body{padding-top:0}
