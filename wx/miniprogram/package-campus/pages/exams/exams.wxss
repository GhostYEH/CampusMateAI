.exam-body{padding-top:116px}.exam-hero{position:relative;height:230px;overflow:hidden;border-radius:28px;color:#fff;background:linear-gradient(140deg,#596af0,#7768ef)}.exam-art{position:absolute;right:-5px;bottom:-12px;width:190px;height:190px;opacity:.96}.exam-hero-copy{position:relative;z-index:1;width:58%;padding:34px 0 0 28px}.eyebrow{font-size:13px;color:rgba(255,255,255,.75)}.exam-hero-title{margin-top:15px;font-size:29px;line-height:1.2;font-weight:800}.exam-hero-meta{margin-top:14px;font-size:14px;color:rgba(255,255,255,.86)}.exam-summary{margin-top:14px;padding:18px 8px;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--campus-line);border-radius:20px;background:#fff}.exam-summary view{text-align:center;border-left:1px solid var(--campus-line)}.exam-summary view:first-child{border-left:0}.exam-summary text{display:block;color:var(--campus-primary);font-size:23px;font-weight:800}.exam-summary label{display:block;margin-top:5px;color:var(--campus-muted);font-size:11px}.section-heading{margin:28px 4px 14px;display:flex;align-items:end;justify-content:space-between}.section-heading view{font-size:24px;font-weight:800}.section-heading text{color:var(--campus-muted);font-size:11px}.exam-group{display:grid;grid-template-columns:54px 1fr;gap:12px;margin-bottom:18px}.date-rail{padding-top:6px;text-align:center}.date-rail view{font-size:16px;font-weight:750}.date-rail text{display:block;margin-top:5px;color:var(--campus-muted);font-size:11px}.exam-list{display:flex;flex-direction:column;gap:12px}.exam-card{padding:20px;border:1px solid var(--campus-line);border-radius:20px;background:#fff;box-shadow:0 7px 22px rgba(53,68,83,.05)}.exam-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px}.exam-name{font-size:18px;font-weight:780}.exam-type{padding:5px 9px;border-radius:999px;color:var(--campus-primary);background:var(--campus-primary-soft);font-size:10px}.exam-row{margin-top:14px;display:flex;gap:14px;font-size:13px}.exam-row text{width:30px;color:var(--campus-muted)}.exam-row view{color:var(--campus-text)}
.exam-body{padding-top:0}
