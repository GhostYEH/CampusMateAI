<view class="campus-page exam-page">
  <secondary-nav title="考试安排"></secondary-nav>
  <view class="campus-page-body exam-body">
    <view class="exam-hero campus-enter">
      <image class="exam-art" src="/package-campus/assets/exam-calendar.png" mode="aspectFit"></image>
      <view class="exam-hero-copy">
        <view class="eyebrow">下一场考试</view>
        <view class="exam-hero-title">{{nextExam ? nextExam.course_name : '考试日程'}}</view>
        <view class="exam-hero-meta">{{nextExam ? nextDate + ' · ' + nextDay : '暂无已同步的考试'}}</view>
        <view class="exam-hero-meta" wx:if="{{nextExam}}">{{nextExam.start_time || '--:--'}} · {{nextExam.location || '地点待定'}}</view>
      </view>
    </view>

    <view class="exam-summary campus-enter">
      <view><text>{{exams.length}}</text><label>考试总数</label></view>
      <view><text>{{groups.length}}</text><label>考试日期</label></view>
      <view><text>{{nextExam && nextExam.seat_number ? nextExam.seat_number : '--'}}</text><label>下一场座位</label></view>
    </view>

    <view class="section-heading"><view>考试日程</view><text>来自真实校园后端</text></view>
    <state-view wx:if="{{loading}}" state="loading" title="正在同步考试安排"></state-view>
    <state-view wx:elif="{{error}}" state="error" title="暂时无法加载" description="{{error}}" actionText="重试" bindaction="load"></state-view>
    <state-view wx:elif="{{!groups.length}}" state="empty" title="暂无考试安排" description="后端暂未返回考试数据"></state-view>
    <view wx:else>
      <view wx:for="{{groups}}" wx:key="date" class="exam-group campus-enter">
        <view class="date-rail"><view>{{item.displayDate}}</view><text>{{item.day}}</text></view>
        <view class="exam-list">
          <view wx:for="{{item.exams}}" wx:for-item="exam" wx:key="id" class="exam-card">
            <view class="exam-card-top"><view class="exam-name">{{exam.course_name}}</view><view class="exam-type">{{exam.exam_type || '考试'}}</view></view>
            <view class="exam-row"><text>时间</text><view>{{exam.start_time || '--:--'}} - {{exam.end_time || '--:--'}}</view></view>
            <view class="exam-row"><text>地点</text><view>{{exam.location || '待设置'}}</view></view>
            <view class="exam-row"><text>座位</text><view>{{exam.seat_number || '待设置'}}</view></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
