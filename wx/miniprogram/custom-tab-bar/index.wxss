.tab-shell {
  --tab-bg: rgba(255, 255, 255, 0.58);
  --tab-line: rgba(255, 255, 255, 0.82);
  --tab-text: #687c89;
  --tab-selected: #5b68f2;
  --tab-selected-line: rgba(132, 143, 255, 0.42);
  --tab-glow: rgba(91, 104, 242, 0.2);
  position: fixed;
  z-index: 999;
  right: 13px;
  bottom: calc(9px + env(safe-area-inset-bottom));
  left: 13px;
}

.tab-shell.dark-tab {
  --tab-bg: rgba(15, 34, 45, 0.68);
  --tab-line: rgba(255, 255, 255, 0.22);
  --tab-text: #a8bac4;
  --tab-selected: #8ac1df;
  --tab-selected-line: rgba(138, 193, 223, 0.42);
  --tab-glow: rgba(88, 170, 219, 0.22);
}

.tab-bar {
  position: relative;
  height: 72px;
  padding: 5px 6px;
  display: flex;
  gap: 0;
  border: 1px solid var(--tab-line);
  border-radius: 60rpx;
  background: var(--tab-bg);
  -webkit-backdrop-filter: blur(24px) saturate(140%);
  backdrop-filter: blur(24px) saturate(140%);
  box-sizing: border-box;
  overflow: hidden;
  box-shadow:
    0 18rpx 46rpx rgba(31, 39, 84, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.78),
    inset 0 -1px 0 rgba(91, 104, 242, 0.1);
}

.tab-bar::before {
  content: '';
  position: absolute;
  z-index: 0;
  top: 0;
  right: 10%;
  left: 10%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.96), transparent);
  opacity: 0.94;
}

.tab-bar::after {
  content: '';
  position: absolute;
  z-index: 0;
  right: -8%;
  bottom: -54%;
  width: 58%;
  height: 120%;
  border-radius: 50%;
  background: radial-gradient(circle, var(--tab-glow) 0%, transparent 68%);
  filter: blur(10px);
  opacity: 0.82;
}

.dark-tab .tab-bar {
  box-shadow:
    0 18rpx 48rpx rgba(0, 0, 0, 0.34),
    inset 0 1px 0 rgba(255, 255, 255, 0.2),
    inset 0 -1px 0 rgba(0, 0, 0, 0.28);
}

.tab-item {
  position: relative;
  z-index: 1;
  min-width: 0;
  width: 0;
  flex: 1;
  height: 62px;
  margin: 0;
  padding: 8rpx 2rpx 7rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  border: 1px solid transparent;
  border-radius: 48rpx;
  color: var(--tab-text);
  background: transparent;
  line-height: 1;
  box-sizing: border-box;
  overflow: hidden;
  transition: transform 140ms ease, background-color 180ms ease;
}

.tab-item-pressed {
  transform: scale(0.94);
  background-color: rgba(255, 255, 255, 0.18);
}

.tab-item.selected {
  border-color: var(--tab-selected-line);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.72), rgba(235, 238, 255, 0.46) 54%, rgba(91, 104, 242, 0.16));
  box-shadow:
    0 8rpx 20rpx rgba(72, 82, 202, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.88),
    inset 0 -1px 0 rgba(91, 104, 242, 0.12);
}

.dark-tab .tab-item.selected {
  background: linear-gradient(145deg, rgba(117, 156, 184, 0.4), rgba(40, 82, 105, 0.36) 56%, rgba(20, 55, 72, 0.5));
  box-shadow:
    0 8rpx 22rpx rgba(0, 0, 0, 0.24),
    inset 0 1px 0 rgba(255, 255, 255, 0.24),
    inset 0 -1px 0 rgba(80, 171, 224, 0.16);
}

.icon-wrap {
  position: relative;
  width: 82rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.selected .icon-wrap {
  background: radial-gradient(circle, var(--tab-glow) 0%, transparent 70%);
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-label {
  overflow: hidden;
  font-size: 21rpx;
  font-weight: 560;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected .tab-label {
  color: var(--tab-selected);
  font-weight: 700;
}

.task-badge {
  position: absolute;
  top: -5rpx;
  right: 2rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--tab-bg);
  border-radius: 999rpx;
  color: #ffffff;
  background: #e35f42;
  font-size: 16rpx;
  font-weight: 750;
  box-sizing: border-box;
}
