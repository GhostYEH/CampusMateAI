.tab-shell {
  --tab-bg: #ffffff;
  --tab-line: #dfe6eb;
  --tab-text: #687c89;
  --tab-selected: #2d6c92;
  --tab-selected-bg: #e7f2f8;
  position: fixed;
  z-index: 999;
  right: 20rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  left: 20rpx;
}

.tab-shell.dark-tab {
  --tab-bg: #132630;
  --tab-line: #2a414d;
  --tab-text: #a8bac4;
  --tab-selected: #8ac1df;
  --tab-selected-bg: #173d52;
}

.tab-bar {
  height: 112rpx;
  padding: 7rpx 9rpx;
  display: flex;
  gap: 0;
  border: 2rpx solid var(--tab-line);
  border-radius: 26rpx;
  background: var(--tab-bg);
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: 0 12rpx 28rpx rgba(17, 40, 53, 0.1);
}

.dark-tab .tab-bar {
  box-shadow: none;
}

.tab-item {
  min-width: 0;
  width: 0;
  flex: 1;
  height: 96rpx;
  margin: 0;
  padding: 5rpx 2rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  border-radius: 18rpx;
  color: var(--tab-text);
  background: transparent;
  line-height: 1;
}

.icon-wrap {
  position: relative;
  width: 70rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.selected .icon-wrap {
  background: var(--tab-selected-bg);
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-label {
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 560;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected .tab-label {
  color: var(--tab-selected);
  font-weight: 700;
}

.task-badge {
  position: absolute;
  top: -5rpx;
  right: 2rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--tab-bg);
  border-radius: 999rpx;
  color: #ffffff;
  background: #e35f42;
  font-size: 16rpx;
  font-weight: 750;
  box-sizing: border-box;
}
