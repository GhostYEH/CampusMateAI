.state {
  padding: 72rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.loader {
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #dce8ef;
  border-top-color: #2f6486;
  border-radius: 50%;
  animation: spin 720ms linear infinite;
}

.mark {
  min-width: 94rpx;
  height: 48rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #2f6486;
  background: #e8f1f7;
  font-size: 19rpx;
  font-weight: 650;
  box-sizing: border-box;
}

.mark.error {
  color: #c25450;
  background: #f9eceb;
}

.title {
  margin-top: 22rpx;
  color: var(--text, #1b2730);
  font-size: 29rpx;
  font-weight: 700;
}

.description {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: var(--muted, #667784);
  font-size: 23rpx;
  line-height: 1.55;
}

.action {
  margin-top: 26rpx;
  padding: 0 28rpx;
  min-height: 70rpx;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  color: #2f6486;
  background: #e8f1f7;
  font-size: 24rpx;
  font-weight: 600;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
