.state {
  min-height: 300rpx;
  padding: 52rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.state-skeleton {
  width: 100%;
  max-width: 430rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skeleton-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: 22rpx;
}

.skeleton-title {
  width: 180rpx;
  margin-top: 22rpx;
}

.skeleton-copy {
  width: 280rpx;
  margin-top: 14rpx;
}

.mark {
  min-width: 94rpx;
  height: 48rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: var(--primary, #2f6486);
  background: var(--primary-soft, #e8f1f7);
  font-size: 19rpx;
  font-weight: 650;
  box-sizing: border-box;
}

.mark.error {
  color: var(--danger, #c25450);
  background: var(--danger-soft, #f9eceb);
}

.title {
  margin-top: 22rpx;
  color: var(--text, #1b2730);
  font-size: 29rpx;
  font-weight: 700;
}

.description {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: var(--muted, #667784);
  font-size: 23rpx;
  line-height: 1.55;
}

.action {
  margin-top: 26rpx;
  padding: 0 28rpx;
  min-height: 70rpx;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  color: var(--primary, #2f6486);
  background: var(--primary-soft, #e8f1f7);
  font-size: 24rpx;
  font-weight: 600;
}
