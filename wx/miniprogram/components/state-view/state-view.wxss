.state-view {
  min-height: 176px;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

.state-view__progress {
  width: 88px;
}

.state-view__icon {
  width: 42px;
  height: 42px;
  opacity: 0.58;
}

.state-view__message {
  margin-top: 14px;
  color: #667784;
  font-size: 13px;
  line-height: 1.55;
}

.state-view__message--title {
  color: #1b2730;
  font-weight: 650;
}

.state-view__description {
  margin-top: 4px;
  color: #667784;
  font-size: 12px;
  line-height: 1.55;
}

.state-view__action {
  min-width: 112px;
  height: 40px;
  margin: 18px 0 0;
  padding: 0 22px;
  border-radius: 20px;
  color: #ffffff;
  background: #596af0;
  font-size: 13px;
  line-height: 40px;
  font-weight: 650;
}
