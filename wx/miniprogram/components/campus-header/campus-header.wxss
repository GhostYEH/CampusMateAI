.header {
  box-sizing: border-box;
  background: var(--background, #f6f8fa);
}

.header-row {
  min-height: 112rpx;
  padding: 20rpx 28rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.heading {
  min-width: 0;
  flex: 1;
}

.title {
  color: var(--text, #1b2730);
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 740;
  letter-spacing: -0.5rpx;
}

.subtitle {
  margin-top: 7rpx;
  color: var(--muted, #667784);
  font-size: 21rpx;
  line-height: 1.4;
}

.mode-badge {
  flex: none;
  padding: 9rpx 13rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  border: 1rpx solid var(--line, #e2e7ec);
  border-radius: 10rpx;
  color: var(--primary, #2f6486);
  background: var(--surface, #ffffff);
  font-size: 18rpx;
  font-weight: 600;
}

.mode-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent, #e08a4e);
}

.back-button {
  flex: none;
  min-width: 86rpx;
  height: 60rpx;
  padding: 0 12rpx 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line, #e2e7ec);
  border-radius: 12rpx;
  color: var(--primary, #2f6486);
  background: var(--surface, #ffffff);
  font-size: 21rpx;
  line-height: 1;
}

.back-pressed {
  transform: scale(0.97);
  opacity: 0.72;
}
