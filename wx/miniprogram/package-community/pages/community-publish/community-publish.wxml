<view class="campus-page publish-page"><secondary-nav title="发布帖子"></secondary-nav><scroll-view class="publish-scroll" scroll-y><view class="publish-body">
  <view class="publish-tip">📣 <text>分享校园信息，友善交流，注意保护隐私</text></view>
  <view class="publish-section"><view class="field-title">● 标题</view><input value="{{title}}" maxlength="60" placeholder="输入一个清晰的标题" bindinput="onTitle"></input><text class="field-count">{{title.length}}/60</text></view>
  <view class="publish-section publish-content"><view class="field-title">● 正文</view><textarea value="{{content}}" maxlength="1000" placeholder="写下你的内容、问题或需求…" bindinput="onContent"></textarea><text class="field-count">{{content.length}}/1000</text></view>
  <view class="publish-section"><view class="field-title">● 选择分类</view><view class="category-grid"><view wx:for="{{categories}}" wx:key="key" data-key="{{item.key}}" bindtap="onCategory" class="category-chip {{category === item.key ? 'selected' : ''}}">{{item.label}}</view></view></view>
  <view class="publish-section"><view class="field-title">● 添加图片 <text>（最多9张）</text></view><view class="publish-images"><view wx:for="{{imageUrls}}" wx:key="*this" class="publish-image"><image src="{{item}}" mode="aspectFill"></image><text data-index="{{index}}" catchtap="removeImage">×</text></view><view wx:if="{{images.length < 9}}" class="image-add" bindtap="chooseImage">▧<text>添加图片</text></view></view></view>
  <view class="publish-settings"><view><text>◉</text><view><strong>校园匿名</strong><small>发布后将隐藏你的姓名和个人信息</small></view><switch checked="{{isAnonymous}}" bindchange="onAnonymous" color="#5865f2"></switch></view><view><text>⌖</text><input value="{{location}}" placeholder="添加地点（选填）" bindinput="onLocation"></input></view><view><text>#</text><input value="{{tags}}" placeholder="话题标签，以逗号分隔" bindinput="onTags"></input></view><view><text>▢</text><view><strong>允许评论</strong></view><switch checked="{{allowComments}}" bindchange="onAllowComments" color="#5865f2"></switch></view></view>
  <view wx:if="{{error}}" class="publish-error">{{error}}</view><button class="publish-submit" loading="{{sending}}" bindtap="publish">➤ 立即发布</button>
</view></scroll-view></view>
