.publish-page{min-height:100vh;background:linear-gradient(160deg,#f7f8ff,#f4f7fb)}.publish-scroll{height:100vh;box-sizing:border-box}.publish-body{padding:94px 16px 34px}.publish-tip{display:flex;align-items:center;gap:10px;padding:14px 16px;border:1px solid #e0e4ff;border-radius:17px;background:#eef0ff;color:#354260;font-size:13px}.publish-section{position:relative;margin-top:15px;padding:17px 15px;border:1px solid #e8ebf2;border-radius:20px;background:#fff}.field-title{margin-bottom:12px;color:#202d49;font-size:17px;font-weight:780}.field-title:first-letter{color:#5e6cf4}.field-title text{color:#9ca8ba;font-size:12px}.publish-section input,.publish-section textarea{width:100%;box-sizing:border-box;border:0;background:transparent;color:#273750;font-size:15px}.publish-section textarea{height:132px;line-height:1.65}.field-count{position:absolute;right:16px;bottom:14px;color:#9ba8ba;font-size:11px}.publish-content{min-height:180px}.category-grid{display:flex;flex-wrap:wrap;gap:9px}.category-chip{min-width:66px;padding:9px 11px;border-radius:18px;background:#f4f6fa;color:#64738b;font-size:13px;text-align:center}.category-chip.selected{background:#eee7d9;color:#795633;font-weight:750}.publish-images{display:flex;gap:10px;flex-wrap:wrap}.publish-image,.image-add{position:relative;width:78px;height:78px;border-radius:14px;overflow:hidden}.publish-image image{width:100%;height:100%}.publish-image text{position:absolute;top:3px;right:4px;width:20px;height:20px;border-radius:50%;background:rgba(0,0,0,.48);color:#fff;text-align:center;line-height:20px}.image-add{display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px dashed #7584ff;color:#6270f3;font-size:26px}.image-add text{margin-top:4px;font-size:11px}.publish-settings{margin-top:15px;padding:2px 15px;border:1px solid #e8ebf2;border-radius:20px;background:#fff}.publish-settings>view{min-height:57px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #edf0f5;color:#6273a0}.publish-settings>view:last-child{border-bottom:0}.publish-settings>view>text{width:20px;color:#6270f3;font-size:21px;text-align:center}.publish-settings>view>view{display:flex;min-width:0;flex:1;flex-direction:column;gap:3px}.publish-settings strong{color:#293853;font-size:14px}.publish-settings small{overflow:hidden;color:#8d9aad;font-size:11px;text-overflow:ellipsis;white-space:nowrap}.publish-settings input{min-width:0;flex:1;border:0;color:#3b4b67;font-size:13px}.publish-settings switch{margin-left:auto}.publish-error{margin-top:10px;color:#d95b5b;font-size:12px}.publish-submit{height:51px;margin-top:18px;border-radius:25px;background:linear-gradient(90deg,#6069f4,#5263e9);color:#fff;font-size:17px;font-weight:750;line-height:51px;box-shadow:0 12rpx 28rpx rgba(74,89,228,.24)}
