.community-body{padding-top:28rpx}.community-heading{display:flex;align-items:center;justify-content:space-between;gap:28rpx}.community-heading>view{min-width:0;flex:1}.community-title{color:var(--campus-text);font-size:52rpx;font-weight:820;letter-spacing:-2rpx;line-height:1.08}.community-subtitle{max-width:430rpx;margin-top:12rpx;color:var(--campus-muted);font-size:23rpx;line-height:1.3}.publish-entry{width:196rpx;height:82rpx;margin:0;padding:0;border-radius:27rpx;color:#fff;background:var(--campus-primary);font-size:25rpx;font-weight:760;line-height:82rpx;box-shadow:0 14rpx 28rpx rgba(89,106,240,.18)}.post-list{margin-top:28rpx;display:flex;flex-direction:column;gap:22rpx}

@import "community-forum.wxss";
