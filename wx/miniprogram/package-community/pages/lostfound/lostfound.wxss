.lost-page{padding-bottom:calc(126px + env(safe-area-inset-bottom))}
.university-guide{padding:32px 24px;display:flex;flex-direction:column;align-items:center;gap:12px;border:1px solid var(--campus-line);border-radius:20px;background:#fff;text-align:center}
.guide-icon{font-size:48px}
.guide-title{font-size:18px;font-weight:800;color:var(--campus-text)}
.guide-desc{font-size:13px;color:var(--campus-muted);line-height:1.6}
.guide-btn{height:44px;padding:0 28px;border-radius:14px;font-size:14px;font-weight:700;color:#fff;background:var(--campus-primary);line-height:44px}
.lost-hero{position:relative;height:300px;overflow:hidden;border-radius:0 0 34px 34px}
.lost-hero__image{position:absolute;inset:0;width:100%;height:100%}
.lost-hero__nav{position:relative;z-index:2;padding-left:18px;display:flex;align-items:center;gap:10px;box-sizing:border-box}
.lost-back{width:46px;height:46px;margin:0;padding:0;display:flex;align-items:center;justify-content:center;flex:0 0 46px;border:1px solid rgba(255,255,255,.88);border-radius:23px;background:rgba(255,255,255,.72);box-shadow:0 8px 20px rgba(52,79,131,.08)}
.lost-back image{width:25px;height:25px;transform:rotate(180deg);filter:brightness(.35)}
.lost-nav-title{min-width:0;flex:1;color:#15284f;font-size:21px;font-weight:800;white-space:nowrap}
.lost-hero__actions{position:absolute;z-index:3;right:16px;width:161px;display:flex;align-items:center;gap:9px}
.mine-button{width:104px;height:46px;margin:0;padding:0 10px;display:flex;align-items:center;justify-content:center;gap:7px;flex:0 0 104px;border:1px solid rgba(255,255,255,.9);border-radius:23px;color:#5b68f2;background:rgba(255,255,255,.74);font-size:14px;font-weight:760;line-height:46px}
.mine-button__icon{width:19px;height:19px}
.mine-button--active{color:#fff;background:#5b68f2}
.publish-fab{width:48px;height:48px;margin:0;padding:0;display:flex;align-items:center;justify-content:center;flex:0 0 48px;border-radius:24px;background:#5b68f2;box-shadow:0 10px 24px rgba(91,104,242,.3)}
.publish-fab image{width:25px;height:25px}
.lost-hero__copy{position:absolute;z-index:1;left:25px;bottom:35px;width:44%;color:#15284f}
.lost-hero__title{font-size:35px;line-height:1.15;font-weight:850}
.lost-hero__subtitle{display:block;margin-top:16px;color:#667ba1;font-size:16px;line-height:1.55}
.lost-content{padding:16px;box-sizing:border-box}
.filter-card{padding:10px 10px 14px;border-radius:28px;background:#fff}
.kind-tabs{padding:4px;display:grid;grid-template-columns:1fr 1fr;border:1px solid #e2e7ec;border-radius:24px}
.kind-tabs button{height:46px;margin:0;padding:0;border-radius:20px;color:#5b68f2;background:transparent;font-size:16px;font-weight:760;line-height:46px}
.kind-tabs button.active{color:#fff;background:#5b68f2;box-shadow:0 6px 17px rgba(91,104,242,.24)}
.search-field{height:54px;margin:12px 0 0;padding:0 16px;display:flex;align-items:center;gap:12px;border:1px solid #e2e7ec;border-radius:18px}
.search-field input{min-width:0;flex:1;color:#1b2730;font-size:15px}
.category-scroll{width:100%;margin-top:12px;white-space:nowrap}
.category-row{width:600px;display:flex;gap:8px;padding-right:8px}
.category-row button{width:auto;min-width:72px;height:43px;margin:0;padding:0 15px;display:inline-flex;align-items:center;justify-content:center;flex:none;border:1px solid #e2e7ec;border-radius:22px;color:#1b2730;background:#fff;font-size:14px;font-weight:650;line-height:43px;white-space:nowrap}
.category-row button.active{border-color:#5b68f2;color:#fff;background:#5b68f2}
.browse-row{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:10px}
.browse-picker__content{height:50px;padding:0 15px;display:flex;align-items:center;gap:10px;box-sizing:border-box;border:1px solid #e2e7ec;border-radius:18px;color:#1b2730;font-size:14px;font-weight:650}
.browse-picker__icon{width:20px;height:20px}
.browse-picker__label{min-width:0;flex:1}
.browse-arrow{width:16px;height:16px;transform:rotate(90deg)}
.section-heading{margin:25px 4px 14px;display:flex;align-items:center;justify-content:space-between}
.section-heading view{color:#1b2730;font-size:24px;font-weight:820}
.section-heading text{color:#667784;font-size:12px}
.result-card{margin-top:16px;overflow:hidden;border-radius:26px;background:#fff}
.lost-list{display:flex;flex-direction:column;gap:14px}
.lost-card{padding:12px;display:flex;gap:14px;border-radius:26px;background:#fff}
.item-image{width:112px;height:112px;flex:none;border-radius:20px}
.item-content{min-width:0;flex:1;padding:4px 2px 0}
.item-title-row{display:flex;align-items:flex-start;gap:8px}
.item-title{min-width:0;flex:1;overflow:hidden;color:#1b2730;font-size:17px;font-weight:800;text-overflow:ellipsis;white-space:nowrap}
.status-chip{padding:7px 10px;flex:none;border-radius:16px;color:#ed6e52;background:#fff0ea;font-size:11px;font-weight:700}
.item-chips{margin-top:10px;display:flex;gap:7px}
.item-chips text{padding:6px 9px;border-radius:14px;font-size:11px;font-weight:700}
.kind-chip{color:#ed6e52;background:#fff0ea}
.kind-chip.found{color:#2e9a7d;background:#e8f7f2}
.category-chip{color:#5b68f2;background:#eff0ff}
.item-meta{margin-top:10px;display:flex;gap:11px;color:#667784;font-size:11px}
.item-meta text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item-desc{margin-top:10px;display:-webkit-box;overflow:hidden;color:#667784;font-size:12px;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.publish-mask{position:fixed;z-index:1200;inset:0;display:flex;align-items:flex-end;background:rgba(20,31,41,.38)}
.publish-sheet{width:100%;padding:10px 20px calc(24px + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:28px 28px 0 0;background:#fff}
.sheet-handle{width:44px;height:5px;margin:0 auto 14px;border-radius:3px;background:#d7dee4}
.sheet-head{display:flex;align-items:center;justify-content:space-between}
.sheet-head view{font-size:23px;font-weight:820}
.sheet-head button{height:38px;margin:0;padding:0 8px;color:#667784;background:transparent;font-size:14px;line-height:38px}
.publish-kind{margin-top:18px;padding:4px;display:grid;grid-template-columns:1fr 1fr;border-radius:18px;background:#eff0ff}
.publish-kind button{height:43px;margin:0;border-radius:15px;color:#5b68f2;background:transparent;font-size:14px}
.publish-kind button.active{color:#fff;background:#5b68f2}
.publish-field{width:100%;height:48px;margin-top:12px;padding:0 15px;box-sizing:border-box;border:1px solid #e2e7ec;border-radius:15px;background:#f6f8fa;font-size:14px}
.publish-textarea{height:92px;padding-top:13px}
.publish-submit{height:52px;margin:18px 0 0;border-radius:18px;color:#fff;background:#5b68f2;font-size:16px;font-weight:760;line-height:52px}
@media (max-width:360px){.mine-button{padding:0 12px}
.mine-button__icon{display:none}
.lost-hero__copy{width:50%}
.lost-hero__title{font-size:32px}
.browse-row{grid-template-columns:1fr}
.item-image{width:100px;height:106px}
}
