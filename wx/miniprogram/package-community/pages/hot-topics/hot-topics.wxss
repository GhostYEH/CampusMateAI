.hot-topics-body{padding-top:104px}.hot-hero{display:flex;align-items:center;gap:12px;margin:0 0 18px;padding:20px;border-radius:22px;background:linear-gradient(135deg,#f4f1ff,#eef3ff)}.hot-hero-mark{font-size:34px}.hot-hero-title{color:#1b294b;font-size:24px;font-weight:850}.hot-hero-subtitle{margin-top:5px;color:#7181a2;font-size:12px}.hot-ranking-list{display:flex;flex-direction:column;gap:11px}.hot-ranking-card{display:flex;align-items:center;gap:12px;padding:16px;border:1px solid #ebedf6;border-radius:18px;background:#fff}.hot-ranking-number{width:27px;height:27px;flex:0 0 27px;border-radius:9px;background:#f1f3f8;color:#789;font-size:13px;font-weight:800;line-height:27px;text-align:center}.hot-ranking-number.top-three{background:linear-gradient(135deg,#ff774d,#fa4f68);color:#fff}.hot-ranking-content{min-width:0;flex:1}.hot-ranking-title{overflow:hidden;color:#253551;font-size:15px;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.hot-ranking-excerpt{overflow:hidden;margin-top:6px;color:#728199;font-size:12px;line-height:1.5;text-overflow:ellipsis;white-space:nowrap}.hot-ranking-meta{display:flex;gap:9px;margin-top:8px;color:#9aa6b8;font-size:11px}.hot-ranking-score{display:flex;flex-direction:column;align-items:center;gap:3px;color:#ff6760;font-size:12px;font-weight:750}.hot-empty{padding:60px 20px;text-align:center;color:#7b89a0}.hot-empty button{margin-top:15px;color:#fff;background:#5965f2;border-radius:16px;font-size:13px}
