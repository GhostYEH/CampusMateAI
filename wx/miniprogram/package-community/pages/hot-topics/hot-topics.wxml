<view class="campus-page hot-topics-page">
  <secondary-nav title="热门话题"></secondary-nav>
  <view class="campus-page-body hot-topics-body">
    <view class="hot-hero"><text class="hot-hero-mark">🔥</text><view><view class="hot-hero-title">今日热门话题</view><view class="hot-hero-subtitle">按点赞与讨论热度实时排行</view></view></view>
    <state-view wx:if="{{loading}}" state="loading" title="正在整理热门话题"></state-view>
    <state-view wx:elif="{{error}}" state="error" title="加载失败" description="{{error}}" actionText="重试" bindaction="load"></state-view>
    <view wx:elif="{{!posts.length}}" class="hot-empty"><text>暂时还没有热门帖子</text><button bindtap="openPublish">去发布</button></view>
    <view wx:else class="hot-ranking-list">
      <view wx:for="{{posts}}" wx:key="id" class="hot-ranking-card" data-id="{{item.id}}" bindtap="openPost">
        <view class="hot-ranking-number {{item.rank <= 3 ? 'top-three' : ''}}">{{item.rank}}</view>
        <view class="hot-ranking-content"><view class="hot-ranking-title">{{item.title}}</view><view class="hot-ranking-excerpt">{{item.excerpt}}</view><view class="hot-ranking-meta"><text>{{item.category}}</text><text>{{item.timeText}}</text></view></view>
        <view class="hot-ranking-score"><text>🔥</text><text>{{item.like_count + item.comment_count * 2}}</text></view>
      </view>
    </view>
  </view>
</view>
