page {
  --primary: #5669ee;
  --primary-deep: #4054d7;
  --primary-soft: #edf0ff;
  --accent: #ff9f39;
  --danger: #f05f46;
  --success: #4f9d72;
  --text: #17262f;
  --muted: #687c89;
  --line: #dfe6eb;
  --surface: #ffffff;
  --surface-subtle: #f4f7fa;
  --background: #f4f7fa;
  --tab-active: #2d6c92;
  --tab-active-bg: #e7f2f8;
  min-height: 100%;
  background: var(--background);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button {
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100dvh;
  box-sizing: border-box;
  overflow-x: hidden;
  background: var(--background);
}

.page-body {
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.tab-page .page-body {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.section-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.section-subtitle {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.surface {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 650;
  line-height: 1;
  transition: opacity 160ms ease, transform 160ms ease, background 160ms ease;
}

.primary-button {
  color: #fff;
  background: var(--primary);
}

.secondary-button {
  color: var(--primary);
  background: var(--primary-soft);
}

.danger-button {
  color: var(--danger);
  background: #f9eceb;
}

.primary-button[disabled],
.secondary-button[disabled],
.danger-button[disabled] {
  opacity: 0.45;
}

.button-pressed {
  transform: scale(0.98);
  opacity: 0.86;
}

.field {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #cad5dd;
  border-radius: 22rpx;
  background: #fff;
  color: var(--text);
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.field-focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(47, 100, 134, 0.1);
}

.mock-note {
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.enter {
  animation: enter-up 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.enter-delay-1 {
  animation-delay: 70ms;
}

.enter-delay-2 {
  animation-delay: 140ms;
}

.enter-delay-3 {
  animation-delay: 210ms;
}

.reduce-motion .enter,
.reduce-motion .enter-delay-1,
.reduce-motion .enter-delay-2,
.reduce-motion .enter-delay-3 {
  animation: none;
}

@keyframes enter-up {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dark {
  --primary: #7382ff;
  --primary-deep: #8e9aff;
  --primary-soft: #1b3543;
  --accent: #ffa94a;
  --danger: #ff8c7d;
  --success: #73bc91;
  --text: #edf5f8;
  --muted: #a8bac4;
  --line: #2a414d;
  --surface: #132630;
  --surface-subtle: #091a23;
  --background: #081820;
  --tab-active: #8ac1df;
  --tab-active-bg: #173d52;
  background: var(--background);
  color: var(--text);
}

.dark .field {
  background: #132630;
  color: var(--text);
  border-color: #40535e;
}

.dark .surface {
  background: var(--surface);
}
