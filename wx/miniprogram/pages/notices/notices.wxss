.extract-panel {
  padding: 24rpx;
  border-left: 5rpx solid var(--primary);
}

.extract-head,
.section-head,
.result-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-label {
  flex: none;
  padding: 7rpx 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 17rpx;
  font-weight: 650;
}

.notice-input {
  width: 100%;
  height: 218rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--text);
  background: var(--background);
  font-size: 21rpx;
  line-height: 1.6;
}

.extract-button {
  margin-top: 14rpx;
}

.extract-panel .mock-note {
  margin-top: 11rpx;
  text-align: center;
}

.result-panel {
  margin-top: 16rpx;
  display: flex;
  overflow: hidden;
  border: 1rpx solid rgba(78, 140, 106, 0.22);
  border-radius: 16rpx;
  background: var(--surface);
}

.result-accent {
  width: 6rpx;
  flex: none;
  background: var(--success);
}

.result-content {
  min-width: 0;
  flex: 1;
  padding: 22rpx;
}

.result-title {
  color: var(--text);
  font-size: 23rpx;
  font-weight: 700;
}

.confidence {
  padding: 6rpx 9rpx;
  border-radius: 7rpx;
  color: var(--success);
  background: var(--success-soft);
  font-size: 16rpx;
}

.result-name {
  margin-top: 18rpx;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 720;
}

.result-meta {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 19rpx;
}

.step-title {
  margin-top: 21rpx;
  color: var(--muted);
  font-size: 18rpx;
  font-weight: 650;
}

.result-step {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  color: var(--text);
  font-size: 20rpx;
  line-height: 1.45;
}

.step-index {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  border-radius: 9rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 16rpx;
  font-weight: 700;
}

.save-button {
  margin-top: 22rpx;
}

.view-task-button {
  margin: 9rpx auto 0;
  color: var(--primary);
  background: transparent;
  font-size: 19rpx;
}

.notice-section {
  margin-top: 24rpx;
}

.notice-section .section-title {
  font-size: 29rpx;
}

.search {
  width: 238rpx;
  height: 62rpx;
  padding: 0 15rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  color: var(--text);
  background: var(--surface);
  font-size: 19rpx;
}

.notice-list {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.notice-item {
  min-height: 100rpx;
  padding: 18rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-top: 1rpx solid var(--line);
  box-sizing: border-box;
}

.notice-item:first-child {
  border-top: 0;
}

.notice-status {
  width: 8rpx;
  height: 36rpx;
  flex: none;
  border-radius: 999rpx;
  background: var(--line);
}

.notice-status.unread {
  background: var(--accent);
}

.notice-main {
  min-width: 0;
  flex: 1;
}

.notice-title {
  overflow: hidden;
  color: var(--text);
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-meta {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.unread-label {
  flex: none;
  padding: 5rpx 7rpx;
  border-radius: 6rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 16rpx;
}

@media (max-width: 350px) {
  .search {
    width: 205rpx;
  }
}
