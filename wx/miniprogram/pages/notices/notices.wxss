.extract-panel {
  padding: 30rpx;
}

.extract-head,
.section-head,
.result-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.ai-label {
  flex: none;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 19rpx;
  font-weight: 650;
}

.notice-input {
  width: 100%;
  height: 230rpx;
  margin-top: 24rpx;
  padding: 23rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  color: var(--text);
  background: var(--background);
  font-size: 23rpx;
  line-height: 1.6;
}

.extract-button {
  margin-top: 18rpx;
}

.extract-panel .mock-note {
  margin-top: 13rpx;
  text-align: center;
}

.result-panel {
  margin-top: 22rpx;
  display: flex;
  overflow: hidden;
  border: 1rpx solid rgba(78, 140, 106, 0.22);
  border-radius: 30rpx;
  background: var(--surface);
}

.result-accent {
  width: 8rpx;
  flex: none;
  background: var(--success);
}

.result-content {
  min-width: 0;
  flex: 1;
  padding: 28rpx;
}

.result-title {
  font-size: 25rpx;
  font-weight: 700;
}

.confidence {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: var(--success);
  background: rgba(78, 140, 106, 0.1);
  font-size: 18rpx;
}

.result-name {
  margin-top: 21rpx;
  font-size: 31rpx;
  line-height: 1.4;
  font-weight: 730;
}

.result-meta {
  margin-top: 9rpx;
  color: var(--accent);
  font-size: 22rpx;
}

.step-title {
  margin-top: 24rpx;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 650;
}

.result-step {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 13rpx;
  font-size: 22rpx;
}

.step-index {
  width: 38rpx;
  height: 38rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 18rpx;
  font-weight: 700;
}

.save-button {
  margin-top: 25rpx;
}

.view-task-button {
  margin: 10rpx auto 0;
  color: var(--primary);
  background: transparent;
  font-size: 21rpx;
}

.notice-section {
  margin-top: 28rpx;
}

.search {
  width: 250rpx;
  height: 68rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  color: var(--text);
  background: var(--surface);
  font-size: 21rpx;
}

.notice-list {
  margin-top: 19rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  background: var(--surface);
}

.notice-item {
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--line);
  box-sizing: border-box;
}

.notice-item:last-child {
  border-bottom: 0;
}

.notice-status {
  width: 10rpx;
  height: 42rpx;
  flex: none;
  border-radius: 999rpx;
  background: var(--line);
}

.notice-status.unread {
  background: var(--accent);
}

.notice-main {
  min-width: 0;
  flex: 1;
}

.notice-title {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-meta {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.unread-label {
  flex: none;
  color: var(--accent);
  font-size: 19rpx;
}
