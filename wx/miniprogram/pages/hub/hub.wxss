.hub-body{padding-top:116px}.hub-hero{padding:24px;display:flex;align-items:center;gap:17px;border-radius:24px;color:#fff;background:linear-gradient(140deg,#596af0,#756dec)}.hero-icon{width:66px;height:66px;display:flex;align-items:center;justify-content:center;border-radius:20px;background:rgba(255,255,255,.16)}.hero-icon image{width:38px;height:38px;filter:brightness(0) invert(1)}.hero-title{font-size:26px;font-weight:800}.hero-subtitle{margin-top:8px;color:rgba(255,255,255,.78);font-size:13px}.feedback-button{height:48px;margin:16px 0 0;border-radius:16px;color:#fff;background:var(--campus-primary);font-size:14px;font-weight:700;line-height:48px}.section-heading{margin:28px 4px 14px;display:flex;justify-content:space-between;align-items:center}.section-heading view{font-size:24px;font-weight:800}.section-heading text{color:var(--campus-muted);font-size:12px}.hub-list{display:flex;flex-direction:column;gap:12px}.hub-item{padding:17px;display:flex;align-items:center;gap:14px;border:1px solid var(--campus-line);border-radius:19px;background:#fff}.item-icon{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:15px;background:var(--campus-primary-soft)}.item-icon image{width:27px;height:27px}.item-main{min-width:0;flex:1}.item-main view{overflow:hidden;font-size:16px;font-weight:760;text-overflow:ellipsis;white-space:nowrap}.item-main text,.item-main label{display:block;margin-top:5px;overflow:hidden;color:var(--campus-muted);font-size:11px;text-overflow:ellipsis;white-space:nowrap}.item-main label{color:var(--campus-primary)}.item-arrow{width:24px;height:24px;opacity:.55}.request-card{margin-top:14px;padding:16px;border:1px solid var(--campus-line);border-radius:18px;background:#fff}.request-card input,.request-card textarea{width:100%;box-sizing:border-box;border:1px solid var(--campus-line);border-radius:12px;background:#f8fafb;font-size:13px}.request-card input{height:44px;padding:0 12px}.request-card textarea{height:104px;margin-top:10px;padding:12px}.request-card>view{margin-top:10px;display:flex;justify-content:flex-end;gap:8px}.request-card button{height:38px;margin:0;padding:0 17px;border-radius:11px;color:var(--campus-muted);background:#eef1f4;font-size:12px;line-height:38px}.request-card .submit{color:#fff;background:var(--campus-primary)}
.hub-body{padding-top:0}
.university-current-btn{height:36px;padding:0 16px;border-radius:12px;font-size:12px;font-weight:700;color:var(--campus-muted);background:var(--campus-primary-soft);line-height:36px}
.university-select-btn{height:36px;padding:0 16px;border-radius:12px;font-size:12px;font-weight:700;color:#fff;background:var(--campus-primary);line-height:36px}
