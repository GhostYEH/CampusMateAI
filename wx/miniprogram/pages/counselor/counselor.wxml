<view class="page tab-page chat-page {{darkMode ? 'dark' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}">
  <campus-header
    title="AI 校园助手"
    subtitle="校园问题，随时来聊一聊"
    mode="{{mockMode ? 'Mock 知识库' : '真实后端'}}"
  />

  <view class="assistant-banner enter">
    <view class="assistant-copy">
      <view class="assistant-title">校园事务助手</view>
      <view class="assistant-subtitle">帮你整理办事流程、材料和下一步</view>
    </view>
    <view class="assistant-status">
      <view class="status-dot"></view>
      <text>{{mockMode ? '演示知识库在线' : '校园服务在线'}}</text>
    </view>
  </view>

  <scroll-view
    class="chat-scroll"
    scroll-y
    enhanced
    enable-flex
    scroll-with-animation="{{!reduceMotion}}"
    scroll-into-view="{{scrollTarget}}"
  >
    <view class="chat-content">
      <view class="suggestion-block enter enter-delay-1">
        <view class="suggestion-title">你可以这样问</view>
        <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
          <view class="suggestion-row">
            <button
              wx:for="{{suggestions}}"
              wx:key="*this"
              class="suggestion"
              data-text="{{item}}"
              bindtap="useSuggestion"
            >{{item}}</button>
          </view>
        </scroll-view>
      </view>

      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="message-{{item.id}}"
        class="message-row {{item.role}} enter"
      >
        <image wx:if="{{item.role === 'assistant'}}" class="assistant-avatar" src="/assets/app-icon.png" mode="aspectFill"></image>
        <view class="bubble-wrap">
          <view class="bubble">{{item.text}}</view>
          <view wx:if="{{item.citation}}" class="citation">{{item.citation}}</view>
        </view>
      </view>

      <view wx:if="{{sending}}" id="typing" class="message-row assistant typing-row">
        <image class="assistant-avatar" src="/assets/app-icon.png" mode="aspectFill"></image>
        <view class="typing">
          <view></view><view></view><view></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="composer">
    <view class="composer-row">
      <textarea
        class="composer-input"
        value="{{input}}"
        auto-height
        maxlength="500"
        placeholder="输入你的校园事务问题…"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="send"
      ></textarea>
      <button
        class="send-button"
        disabled="{{!input || sending}}"
        loading="{{sending}}"
        bindtap="send"
      >发送</button>
    </view>
    <view class="disclaimer">仅提供校园事务辅助，不替代学校正式通知或专业咨询</view>
  </view>
</view>
