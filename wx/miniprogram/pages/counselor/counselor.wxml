<view class="page tab-page chat-page {{darkMode ? 'dark' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}">
  <campus-header title="AI 校园助手" subtitle="校园问题，随时来聊一聊" mode="{{mockMode ? '演示知识库' : '真实后端'}}" />
  <scroll-view class="chat-scroll" scroll-y enhanced enable-flex scroll-with-animation="{{!reduceMotion}}" scroll-into-view="{{scrollTarget}}">
    <view class="chat-content">
      <view class="assistant-identity enter"><image src="/assets/secondary/ai-robot.png" mode="aspectFit"></image><view class="assistant-copy"><view class="assistant-title">校园事务助手 <text>{{mockMode ? '演示' : '在线'}}</text></view><view class="assistant-subtitle">帮你整理流程、材料和下一步</view><view class="coverage">覆盖奖助、课程、校园服务问答</view></view></view>

      <view class="vision-card enter">
        <view class="vision-head"><view><view class="vision-title">本机表情陪伴</view><view class="vision-subtitle">识别可见表情，不识别身份</view></view><button wx:if="{{!visionEnabled}}" class="vision-action" bindtap="enableVision">启用</button><button wx:else class="vision-action stop" bindtap="disableVision">停止</button></view>
        <view class="vision-status {{visionStatus}}"><view class="status-dot"></view><text>{{visionDetail}}</text></view>
        <camera wx:if="{{cameraVisible}}" class="local-camera" device-position="front" frame-size="small" flash="off" binderror="onCameraError"></camera>
        <view wx:if="{{expressionLabel}}" class="expression-result">稳定信号 {{expressionLabel}} · {{expressionConfidence}}%</view>
        <view class="privacy-line">画面不上传、不保存；退出本页立即停止。没有稳定信号时不会发送任何表情字段。</view>
      </view>

      <view class="suggestion-block enter enter-delay-1"><view class="suggestion-title">你可以这样问</view><view class="suggestion-grid"><button wx:for="{{suggestions}}" wx:key="label" class="suggestion" data-text="{{item.prompt}}" bindtap="useSuggestion"><view class="suggestion-icon"><image src="{{item.icon}}" mode="aspectFit"></image></view><view>{{item.label}}</view><image class="suggestion-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit"></image></button></view></view>

      <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message-row {{item.role}} enter"><image wx:if="{{item.role === 'assistant'}}" class="assistant-avatar" src="/assets/secondary/ai-robot.png" mode="aspectFit"></image><view class="bubble-wrap"><view class="bubble" user-select>{{item.text}}</view><view wx:if="{{item.citation}}" class="citation">{{item.citation}} · 流程同步</view></view></view>
      <view wx:if="{{sending}}" id="typing" class="message-row assistant typing-row"><image class="assistant-avatar" src="/assets/secondary/ai-robot.png" mode="aspectFit"></image><view class="typing"><view></view><view></view><view></view><text>正在查询校园知识库</text></view></view>
      <view wx:if="{{error}}" class="chat-error"><view><view class="chat-error-title">回答未完成</view><text>{{error}}</text></view><view class="error-actions"><button bindtap="retryLastMessage">重试</button><button bindtap="dismissError">关闭</button></view></view>
    </view>
  </scroll-view>
  <view class="composer"><view class="composer-row"><textarea class="composer-input" value="{{input}}" auto-height maxlength="500" placeholder="输入你的校园事务问题…" bindinput="onInput" confirm-type="send" bindconfirm="send"></textarea><button class="send-button" disabled="{{!input || sending}}" loading="{{sending}}" bindtap="send"><image src="/assets/icons/arrow-right.svg" mode="aspectFit"></image></button></view><view class="disclaimer">仅提供校园事务辅助，请以学校正式通知为准</view></view>
</view>
