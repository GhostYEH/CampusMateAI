.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.assistant-banner {
  margin: 8rpx 28rpx 0;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-left: 6rpx solid var(--primary);
  background: var(--surface);
}

.assistant-title {
  font-size: 28rpx;
  font-weight: 700;
}

.assistant-subtitle {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.assistant-status {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.status-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: var(--accent);
}

.chat-scroll {
  min-height: 0;
  flex: 1;
}

.chat-content {
  padding: 24rpx 28rpx 28rpx;
}

.suggestion-title {
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 600;
}

.suggestion-row {
  margin-top: 13rpx;
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
}

.suggestion {
  flex: none;
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--primary);
  background: var(--surface);
  font-size: 21rpx;
}

.message-row {
  margin-top: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-avatar {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 20rpx;
}

.bubble-wrap {
  max-width: 78%;
}

.bubble {
  padding: 22rpx 24rpx;
  border-radius: 8rpx 26rpx 26rpx 26rpx;
  color: var(--text);
  background: var(--primary-soft);
  font-size: 24rpx;
  line-height: 1.65;
}

.user .bubble {
  border-radius: 26rpx 8rpx 26rpx 26rpx;
  color: #fff;
  background: var(--primary);
}

.citation {
  display: inline-flex;
  max-width: 100%;
  margin-top: 9rpx;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: var(--muted);
  background: var(--surface);
  font-size: 18rpx;
}

.typing {
  height: 62rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  background: var(--primary-soft);
}

.typing view {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: bounce 900ms ease-in-out infinite;
}

.typing view:nth-child(2) {
  animation-delay: 120ms;
}

.typing view:nth-child(3) {
  animation-delay: 240ms;
}

.composer {
  flex: none;
  padding: 18rpx 24rpx calc(158rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--surface);
}

.composer-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.composer-input {
  min-height: 76rpx;
  max-height: 180rpx;
  flex: 1;
  padding: 19rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  color: var(--text);
  background: var(--background);
  font-size: 23rpx;
  line-height: 1.5;
}

.send-button {
  width: 112rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 22rpx;
  color: #fff;
  background: var(--primary);
  font-size: 22rpx;
  font-weight: 650;
}

.send-button[disabled] {
  opacity: 0.45;
}

.disclaimer {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 17rpx;
  text-align: center;
}

@keyframes bounce {
  0%, 70%, 100% {
    transform: translateY(0);
    opacity: 0.45;
  }
  35% {
    transform: translateY(-7rpx);
    opacity: 1;
  }
}
