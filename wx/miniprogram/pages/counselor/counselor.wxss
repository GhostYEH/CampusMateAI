.chat-page{height:100dvh;display:flex;flex-direction:column}.assistant-identity{margin:4rpx 28rpx 0;padding:24rpx 30rpx;display:flex;align-items:center;gap:25rpx;border:2rpx solid #d9dcff;border-radius:34rpx;background:linear-gradient(135deg,#fbfbff,#f5f5ff)}.dark .assistant-identity{background:var(--primary-soft)}.assistant-identity>image{width:150rpx;height:150rpx;flex:none}.assistant-copy{min-width:0;flex:1}.assistant-title{font-size:30rpx;font-weight:780;color:var(--text)}.assistant-title text{margin-left:9rpx;color:var(--muted);font-size:17rpx;font-weight:500}.assistant-subtitle{margin-top:15rpx;color:var(--muted);font-size:22rpx}.coverage{display:inline-flex;margin-top:20rpx;padding:10rpx 15rpx;border-radius:20rpx;color:var(--primary);background:var(--primary-soft);font-size:17rpx}.suggestion-block{padding:26rpx 28rpx 0}.suggestion-title{font-size:32rpx;font-weight:780;color:var(--text)}.suggestion-grid{margin-top:18rpx;display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.suggestion{min-height:94rpx;margin:0;padding:14rpx 18rpx;display:flex;align-items:center;gap:13rpx;border:1rpx solid var(--line);border-radius:25rpx;color:var(--text);background:var(--surface);text-align:left;font-size:20rpx}.suggestion text{width:47rpx;height:47rpx;flex:none;border-radius:15rpx;color:var(--primary);background:var(--primary-soft);text-align:center;line-height:47rpx}.suggestion view{min-width:0;flex:1}.suggestion i{color:var(--muted);font-style:normal;font-size:30rpx}.suggestion .suggestion-arrow{flex:none;color:var(--muted);font-size:30rpx}.chat-scroll{min-height:0;flex:1}.chat-content{padding:10rpx 28rpx 24rpx}.message-row{margin-top:20rpx;display:flex;align-items:flex-end;gap:10rpx}.message-row.user{justify-content:flex-end}.assistant-avatar{width:47rpx;height:47rpx;flex:none;border-radius:14rpx}.bubble-wrap{max-width:82%}.bubble{padding:20rpx 22rpx;border:1rpx solid var(--line);border-radius:27rpx 27rpx 27rpx 8rpx;color:var(--text);background:var(--surface);font-size:21rpx;line-height:1.65}.user .bubble{border:0;border-radius:27rpx 27rpx 8rpx 27rpx;color:#fff;background:var(--primary)}.citation{margin-top:8rpx;color:var(--muted);font-size:17rpx}.typing{height:58rpx;padding:0 20rpx;display:flex;align-items:center;gap:7rpx;border-radius:25rpx;background:var(--surface)}.typing view{width:9rpx;height:9rpx;border-radius:50%;background:var(--primary);animation:bounce 900ms ease-in-out infinite}.typing view:nth-child(2){animation-delay:120ms}.typing view:nth-child(3){animation-delay:240ms}.composer{flex:none;padding:14rpx 22rpx calc(152rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--line);background:rgba(255,255,255,.94)}.dark .composer{background:var(--surface)}.composer-row{display:flex;align-items:flex-end;gap:12rpx}.composer-input{min-height:78rpx;max-height:160rpx;flex:1;padding:19rpx 20rpx;box-sizing:border-box;border:2rpx solid #c9ccff;border-radius:27rpx;color:var(--text);background:var(--surface);font-size:21rpx}.send-button{width:78rpx;height:78rpx;margin:0;padding:0;border-radius:26rpx;color:#fff;background:var(--primary);font-size:28rpx;line-height:78rpx}.send-button[disabled]{color:var(--muted);background:var(--primary-soft)}.disclaimer{margin-top:9rpx;color:var(--muted);font-size:16rpx;text-align:center}@keyframes bounce{0%,70%,100%{transform:translateY(0);opacity:.45}35%{transform:translateY(-6rpx);opacity:1}}
