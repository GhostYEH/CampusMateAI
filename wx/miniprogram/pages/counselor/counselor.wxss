.chat-page {
  height: 100dvh;
  display: flex;
  flex-direction: column;
}

.assistant-banner {
  margin: 2rpx 28rpx 0;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid #d7e6ee;
  border-left: 5rpx solid var(--primary);
  border-radius: 14rpx;
  background: var(--primary-ghost);
}

.assistant-title {
  color: var(--text);
  font-size: 25rpx;
  font-weight: 700;
}

.assistant-subtitle {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.assistant-status {
  flex: none;
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent);
}

.chat-scroll {
  min-height: 0;
  flex: 1;
}

.chat-content {
  padding: 22rpx 28rpx 24rpx;
}

.suggestion-title {
  color: var(--muted);
  font-size: 19rpx;
  font-weight: 620;
}

.suggestion-row {
  margin-top: 11rpx;
  display: flex;
  gap: 9rpx;
  white-space: nowrap;
}

.suggestion {
  flex: none;
  min-height: 58rpx;
  margin: 0;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  color: var(--primary);
  background: var(--surface);
  font-size: 19rpx;
}

.message-row {
  margin-top: 23rpx;
  display: flex;
  align-items: flex-start;
  gap: 11rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-avatar {
  width: 52rpx;
  height: 52rpx;
  flex: none;
  border-radius: 14rpx;
}

.bubble-wrap {
  max-width: 80%;
}

.bubble {
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 5rpx 15rpx 15rpx 15rpx;
  color: var(--text);
  background: var(--surface);
  font-size: 22rpx;
  line-height: 1.62;
}

.user .bubble {
  border: 0;
  border-radius: 15rpx 5rpx 15rpx 15rpx;
  color: #ffffff;
  background: #2f6486;
}

.dark .user .bubble {
  color: #102d3d;
}

.citation {
  display: inline-flex;
  max-width: 100%;
  margin-top: 8rpx;
  padding: 7rpx 11rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  color: var(--muted);
  background: var(--surface-subtle);
  font-size: 17rpx;
}

.typing {
  height: 58rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  border: 1rpx solid var(--line);
  border-radius: 5rpx 15rpx 15rpx 15rpx;
  background: var(--surface);
}

.typing view {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: bounce 900ms ease-in-out infinite;
}

.typing view:nth-child(2) {
  animation-delay: 120ms;
}

.typing view:nth-child(3) {
  animation-delay: 240ms;
}

.composer {
  flex: none;
  padding: 14rpx 22rpx calc(146rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--surface);
}

.composer-row {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.composer-input {
  min-height: 72rpx;
  max-height: 170rpx;
  flex: 1;
  padding: 17rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--text);
  background: var(--background);
  font-size: 21rpx;
  line-height: 1.5;
}

.send-button {
  width: 100rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  color: #ffffff;
  background: var(--primary);
  font-size: 20rpx;
  font-weight: 680;
}

.dark .send-button {
  color: #102d3d;
}

.send-button[disabled] {
  opacity: 0.45;
}

.disclaimer {
  margin-top: 9rpx;
  color: var(--muted);
  font-size: 16rpx;
  text-align: center;
}

@keyframes bounce {
  0%, 70%, 100% {
    transform: translateY(0);
    opacity: 0.45;
  }
  35% {
    transform: translateY(-6rpx);
    opacity: 1;
  }
}
