.chat-page{height:100dvh;display:flex;flex-direction:column}.assistant-identity{margin:4rpx 28rpx 0;padding:28rpx 30rpx 24rpx;display:flex;align-items:center;gap:20rpx;border:2rpx solid #d9dcff;border-radius:34rpx;background:linear-gradient(135deg,#fbfbff,#f5f5ff)}.dark .assistant-identity{background:var(--primary-soft)}.assistant-identity>image{width:176rpx;height:176rpx;flex:none}.assistant-copy{min-width:0;flex:1}.assistant-title{font-size:34rpx;font-weight:780;color:var(--text)}.assistant-title text{display:inline-flex;margin-left:7rpx;color:var(--muted);font-size:18rpx;font-weight:500}.assistant-subtitle{margin-top:13rpx;color:var(--muted);font-size:23rpx}.coverage{display:inline-flex;margin-top:18rpx;padding:10rpx 14rpx;border-radius:22rpx;color:var(--primary);background:var(--primary-soft);font-size:17rpx}.suggestion-block{padding:28rpx 28rpx 0}.suggestion-title{font-size:40rpx;font-weight:800;color:var(--text)}.suggestion-grid{margin-top:20rpx;display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.suggestion{min-height:126rpx;margin:0;padding:16rpx;display:flex;align-items:center;gap:13rpx;border:1rpx solid var(--line);border-radius:26rpx;color:var(--text);background:var(--surface);text-align:left;font-size:24rpx;line-height:1.38}.suggestion-icon{width:54rpx!important;height:54rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:17rpx;background:var(--primary-soft)}.suggestion-icon image{width:32rpx;height:32rpx}.suggestion view{min-width:0;flex:1}.suggestion .suggestion-arrow{width:22rpx;height:22rpx;flex:none;opacity:.55}.chat-scroll{min-height:180rpx;flex:1}.chat-content{padding:12rpx 28rpx 255rpx}.message-row{margin-top:24rpx;display:flex;align-items:flex-end;gap:12rpx}.message-row.user{justify-content:flex-end}.assistant-avatar{width:64rpx;height:64rpx;flex:none}.bubble-wrap{max-width:84%}.bubble{padding:25rpx 28rpx;border:1rpx solid var(--line);border-radius:29rpx 29rpx 29rpx 8rpx;color:var(--text);background:var(--surface);font-size:24rpx;line-height:1.7}.user .bubble{border:0;border-radius:29rpx 29rpx 8rpx 29rpx;color:#fff;background:var(--primary)}.citation{margin-top:10rpx;color:var(--muted);font-size:18rpx}.typing{height:64rpx;padding:0 22rpx;display:flex;align-items:center;gap:7rpx;border-radius:25rpx;background:var(--surface)}.typing view{width:9rpx;height:9rpx;border-radius:50%;background:var(--primary);animation:bounce 900ms ease-in-out infinite}.typing view:nth-child(2){animation-delay:120ms}.typing view:nth-child(3){animation-delay:240ms}.composer{position:fixed;z-index:120;right:0;bottom:calc(104rpx + env(safe-area-inset-bottom));left:0;padding:18rpx 24rpx 13rpx;border-top:1rpx solid var(--line);background:rgba(255,255,255,.96);backdrop-filter:blur(18rpx)}.dark .composer{background:var(--surface)}.composer-row{display:flex;align-items:flex-end;gap:13rpx}.composer-input{min-height:88rpx;max-height:160rpx;flex:1;padding:22rpx 24rpx;box-sizing:border-box;border:2rpx solid #c9ccff;border-radius:29rpx;color:var(--text);background:var(--surface);font-size:24rpx}.send-button{width:88rpx;height:88rpx;margin:0;padding:0;display:flex;align-items:center;justify-content:center;border-radius:29rpx;background:var(--primary)}.send-button image{width:38rpx;height:38rpx;filter:brightness(0) invert(1)}.send-button[disabled]{background:var(--primary-soft)}.send-button[disabled] image{filter:none;opacity:.38}.disclaimer{margin-top:10rpx;color:var(--muted);font-size:17rpx;text-align:center}@keyframes bounce{0%,70%,100%{transform:translateY(0);opacity:.45}35%{transform:translateY(-6rpx);opacity:1}}
