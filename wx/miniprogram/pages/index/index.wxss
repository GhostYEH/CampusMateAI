.home-page{min-height:100vh;padding-bottom:calc(104px + env(safe-area-inset-bottom));box-sizing:border-box;background:#f6f8fa;color:#1b2730}
.home-header{height:111px;padding:0 24px 18px;display:flex;align-items:flex-end;box-sizing:border-box}
.home-profile{min-width:0;flex:1;height:44px;margin:0;padding:0;display:flex;align-items:center;gap:11px;background:transparent;text-align:left}
.home-profile image{width:40px;height:40px;flex:none;border:3px solid #fff;border-radius:50%;box-sizing:border-box;box-shadow:0 0 0 1px #dfe6eb}.home-profile>view{min-width:0}.home-profile view view{overflow:hidden;font-size:17px;font-weight:780;text-overflow:ellipsis;white-space:nowrap}.home-profile text{display:block;margin-top:3px;color:#667784;font-size:11px}
.home-notice{position:relative;width:48px;height:48px;margin:0;padding:0;display:flex;align-items:center;justify-content:center;border:1px solid #dfe6eb;border-radius:50%;background:#fff}.home-notice image{width:25px;height:25px}.home-notice view{position:absolute;top:6px;right:6px;width:7px;height:7px;border:2px solid #fff;border-radius:50%;background:#ed6e52}
.home-content{padding:0 24px 36px}.hero-shell{position:relative;height:170px;overflow:hidden;border-radius:25px}.hero-swiper,.hero-swiper swiper-item{height:170px}.hero-card{position:relative;height:170px;overflow:hidden;padding:24px 20px 22px;box-sizing:border-box;border-radius:25px;color:#fff;background:linear-gradient(135deg,#315fe0,#6654e7)}.hero-card::after{content:'';position:absolute;top:-88px;right:-62px;width:190px;height:190px;border:1px solid rgba(255,255,255,.2);border-radius:50%;box-shadow:0 0 0 22px rgba(255,255,255,.05),0 0 0 44px rgba(255,255,255,.035)}.hero-glow{position:absolute;right:-25px;bottom:-58px;width:170px;height:150px;border-radius:50%;background:rgba(117,227,255,.23);filter:blur(8px)}.hero-art{position:absolute;z-index:1;bottom:-14px;left:7px;width:108px;height:132px;filter:drop-shadow(0 8px 10px rgba(19,28,109,.28))}.hero-text{position:relative;z-index:2;max-width:250px}.theme-cpm{background:linear-gradient(135deg,#2e64dc 0%,#614fdf 100%)}.theme-cpm .hero-text{width:calc(100% - 99px);margin-left:99px}.theme-cpm .hero-glow{right:auto;bottom:-37px;left:-18px;width:132px;height:120px;background:rgba(106,221,255,.28)}.theme-learning{background:linear-gradient(135deg,#1e7da9 0%,#3b86e8 100%)}.theme-learning .hero-glow{background:rgba(130,226,255,.25)}.theme-academic{background:linear-gradient(135deg,#6754c8 0%,#9b6be3 100%)}.theme-academic .hero-glow{background:rgba(241,182,255,.24)}.theme-study{background:linear-gradient(135deg,#dd6d50 0%,#9d55c8 100%)}.theme-study .hero-glow{background:rgba(255,220,125,.23)}.theme-community{background:linear-gradient(135deg,#168f91 0%,#3971d4 100%)}.theme-community .hero-glow{background:rgba(134,255,220,.24)}
.hero-eyebrow{display:inline-block;padding:4px 8px;border-radius:999px;color:rgba(255,255,255,.86);background:rgba(255,255,255,.15);font-size:10px;letter-spacing:.3px}.hero-title{margin-top:9px;font-size:22px;line-height:1.18;font-weight:820;letter-spacing:.2px}.hero-subtitle{display:block;margin-top:8px;color:rgba(255,255,255,.82);font-size:11px;line-height:1.4}.hero-cta{width:auto;height:32px;margin:13px 0 0;padding:0 13px;border:1px solid rgba(255,255,255,.72);border-radius:999px;color:#fff;background:rgba(255,255,255,.1);font-size:11px;line-height:30px}.hero-cta text{margin-left:4px;font-size:16px;vertical-align:-1px}.hero-pages{position:absolute;z-index:4;right:0;bottom:9px;left:0;display:flex;align-items:center;justify-content:center;gap:6px}.hero-pages button{width:6px;height:6px;min-height:6px;margin:0;padding:0;border:0;border-radius:999px;background:rgba(255,255,255,.38);line-height:6px}.hero-pages button::after{display:none}.hero-pages button.active{width:18px;background:#fff}
.quick-card{margin-top:14px;padding:16px 8px 14px;display:flex;border:1px solid #dfe6eb;border-radius:27px;background:#fff}.quick-item{min-width:0;flex:1;margin:0;padding:0;background:transparent;overflow:visible}.quick-icon{width:42px;height:42px;margin:auto;display:flex;align-items:center;justify-content:center;border-radius:14px;background:#596af0}.quick-icon image{width:25px;height:25px;filter:brightness(0) invert(1)}.quick-icon.blue{background:#377de8}.quick-icon.teal{background:#36b99e}.quick-icon.orange{background:#ffa43a}.quick-icon.violet{background:#7b62e7}.quick-item text{display:block;margin-top:10px;color:#1b2730;font-size:11px;white-space:nowrap}
.today-card{margin-top:14px;padding:15px;border:1px solid #dfe6eb;border-radius:27px;background:#fff}.card-heading{display:flex;align-items:center;justify-content:space-between}.card-heading>view{font-size:21px;font-weight:800}.card-heading button{margin:0;padding:0;color:#667784;background:transparent;font-size:12px}.card-heading image{width:24px;height:24px}
.today-grid{margin-top:15px;display:flex;gap:13px}.next-course{width:49%;min-height:132px;padding:15px;box-sizing:border-box;border-radius:22px;color:#fff;background:linear-gradient(145deg,#5363ed,#716bf2)}.next-course label{display:inline-flex;padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.16);font-size:10px}.next-course>view{margin-top:14px;font-size:18px;line-height:1.25;font-weight:800}.next-course>text{margin-top:8px;display:flex;align-items:center;gap:5px;color:rgba(255,255,255,.84);font-size:9px}.next-course text image{width:13px;height:13px}
.course-list-mini{min-width:0;flex:1;padding:5px 14px;border:1px solid #dfe6eb;border-radius:22px}.course-line{min-height:56px;display:flex;align-items:center;gap:9px;border-top:1px solid #dfe6eb}.course-line:first-child{border-top:0}.course-status{width:7px;height:7px;flex:none;border:2px solid #596af0;border-radius:50%}.course-status.active{background:#596af0}.course-line>view:last-child{min-width:0}.course-line view view{overflow:hidden;font-size:12px;font-weight:720;text-overflow:ellipsis;white-space:nowrap}.course-line text{display:block;margin-top:5px;overflow:hidden;color:#667784;font-size:9px;text-overflow:ellipsis;white-space:nowrap}
.overview-row{display:flex;gap:16px}.overview-card{width:50%;min-height:205px;margin-top:17px;padding:22px;box-sizing:border-box;border:1px solid #dfe6eb;border-radius:27px;background:#fff}.overview-card .card-heading>view{font-size:21px}.overview-card>text{display:block;margin-top:23px;color:#667784;font-size:12px}.overview-card>strong{display:block;margin-top:6px;font-size:42px;line-height:1}.overview-card strong label{font-size:18px}.progress{height:8px;margin-top:20px;overflow:hidden;border-radius:999px;background:#eff0ff}.progress view{height:100%;border-radius:999px;background:#596af0}
.deadline-line{margin-top:14px;padding:11px;display:flex;gap:8px;border-radius:14px;background:#f6f8fa}.deadline-line>view:first-child{width:7px;height:7px;margin-top:5px;flex:none;border-radius:50%;background:#596af0}.deadline-line>view:last-child{min-width:0}.deadline-line text{display:block;overflow:hidden;font-size:11px;text-overflow:ellipsis;white-space:nowrap}.deadline-line label{display:block;margin-top:4px;color:#ed6e52;font-size:9px}.mini-empty{padding:28px 5px;color:#667784;font-size:12px;text-align:center}.dark{background:var(--background);color:var(--text)}
