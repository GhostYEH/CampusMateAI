.home-top { display:flex;align-items:center;gap:14rpx;padding:16rpx 28rpx 14rpx;box-sizing:border-box; }
.profile-entry { min-width:0;flex:1;margin:0;padding:0;display:flex;align-items:center;gap:16rpx;text-align:left;background:transparent; }
.profile-avatar { width:72rpx;height:72rpx;border:5rpx solid #fff;border-radius:50%;box-shadow:0 0 0 1rpx var(--line); }
.profile-copy { min-width:0;flex:1; }.profile-greeting{font-size:31rpx;font-weight:760;color:var(--text)}.profile-meta{margin-top:5rpx;color:var(--muted);font-size:21rpx}
.notice-entry{position:relative;width:70rpx;height:70rpx;margin:0;padding:0;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--line);border-radius:50%;background:var(--surface)}
.notice-entry image{width:34rpx;height:34rpx}.notice-dot{position:absolute;top:8rpx;right:8rpx;width:10rpx;height:10rpx;border:3rpx solid var(--surface);border-radius:50%;background:#ed6e52}
.home-body{padding-top:8rpx}.home-hero{position:relative;height:324rpx;overflow:hidden;border-radius:42rpx;color:#fff;background:#3445ce}.home-hero-image,.home-hero-shade{position:absolute;inset:0;width:100%;height:100%}.home-hero-shade{background:linear-gradient(90deg,rgba(46,58,207,.93),rgba(63,80,218,.7),rgba(30,55,100,.18))}.home-hero-content{position:relative;z-index:1;height:100%;padding:56rpx 42rpx 30rpx;box-sizing:border-box}.home-hero-title{font-size:43rpx;font-weight:800}.home-hero-copy{margin-top:22rpx;font-size:24rpx;color:rgba(255,255,255,.78)}.hero-action{width:max-content;margin:40rpx 0 0;padding:0 27rpx;height:64rpx;border:2rpx solid rgba(255,255,255,.74);border-radius:34rpx;color:#fff;background:rgba(255,255,255,.08);font-size:23rpx;line-height:64rpx}.hero-dots{position:absolute;left:0;right:0;bottom:16rpx;display:flex;justify-content:center;gap:10rpx}.hero-dots view{width:12rpx;height:12rpx;border-radius:50%;background:rgba(255,255,255,.35)}.hero-dots .active{background:#fff}
.service-grid{margin-top:24rpx;padding:28rpx 10rpx;display:flex;align-items:flex-start;border:1rpx solid var(--line);border-radius:34rpx;background:var(--surface)}.service-item{width:20%;flex:none;margin:0;padding:0;background:transparent;overflow:visible}.service-icon{width:68rpx;height:68rpx;margin:auto;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:var(--primary)}.service-icon image{width:38rpx;height:38rpx;filter:brightness(0) invert(1)}.service-icon.teal{background:#36bea4}.service-icon.orange{background:#ffa43a}.service-icon.navy{background:#7b62e7}.service-icon.blue{background:#377de8}.service-label{margin-top:14rpx;color:var(--text);font-size:20rpx;white-space:nowrap}
.home-panel,.metric-card{margin-top:24rpx;padding:28rpx;border:1rpx solid var(--line);border-radius:34rpx;background:var(--surface)}.panel-heading{display:flex;align-items:center;justify-content:space-between}.panel-heading button{margin:0;padding:0;color:var(--muted);background:transparent;font-size:20rpx}.panel-title{color:var(--text);font-size:31rpx;font-weight:760}.today-course-layout{margin-top:24rpx;display:grid;grid-template-columns:1.08fr .92fr;gap:18rpx}.today-course-card{min-height:260rpx;padding:25rpx;border-radius:28rpx;color:#fff;background:linear-gradient(145deg,#5060ed,#736bf3)}.course-state{display:inline-flex;padding:9rpx 16rpx;border-radius:22rpx;background:rgba(255,255,255,.16);font-size:19rpx}.featured-course{margin-top:34rpx;font-size:34rpx;font-weight:770}.featured-meta{margin-top:22rpx;color:rgba(255,255,255,.82);font-size:21rpx}.course-brief-list{padding:7rpx 20rpx;border:1rpx solid var(--line);border-radius:26rpx}.course-brief{min-height:98rpx;display:flex;align-items:center;gap:14rpx;border-top:1rpx solid var(--line)}.course-brief:first-child{border-top:0}.course-dot{width:10rpx;height:10rpx;border:3rpx solid var(--primary);border-radius:50%}.course-dot.active{background:var(--primary)}.brief-name{font-size:22rpx;font-weight:700;color:var(--text)}.brief-meta{margin-top:7rpx;color:var(--muted);font-size:17rpx}
.home-dual-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.metric-card{min-width:0}.metric-label{margin-top:25rpx;color:var(--muted);font-size:20rpx}.metric-value{margin-top:4rpx;color:var(--text);font-size:57rpx;font-weight:800;line-height:1}.metric-value text{font-size:26rpx}.progress-line{height:10rpx;margin-top:22rpx;overflow:hidden;border-radius:9rpx;background:var(--primary-soft)}.progress-line view{height:100%;border-radius:9rpx;background:var(--primary)}.eye{color:var(--muted)}.mini-deadline{margin-top:18rpx;padding:14rpx;display:flex;gap:11rpx;border-radius:18rpx;background:var(--background);font-size:18rpx;color:var(--text)}.mini-deadline text{display:block;margin-top:5rpx;color:#ed6e52;font-size:16rpx}.deadline-mark{width:9rpx;height:9rpx;margin-top:7rpx;flex:none;border-radius:50%;background:var(--primary)}.empty-copy{margin-top:24rpx;color:var(--muted);font-size:19rpx}
.dark .service-icon.teal,.dark .service-icon.orange,.dark .service-icon.navy{filter:saturate(.75)}
