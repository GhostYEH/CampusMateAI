
/*
  Refactored stylesheet for the home page.
  - Aligns with the Android app's visual identity.
  - Focuses on breathability, cleaner components, and stronger visual impact.
*/

/* General page styles */
.home-page {
  background-color: var(--background);
  padding-bottom: 120rpx; /* Add padding to the bottom */
}

.home-body {
  padding: 24rpx;
}

/* Redesigned Hero Section */
.home-hero {
  position: relative;
  height: 400rpx;
  overflow: hidden;
  border-radius: 24rpx; /* Slightly larger radius */
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(47, 100, 134, 0.2);
}

.home-hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.home-hero-shade {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* Make the gradient more subtle to let the image show through */
  background: linear-gradient(100deg, rgba(11, 36, 52, 0.8) 5%, rgba(24, 78, 104, 0.5) 58%, rgba(47, 100, 134, 0.1) 80%);
}

.home-hero-content {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

.home-hero-kicker {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
}

.home-hero-title {
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -1rpx;
  margin-top: 10rpx;
  max-width: 80%;
}

.home-hero-actions {
  margin-top: auto;
  display: flex;
  gap: 16rpx;
}

.home-hero-actions button {
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 16rpx 32rpx;
  line-height: 1;
}

.hero-primary {
  background-color: var(--accent);
  color: var(--surface);
}

.hero-secondary {
  background-color: rgba(255, 255, 255, 0.2);
  color: var(--surface);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}


/* Redesigned Panels */
.home-panel {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  /* Use box-shadow for a "lifted" native feel */
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.home-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.home-panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.home-kicker {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  margin-bottom: 4rpx;
}
.home-kicker.warm { color: var(--accent); }
.home-kicker.blue { color: var(--primary); }
.home-kicker.green { color: var(--success); }

.home-panel-link {
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 500;
}

/* List styles */
.deadline-list, .course-list {
  margin-top: 20rpx;
}

.deadline-row, .course-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
}

.deadline-row:first-child, .course-row:first-child {
  border-top: none;
  padding-top: 10rpx;
}

.deadline-title, .course-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.deadline-meta, .course-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.deadline-time {
  color: var(--accent);
  font-weight: 600;
}

.deadline-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

/* Dual Grid Layout */
.home-dual-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

/* Keep original styles for profile header for now */
.home-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16px 28rpx 10rpx;
  box-sizing: border-box;
}

.profile-entry {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: transparent;
  padding: 0;
  margin: 0;
  text-align: left;
}

.profile-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid var(--surface);
  box-shadow: 0 0 0 2rpx var(--line);
}

.profile-greeting {
  font-size: 32rpx;
  font-weight: 700;
}

.profile-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.profile-chevron {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 600;
}

.notice-entry {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-entry image {
  width: 40rpx;
  height: 40rpx;
}

.quick-section {
  margin-top: 24rpx;
}

.quick-section-head {
  padding: 0 8rpx;
}

.quick-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.quick-row {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  text-align: left;
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-icon.blue { background: var(--primary-soft); }
.quick-icon.teal { background: #E0F2F1; }
.quick-icon.orange { background: var(--accent-soft); }
.quick-icon.navy { background: #E8F1F7; }

.quick-icon image {
  width: 36rpx;
  height: 36rpx;
}

.quick-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.quick-copy text {
  font-size: 20rpx;
  color: var(--muted);
}
