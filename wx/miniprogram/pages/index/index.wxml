<view class="page tab-page home-page {{darkMode ? 'dark' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}">
  <view class="home-top" style="padding-top: {{statusBarHeight + 14}}px;">
    <button class="profile-entry enter" bindtap="openProfile" aria-label="进入个人中心">
      <image class="profile-avatar" src="/assets/profile-avatar.png" mode="aspectFill"></image>
      <view class="profile-copy">
        <view class="profile-greeting">{{user ? user.name : '校园同学'}}</view>
        <view class="profile-meta">点击头像进入个人中心</view>
      </view>
    </button>
    <button class="notice-entry" bindtap="openNotice" aria-label="查看校园通知">
      <image src="/assets/icons/quick-notice.svg" mode="aspectFit"></image>
      <view class="notice-dot"></view>
    </button>
  </view>

  <view class="page-body home-body">
    <view class="home-hero enter">
      <image class="home-hero-image" src="/assets/home-hero.jpg" mode="aspectFill"></image>
      <view class="home-hero-shade"></view>
      <view class="home-hero-content">
        <view class="home-hero-title">期末考试周进行中</view>
        <view class="home-hero-copy">合理规划时间，稳住节奏，我们能赢。</view>
        <button class="hero-action" hover-class="button-pressed" bindtap="openTasks">查看复习计划　›</button>
        <view class="hero-dots"><view class="active"></view><view></view><view></view><view></view></view>
      </view>
    </view>

    <view class="service-grid enter enter-delay-1">
      <button class="service-item" data-route="" bindtap="openAction"><view class="service-icon blue"><image src="/assets/icons/quick-calendar.svg" mode="aspectFit"></image></view><view class="service-label">考试安排</view></button>
      <button class="service-item" data-route="" bindtap="openAction"><view class="service-icon blue"><image src="/assets/icons/quick-calendar.svg" mode="aspectFit"></image></view><view class="service-label">空教室</view></button>
      <button class="service-item" data-route="/pages/notices/notices" data-tab="{{false}}" bindtap="openAction"><view class="service-icon teal"><image src="/assets/icons/quick-notice.svg" mode="aspectFit"></image></view><view class="service-label">办事大厅</view></button>
      <button class="service-item" data-route="/pages/study/study" data-tab="{{false}}" bindtap="openAction"><view class="service-icon orange"><image src="/assets/icons/quick-study.svg" mode="aspectFit"></image></view><view class="service-label">专注自习</view></button>
      <button class="service-item" data-route="" bindtap="openAction"><view class="service-icon navy"><image src="/assets/icons/quick-counselor.svg" mode="aspectFit"></image></view><view class="service-label">失物招领</view></button>
    </view>

    <view class="home-panel course-panel enter enter-delay-2">
      <view class="panel-heading"><view class="panel-title">今日课程</view><button bindtap="openCourses">查看全部 ›</button></view>
      <view class="today-course-layout">
        <view class="today-course-card">
          <view class="course-state">下一节</view>
          <view class="featured-course">{{courses[0] ? courses[0].name : '暂无课程'}}</view>
          <view class="featured-meta">◷ {{courses[0] ? courses[0].time : '--:--'}}</view>
          <view class="featured-meta">⌖ {{courses[0] ? courses[0].location : '待设置'}}</view>
        </view>
        <view class="course-brief-list">
          <view wx:for="{{courses}}" wx:key="code" class="course-brief">
            <view class="course-dot {{index === 0 ? 'active' : ''}}"></view>
            <view><view class="brief-name">{{item.name}}</view><view class="brief-meta">{{item.time}} · {{item.location}}</view></view>
          </view>
        </view>
      </view>
    </view>

    <view class="home-dual-grid enter enter-delay-3">
      <view class="metric-card">
        <view class="panel-heading"><view class="panel-title">学习总览</view><view class="eye">◉</view></view>
        <view class="metric-label">本周进度</view>
        <view class="metric-value">{{weekProgress}}<text>%</text></view>
        <view class="progress-line"><view style="width: {{weekProgress}}%;"></view></view>
      </view>
      <view class="metric-card deadline-card">
        <view class="panel-heading"><view class="panel-title">近期截止</view><button bindtap="openTasks">更多 ›</button></view>
        <view wx:for="{{deadlineTasks}}" wx:key="id" class="mini-deadline">
          <view class="deadline-mark"></view><view><view>{{item.title}}</view><text>{{item.due}}</text></view>
        </view>
        <view wx:if="{{deadlineTasks.length === 0}}" class="empty-copy">今天没有临近事项</view>
      </view>
    </view>
  </view>
</view>
