<view class="page tab-page home-page {{darkMode ? 'dark' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}">
  <button
    class="profile-entry enter"
    style="padding-top: {{statusBarHeight + 18}}px;"
    bindtap="openProfile"
    aria-label="进入个人中心"
  >
    <image class="profile-avatar" src="/assets/profile-avatar.png" mode="aspectFill"></image>
    <view class="profile-copy">
      <view class="profile-name">{{user ? user.name : '林知夏'}}</view>
      <view class="profile-hint">点击头像进入个人中心</view>
    </view>
  </button>

  <view class="home-content">
    <view class="hero enter enter-delay-1">
      <image class="hero-image" src="/assets/home-hero.jpg" mode="scaleToFill"></image>
      <view class="hero-content">
        <view class="hero-title">期末考试周进行中</view>
        <view class="hero-copy">合理规划时间，稳住节奏，我们能赢。</view>
        <button class="hero-button" hover-class="hero-button-pressed" bindtap="openTasks">
          <text>查看复习计划</text>
          <image class="hero-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit"></image>
        </button>
      </view>
      <view class="hero-dots">
        <view class="hero-dot active"></view>
        <view class="hero-dot"></view>
        <view class="hero-dot"></view>
        <view class="hero-dot"></view>
      </view>
    </view>

    <view class="quick-panel enter enter-delay-2">
      <button
        wx:for="{{quickActions}}"
        wx:key="label"
        class="quick-action"
        data-route="{{item.route}}"
        data-tab="{{item.tab}}"
        hover-class="quick-pressed"
        bindtap="openAction"
      >
        <view class="quick-icon-wrap {{item.tone}}">
          <image class="quick-icon" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"></image>
          <view wx:if="{{item.label === '待办任务' && pendingCount > 0}}" class="quick-badge">{{pendingCount}}</view>
        </view>
        <view class="quick-label">{{item.label}}</view>
      </button>
    </view>

    <view class="today-panel section-surface enter enter-delay-2">
      <view class="section-head">
        <view class="section-heading">今日课程</view>
        <button class="section-link" bindtap="openCourses">查看全部 ›</button>
      </view>
      <view class="today-grid">
        <view class="next-course">
          <view class="next-pill">下一节</view>
          <view class="next-name">数据结构</view>
          <view class="next-detail">
            <image src="/assets/icons/clock-white.svg" mode="aspectFit"></image>
            <text>10:00 · 进行中</text>
          </view>
          <view class="next-detail">
            <image src="/assets/icons/pin-white.svg" mode="aspectFit"></image>
            <text>C-202 · 李老师</text>
          </view>
        </view>

        <view class="course-stack">
          <view class="course-row">
            <view class="course-state-dot outline"></view>
            <view class="course-copy">
              <view class="course-name">高等数学</view>
              <view class="course-meta">08:00 · B-301</view>
            </view>
            <view class="course-status ended">已结束</view>
          </view>
          <view class="course-divider"></view>
          <view class="course-row">
            <view class="course-state-dot"></view>
            <view class="course-copy">
              <view class="course-name">计算机网络</view>
              <view class="course-meta">14:00 · A-105</view>
            </view>
            <view class="course-status upcoming">未开始</view>
          </view>
        </view>
      </view>
    </view>

    <view class="summary-grid enter enter-delay-3">
      <view class="overview-panel section-surface">
        <view class="section-head compact">
          <view class="section-heading">学习总览</view>
          <image class="eye-icon" src="/assets/icons/eye-{{darkMode ? 'dark' : 'light'}}.svg" mode="aspectFit"></image>
        </view>
        <view class="overview-inner">
          <view class="overview-copy">
            <view class="overview-label">本周进度</view>
            <view class="overview-value">{{weekProgress}}%</view>
            <view class="overview-up">较上周</view>
            <view class="overview-up">↑12%</view>
          </view>
          <canvas type="2d" id="progressCanvas" class="progress-canvas"></canvas>
        </view>
      </view>

      <view class="deadline-panel section-surface">
        <view class="section-head compact">
          <view class="section-heading">近期截止</view>
          <button class="section-link" bindtap="openTasks">更多 ›</button>
        </view>
        <view class="deadline-list">
          <view wx:for="{{deadlineTasks}}" wx:key="id" class="deadline-row">
            <view class="deadline-icon-wrap {{item.tone}}">
              <image src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"></image>
            </view>
            <view class="deadline-copy">
              <view class="deadline-title">{{item.title}}</view>
              <view wx:if="{{index === 0}}" class="deadline-time">{{item.due}}</view>
            </view>
          </view>
          <view wx:if="{{deadlineTasks.length === 0}}" class="deadline-empty">近期没有待截止事项</view>
        </view>
      </view>
    </view>
  </view>
</view>
