.profile-card {
  min-height: 166rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: #173d52;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  flex: none;
  border: 3rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
}

.identity {
  min-width: 0;
  flex: 1;
}

.name {
  overflow: hidden;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 740;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail {
  margin-top: 7rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.8);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account {
  margin-top: 11rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.62);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.data-mode {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border: 1rpx solid #eadfd6;
  border-left: 5rpx solid var(--accent);
  border-radius: 14rpx;
  background: var(--surface);
}

.mode-title {
  color: var(--muted);
  font-size: 18rpx;
}

.mode-value {
  margin-top: 6rpx;
  color: var(--text);
  font-size: 25rpx;
  font-weight: 700;
}

.mode-copy {
  max-width: 470rpx;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.45;
}

.settings-section {
  margin-top: 24rpx;
}

.section-label {
  margin: 0 0 9rpx 3rpx;
  color: var(--muted);
  font-size: 19rpx;
  font-weight: 680;
}

.setting-group {
  padding: 0 19rpx;
  border-radius: 16rpx;
}

.setting-row,
.backend-summary {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.setting-copy {
  min-width: 0;
  flex: 1;
}

.setting-title {
  overflow: hidden;
  color: var(--text);
  font-size: 22rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setting-subtitle {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.divider {
  height: 1rpx;
  background: var(--line);
}

.backend-panel {
  padding: 0 19rpx 18rpx;
  border-radius: 16rpx;
}

.edit-button {
  width: 88rpx;
  height: 56rpx;
  flex: none;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 19rpx;
}

.save-url {
  min-height: 74rpx;
  margin-top: 12rpx;
}

.privacy-note {
  margin-top: 22rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--muted);
  background: var(--surface-subtle);
  font-size: 18rpx;
  line-height: 1.6;
}

.logout {
  margin-top: 16rpx;
}
