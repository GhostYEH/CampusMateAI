.profile-card {
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-radius: 34rpx;
  color: #fff;
  background: var(--primary);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  flex: none;
  border: 5rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 38rpx;
}

.identity {
  min-width: 0;
  flex: 1;
}

.name {
  font-size: 38rpx;
  font-weight: 740;
}

.detail {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.account {
  margin-top: 12rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.64);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.data-mode {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  border-left: 7rpx solid var(--accent);
  background: var(--surface);
}

.mode-title {
  color: var(--muted);
  font-size: 19rpx;
}

.mode-value {
  margin-top: 6rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.mode-copy {
  max-width: 470rpx;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.45;
}

.settings-section {
  margin-top: 28rpx;
}

.section-label {
  margin: 0 0 11rpx 8rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.setting-group {
  padding: 0 25rpx;
}

.setting-row,
.backend-summary {
  min-height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.setting-copy {
  min-width: 0;
  flex: 1;
}

.setting-title {
  font-size: 24rpx;
  font-weight: 650;
}

.setting-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
}

.divider {
  height: 1rpx;
  margin-left: 0;
  background: var(--line);
}

.backend-panel {
  padding: 22rpx 25rpx;
}

.edit-button {
  width: 100rpx;
  height: 62rpx;
  flex: none;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 21rpx;
}

.save-url {
  margin-top: 14rpx;
}

.privacy-note {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  color: var(--muted);
  background: var(--primary-soft);
  font-size: 20rpx;
  line-height: 1.6;
}

.logout {
  margin-top: 20rpx;
}
