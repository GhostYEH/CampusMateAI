.profile-hero{position:relative;min-height:510rpx;padding:0 42rpx;color:#fff;background:linear-gradient(145deg,#4e5ee0,#6f75f3);border-radius:0 0 56rpx 56rpx;box-sizing:border-box;overflow:hidden}.profile-hero::after{content:"";position:absolute;right:-90rpx;top:-140rpx;width:380rpx;height:380rpx;border-radius:50%;background:rgba(255,255,255,.06)}.hero-safe{height:calc(88rpx + env(safe-area-inset-top))}.hero-title{font-size:54rpx;font-weight:820}.hero-subtitle{margin-top:12rpx;color:rgba(255,255,255,.69);font-size:23rpx}.identity{position:relative;z-index:1;margin-top:76rpx;display:flex;align-items:center;gap:26rpx}.avatar{width:126rpx;height:126rpx;flex:none;border:7rpx solid #fff;border-radius:50%}.identity-copy{min-width:0;flex:1}.name{font-size:41rpx;font-weight:800}.detail{margin-top:17rpx;overflow:hidden;color:rgba(255,255,255,.78);font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.sync-state{display:inline-flex;margin-top:21rpx;padding:9rpx 15rpx;border-radius:20rpx;color:rgba(255,255,255,.74);background:rgba(255,255,255,.12);font-size:16rpx}.sync-state::first-letter{color:#69d4ac}.identity-arrow{font-size:48rpx;color:rgba(255,255,255,.8)}
.profile-body{margin-top:-96rpx;position:relative;z-index:2}.shortcut-card{padding:34rpx 20rpx;display:grid;grid-template-columns:repeat(4,1fr);border:1rpx solid var(--line);border-radius:38rpx;background:var(--surface);box-shadow:0 10rpx 28rpx rgba(32,39,89,.07)}.shortcut-card button{margin:0;padding:0;background:transparent}.shortcut-card button view{width:76rpx;height:76rpx;margin:auto;border-radius:23rpx;color:var(--primary);background:var(--primary-soft);font-size:33rpx;line-height:76rpx}.shortcut-card button .warm{color:var(--accent);background:var(--accent-soft)}.shortcut-card text{display:block;margin-top:18rpx;color:var(--text);font-size:22rpx;font-weight:700}.service-title{margin:34rpx 8rpx 18rpx;font-size:32rpx;font-weight:780;color:var(--text)}.service-list{padding:0 28rpx;border:1rpx solid var(--line);border-radius:34rpx;background:var(--surface)}.service-list button{width:100%;min-height:100rpx;margin:0;padding:0;display:flex;align-items:center;gap:22rpx;border-top:1rpx solid var(--line);background:transparent;text-align:left}.service-list button:first-child{border-top:0}.service-list i{width:50rpx;flex:none;color:var(--primary);font-size:31rpx;font-style:normal;text-align:center}.service-list text{min-width:0;flex:1;color:var(--text);font-size:25rpx;font-weight:650}.service-list b{color:var(--muted);font-size:37rpx;font-weight:400}.settings-panel{margin-top:28rpx;padding:26rpx;border:1rpx solid var(--line);border-radius:34rpx;background:var(--surface)}.settings-title{display:flex;align-items:center;justify-content:space-between}.settings-title strong{display:block;color:var(--text);font-size:30rpx}.settings-title text{display:block;margin-top:7rpx;color:var(--muted);font-size:18rpx}.settings-title button{margin:0;padding:0;color:var(--primary);background:transparent;font-size:19rpx}.data-mode{margin-top:24rpx;padding:22rpx;display:flex;align-items:center;gap:20rpx;border-radius:24rpx;background:var(--primary-soft)}.data-mode>view{min-width:0;flex:1}.mode-title{color:var(--muted);font-size:17rpx}.mode-value{margin-top:6rpx;color:var(--text);font-size:23rpx;font-weight:700}.mode-copy{margin-top:6rpx;color:var(--muted);font-size:17rpx}.setting-group,.backend-panel{margin-top:18rpx;padding:0 20rpx;border-radius:24rpx}.setting-row,.backend-summary{min-height:94rpx;display:flex;align-items:center;gap:18rpx}.setting-copy{min-width:0;flex:1}.setting-name{color:var(--text);font-size:21rpx;font-weight:650}.setting-subtitle{margin-top:5rpx;overflow:hidden;color:var(--muted);font-size:17rpx;text-overflow:ellipsis;white-space:nowrap}.divider{height:1rpx;background:var(--line)}.edit-button{width:86rpx;margin:0;padding:0;color:var(--primary);background:var(--primary-soft);font-size:18rpx}.backend-panel{padding-top:4rpx;padding-bottom:18rpx}.save-url{margin-top:12rpx}.logout{margin-top:18rpx;width:100%}
.service-list .service-icon{width:50rpx;flex:none;color:var(--primary);font-size:31rpx;text-align:center}.service-list .service-arrow{color:var(--muted);font-size:37rpx;font-weight:400}.settings-heading{display:block;color:var(--text);font-size:30rpx;font-weight:700}
.sync-state{align-items:center;gap:8rpx}.sync-state view{width:10rpx;height:10rpx;border-radius:50%;background:#69d4ac}.identity-arrow{width:34rpx;height:34rpx;filter:brightness(0) invert(1);opacity:.8}.shortcut-card button view{display:flex;align-items:center;justify-content:center;font-size:0}.shortcut-card button view image{width:40rpx;height:40rpx}.service-list .service-icon{width:34rpx;height:34rpx;margin:0 8rpx;flex:none}.service-list .service-arrow{width:26rpx;height:26rpx;opacity:.55}
.shortcut-card{display:flex!important}.shortcut-card button{width:25%!important;flex:0 0 25%}

.hero-top-row{display:flex;align-items:center;justify-content:space-between;width:100%}
.hero-scan-btn{width:72rpx;height:72rpx;border-radius:50%;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center}
.hero-scan-btn image{width:40rpx;height:40rpx}
