<view class="page tab-page profile-page {{settings.darkMode ? 'dark' : ''}} {{settings.reduceMotion ? 'reduce-motion' : ''}}">
  <view class="profile-hero">
    <view class="hero-safe"></view><view class="hero-title">我的</view><view class="hero-subtitle">今天也照顾好自己的节奏</view>
    <view class="identity"><image class="avatar" src="/assets/profile-avatar.png" mode="aspectFill"></image><view class="identity-copy"><view class="name">{{user.name}}</view><view class="detail">{{user.detail}} · {{user.studentId}}</view><view class="sync-state">● 资料已同步到当前账号</view></view><view class="identity-arrow">›</view></view>
  </view>
  <view class="page-body profile-body">
    <view class="shortcut-card enter"><button data-kind="files" bindtap="openService"><view>▤</view><text>文件</text></button><button data-kind="activities" bindtap="openService"><view class="warm">▣</view><text>活动</text></button><button data-kind="favorites" bindtap="openService"><view>◆</view><text>收藏</text></button><button data-kind="settings" bindtap="openService"><view>⚙</view><text>设置</text></button></view>
    <view class="service-title">更多服务</view>
    <view class="service-list enter enter-delay-1">
      <button data-kind="study" bindtap="openService"><view class="service-icon">◷</view><text>学习与专注</text><view class="service-arrow">›</view></button>
      <button data-kind="notices" bindtap="openService"><view class="service-icon">♟</view><text>通知与提醒</text><view class="service-arrow">›</view></button>
      <button data-kind="account" bindtap="openService"><view class="service-icon">◆</view><text>账号与隐私</text><view class="service-arrow">›</view></button>
      <button data-kind="help" bindtap="openService"><view class="service-icon">◉</view><text>帮助与反馈</text><view class="service-arrow">›</view></button>
      <button data-kind="about" bindtap="openService"><view class="service-icon">ⓘ</view><text>关于 CampusMate</text><view class="service-arrow">›</view></button>
    </view>

    <view wx:if="{{showSettings}}" id="settings-panel" class="settings-panel enter">
      <view class="settings-title"><view><view class="settings-heading">系统设置</view><text>数据模式、显示、提醒与后端</text></view><button bindtap="closeSettings">收起</button></view>
      <view class="data-mode"><view><view class="mode-title">当前数据模式</view><view class="mode-value">{{settings.mockMode ? 'Mock 演示数据' : '真实校园后端'}}</view><view class="mode-copy">{{settings.mockMode ? 'AI 与知识库结果均标注为演示' : '请求将发送到已配置的后端地址'}}</view></view><switch checked="{{settings.mockMode}}" color="#5B68F2" bindchange="toggleMock" /></view>
      <view class="setting-group surface"><view class="setting-row"><view class="setting-copy"><view class="setting-name">深色模式</view><view class="setting-subtitle">更适合夜间的深色界面</view></view><switch checked="{{settings.darkMode}}" color="#5B68F2" bindchange="toggleDark" /></view><view class="divider"></view><view class="setting-row"><view class="setting-copy"><view class="setting-name">减少动态效果</view><view class="setting-subtitle">减少页面进入与状态切换动画</view></view><switch checked="{{settings.reduceMotion}}" color="#5B68F2" bindchange="toggleMotion" /></view><view class="divider"></view><view class="setting-row"><view class="setting-copy"><view class="setting-name">截止提醒</view><view class="setting-subtitle">待办临近截止时提醒</view></view><switch checked="{{settings.remindersEnabled}}" color="#5B68F2" bindchange="toggleReminders" /></view></view>
      <view class="backend-panel surface"><view wx:if="{{!editingUrl}}" class="backend-summary"><view class="setting-copy"><view class="setting-name">真实后端服务地址</view><view class="setting-subtitle">{{settings.apiBaseUrl || '尚未配置，仅可使用 Mock 模式'}}</view></view><button class="edit-button" bindtap="editUrl">配置</button></view><view wx:else><input class="field" value="{{apiBaseUrlInput}}" placeholder="例如：https://api.example.edu" bindinput="onUrlInput" /><button class="primary-button save-url" bindtap="saveUrl">保存地址</button></view></view>
      <button class="danger-button logout" bindtap="logout">退出登录</button>
    </view>
  </view>
</view>
