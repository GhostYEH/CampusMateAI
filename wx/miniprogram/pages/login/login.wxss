.login-page{position:relative;height:100vh;overflow:hidden;background:#071424}.visual-image,.visual-shade{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%}.visual-shade{background:linear-gradient(180deg,rgba(4,13,28,.22),rgba(5,18,38,.56) 42%,rgba(5,17,35,.94) 74%)}.visual-content{position:relative;z-index:1;padding-right:44rpx;padding-left:44rpx;color:#fff}.brand-icon{width:76rpx;height:76rpx;border-radius:22rpx}.brand-name{margin-top:16rpx;font-size:22rpx;font-weight:700;letter-spacing:1rpx}.visual-title{margin-top:48rpx;font-size:55rpx;line-height:1.2;font-weight:820}.visual-copy{max-width:540rpx;margin-top:22rpx;color:rgba(255,255,255,.72);font-size:22rpx;line-height:1.6}.panel{position:relative;z-index:2;margin:190rpx 22rpx calc(22rpx + env(safe-area-inset-bottom));padding:34rpx;border-radius:40rpx;background:#f9fbfd;box-shadow:0 18rpx 60rpx rgba(0,0,0,.2)}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.title{color:#1b2730;font-size:38rpx;font-weight:800}.subtitle{margin-top:8rpx;color:#667784;font-size:19rpx}.mode-badge{width:auto;margin:0;padding:10rpx 14rpx;border-radius:18rpx;color:#4e5edb;background:#eff0ff;font-size:17rpx;line-height:1.4}.form{margin-top:26rpx}.input-label{margin:16rpx 0 9rpx;color:#1b2730;font-size:19rpx;font-weight:650}.field{background:#fff}.error-banner{margin-top:14rpx;padding:15rpx 17rpx;border-radius:18rpx;color:#8e3430;background:#f6dad8;font-size:18rpx}.submit{width:100%;margin-top:24rpx;background:#5b68f2}.demo-note{margin-top:18rpx;color:#667784;font-size:17rpx;text-align:center}
.backend-login{padding:14rpx;border-radius:20rpx;background:#eff0ff}.backend-login .input-label{margin-top:0}.backend-input-row{display:flex;gap:12rpx;align-items:stretch}.backend-input-row .field{flex:1;min-width:0}.backend-input-row button{width:116rpx;margin:0;padding:0;border-radius:18rpx;color:#fff;background:#5b68f2;font-size:18rpx;min-height:84rpx;display:flex;align-items:center;justify-content:center;white-space:nowrap}
.mock-recovery{margin:12rpx auto 0;color:#4e5edb;background:transparent;font-size:17rpx;line-height:44rpx}
