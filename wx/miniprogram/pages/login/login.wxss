/*
  Refactored stylesheet for the login page, creating a more dynamic and native-like experience.
*/
.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.visual-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1; /* Place video behind all content */
}

.visual-shade {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  z-index: 0;
}

.visual-content {
  position: relative;
  z-index: 1;
  padding: 48rpx 44rpx;
  color: #fff;
  text-align: left;
}

.brand-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.visual-title {
  margin-top: 32rpx;
  font-size: 52rpx;
  line-height: 1.3;
  font-weight: 700;
}

.visual-copy {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.field {
  background-color: var(--background);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.submit {
  margin-top: 16rpx;
}

.demo-note {
  text-align: center;
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--muted);
}
