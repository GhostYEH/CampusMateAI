.login-page {
  min-height: 100vh;
  background: #071424;
}

.visual {
  position: relative;
  height: 540rpx;
  overflow: hidden;
}

.visual-image,
.visual-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.visual-shade {
  background: linear-gradient(180deg, rgba(7, 20, 36, 0.12), rgba(7, 20, 36, 0.9));
}

.visual-content {
  position: relative;
  z-index: 1;
  padding-left: 44rpx;
  padding-right: 44rpx;
  color: #fff;
}

.brand-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
}

.eyebrow {
  margin-top: 26rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 6rpx;
}

.visual-title {
  margin-top: 16rpx;
  font-size: 46rpx;
  line-height: 1.3;
  font-weight: 740;
  letter-spacing: -1rpx;
}

.visual-copy {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
}

.panel {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 500rpx);
  margin-top: -40rpx;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 24rpx 24rpx 0 0;
  background: #f8fbfd;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.title {
  color: #1b2730;
  font-size: 36rpx;
  font-weight: 740;
}

.subtitle {
  margin-top: 6rpx;
  color: #667784;
  font-size: 23rpx;
}

.mode-badge {
  margin-top: 5rpx;
  padding: 10rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  border-radius: 999rpx;
  color: #2f6486;
  background: #e8f1f7;
  font-size: 20rpx;
  font-weight: 600;
}

.mode-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e08a4e;
}

.form {
  margin-top: 28rpx;
}

.label {
  margin: 20rpx 0 9rpx;
  color: #1b2730;
  font-size: 22rpx;
  font-weight: 650;
}

.password-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-button {
  margin: 0;
  padding: 0 8rpx;
  color: #2f6486;
  background: transparent;
  font-size: 22rpx;
  line-height: 1.5;
}

.submit {
  margin-top: 24rpx;
}

.error-banner {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  color: #8e3430;
  background: #f6dad8;
  font-size: 23rpx;
}

.demo-title {
  margin-top: 28rpx;
  color: #667784;
  font-size: 22rpx;
  font-weight: 600;
}

.demo-accounts {
  margin-top: 14rpx;
  display: block;
}

.account {
  height: 70rpx;
  width: 100%;
  border: 1rpx solid #e2e7ec;
  border-radius: 19rpx;
  color: #667784;
  background: #fff;
  font-size: 23rpx;
}

.account.selected {
  border-color: rgba(47, 100, 134, 0.28);
  color: #2f6486;
  background: #e8f1f7;
  font-weight: 650;
}

.mock-note {
  margin-top: 18rpx;
}
