.login-page{
  --ink:#111A31;
  --blue-deep:#3E50D9;
  --warm:#FFA45B;
  --form-text:#F8FAFF;
  --form-muted:#EBF0FFBD;
  position:relative;
  width:100%;
  height:100vh;
  overflow:hidden;
  background:var(--ink);
}
.bg-video,.bg-image,.bg-shade{
  position:absolute;
  top:0;left:0;right:0;bottom:0;
  width:100%;height:100%;
}
.bg-video,.bg-image{z-index:0;}
.bg-shade{
  z-index:1;
  background:linear-gradient(180deg,#0916325C 0%,#09163252 38%,#091632C4 68%,#091632F0 100%);
}
.content{
  position:relative;
  z-index:2;
  width:100%;
  height:100%;
}

.hero{padding-left:24px;padding-right:24px;}
.brand{display:flex;align-items:center;}
.brand-mark{
  width:40px;height:40px;border-radius:13px;
  background:var(--warm);
  display:flex;align-items:center;justify-content:center;
}
.brand-mark-icon{
  width:23px;height:23px;
  background:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCc+PHBhdGggZmlsbD0nI0ZGRkZGRicgZD0nTTEyIDNMMSA5TDEyIDE1TDIxIDEwLjA5VjE3SDIzVjlNNSAxMy4xOFYxNy4xOEwxMiAyMUwxOSAxNy4xOFYxMy4xOEwxMiAxN0w1IDEzLjE4WicvPjwvc3ZnPg==") center/contain no-repeat;
}
.brand-text{margin-left:10px;}
.brand-name{font-size:14px;font-weight:700;color:#FFFFFF;line-height:1.2;}
.brand-tag{margin-top:2px;font-size:9.5px;color:#FFFFFFB3;}
.hero-title{
  margin-top:66px;
  font-size:32px;line-height:38px;font-weight:700;
  letter-spacing:-0.5px;color:#FFFFFF;
}
.hero-copy{
  display:block;
  margin-top:8px;
  font-size:13px;line-height:20px;
  color:#FFFFFFD1;
  white-space:pre-line;
}

.form{
  margin-top:42px;
  padding:18px 24px 24px;
}
.form-title{font-size:23px;font-weight:700;color:var(--form-text);}
.form-sub{margin-top:4px;font-size:11.5px;color:var(--form-muted);}

.login-field{margin-top:16px;}
.login-field-label{
  font-size:11px;line-height:15px;font-weight:600;
  color:rgba(235,240,255,.74);
}
.login-field-control{
  display:flex;align-items:center;
  width:100%;height:46px;margin-top:6px;
  padding:0 0 0 4px;
  border-bottom:1px solid rgba(255,255,255,.32);
  box-sizing:border-box;
  transition:border-color .2s ease;
}
.login-field-control.is-focused{
  border-bottom-color:#FFFFFF;
}
.login-field-icon{width:18px;height:18px;flex:0 0 auto;margin-right:11px;}
.login-field-input{
  flex:1;min-width:0;
  height:45px;
  font-size:14px;color:var(--form-text);
  background:transparent;border:none;padding:0;
}
.login-field-placeholder{color:rgba(255,255,255,.46);font-size:13px;}
.login-field-eye{
  width:32px;height:45px;flex:0 0 auto;
  background-position:center;background-size:20px 20px;background-repeat:no-repeat;
}

.icon-person{background-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCc+PHBhdGggZmlsbD0nI0VCRjBGRicgZmlsbC1vcGFjaXR5PScwLjc0JyBkPSdNMTIgMTJjMi4yMSAwIDQtMS43OSA0LTRzLTEuNzktNC00LTQtNCAxLjc5LTQgNCAxLjc5IDQgNCA0em0wIDJjLTIuNjcgMC04IDEuMzQtOCA0djJoMTZ2LTJjMC0yLjY2LTUuMzMtNC04LTR6Jy8+PC9zdmc+");}
.icon-lock{background-image:url("data:image/svg+xml;base64,");}
.icon-eye-on{background-image:url("data:image/svg+xml;base64,");}
.icon-eye-off{background-image:url("data:image/svg+xml;base64,");}

.remember-row{
  display:flex;align-items:center;
  width:100%;height:48px;margin-top:16px;
}
.remember-box{
  width:18px;height:18px;border-radius:5px;
  margin-left:4px;
  border:1px solid rgba(235,240,255,.74);
  background:transparent;
  display:flex;align-items:center;justify-content:center;
  transition:background .18s ease,border-color .18s ease;
}
.remember-box.checked{background:#596AF0;border-color:#596AF0;}
.remember-check{
  width:12px;height:12px;
  background:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCc+PHBhdGggZmlsbD0nI0ZGRkZGRicgZD0nTTkgMTYuMTdMNC44MyAxMmwtMS40MiAxLjQxTDkgMTkgMjEgN2wtMS40MS0xLjQxeicvPjwvc3ZnPg==") center/contain no-repeat;
}
.remember-text{margin-left:12px;font-size:12px;color:rgba(235,240,255,.74);}

.error-banner{
  margin-top:16px;
  padding:9px 12px;border-radius:10px;
  background:#3E171A66;color:#FFC5BF;
  font-size:11.5px;line-height:1.4;
}

.submit-btn{
  display:flex;align-items:center;justify-content:center;
  width:100%;height:51px;margin-top:16px;
  border-radius:14px;background:#FFFFFF;
  transition:opacity .15s ease,transform .15s ease;
}
.submit-btn.is-loading{opacity:0.82;}
.submit-pressed{transform:scale(0.96);opacity:0.9;}
.submit-text{font-size:14px;font-weight:700;color:var(--blue-deep);}
.submit-arrow{
  width:17px;height:17px;margin-left:8px;
  background:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCc+PHBhdGggZmlsbD0nIzNFNTBEOScgZD0nTTEyIDRsLTEuNDEgMS40MUwxNi4xNyAxMUg0djJoMTIuMTdsLTUuNTggNS41OUwxMiAyMGw4LTh6Jy8+PC9zdmc+") center/contain no-repeat;
}
.submit-spinner{
  width:18px;height:18px;
  border:2px solid #3E50D940;border-top-color:var(--blue-deep);
  border-radius:50%;
  animation:login-spin 0.8s linear infinite;
}
@keyframes login-spin{to{transform:rotate(360deg);}}

.form-foot{
  margin-top:16px;
  font-size:9.5px;color:#FFFFFF7A;
  text-align:center;
}
