<view class="login-page {{reduceMotion ? 'reduce-motion' : ''}}">
  <view class="visual">
    <image class="visual-image" src="/assets/campus-login.jpg" mode="aspectFill"></image>
    <view class="visual-shade"></view>
    <view class="visual-content" style="padding-top: {{statusBarHeight + 24}}px;">
      <image class="brand-icon" src="/assets/app-icon.png" mode="aspectFill"></image>
      <view class="eyebrow">CAMPUS AI</view>
      <view class="visual-title">让校园里的每件事，<br/>都更有条理。</view>
      <view class="visual-copy">通知、待办与学习节奏，由你掌握。</view>
    </view>
  </view>

  <view class="panel enter">
    <view class="panel-head">
      <view>
        <view class="title">欢迎回来</view>
        <view class="subtitle">登录你的校园助手</view>
      </view>
      <view class="mode-badge">
        <view class="mode-dot"></view>
        <text>{{mockMode ? 'Mock 演示' : '真实后端'}}</text>
      </view>
    </view>

    <view class="form">
      <view class="label">校园账号</view>
      <input
        class="field"
        value="{{username}}"
        placeholder="请输入校园账号"
        bindinput="onUsername"
      />

      <view class="label password-label">
        <text>密码</text>
        <button class="text-button" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</button>
      </view>
      <input
        class="field"
        value="{{password}}"
        password="{{!showPassword}}"
        placeholder="请输入密码"
        bindinput="onPassword"
        bindconfirm="submit"
      />

      <view wx:if="{{error}}" class="error-banner">{{error}}</view>

      <button
        class="primary-button submit"
        loading="{{loading}}"
        disabled="{{loading}}"
        hover-class="button-pressed"
        bindtap="submit"
      >{{loading ? '正在登录…' : '登录'}}</button>
    </view>

    <view class="demo-title">演示账号</view>
    <view class="demo-accounts">
      <button class="account {{username === 'student_demo' ? 'selected' : ''}}" data-username="student_demo" bindtap="chooseAccount">学生</button>
    </view>
    <view class="mock-note">演示密码统一为 Demo123456。Mock 模式数据仅用于比赛演示。</view>
  </view>
</view>
