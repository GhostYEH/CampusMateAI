<!--
  Refactored WXML for the login page, featuring a video background and a layout aligned with the Android app's design.
-->
<view class="login-page {{reduceMotion ? 'reduce-motion' : ''}}">
  <!-- Video Background -->
  <video
    class="visual-video"
    src="http://127.0.0.1:8000/login_campus.mp4"
    autoplay
    loop
    muted
    show-play-btn="{{false}}"
    controls="{{false}}"
    object-fit="cover"
  ></video>

  <view class="visual-shade"></view>

  <view class="visual-content" style="padding-top: {{statusBarHeight + 48}}px;">
    <image class="brand-icon" src="/assets/app-icon.png" mode="aspectFill"></image>
    <view class="visual-title">欢迎使用<br/>Campus AI</view>
    <view class="visual-copy">登录以继续</view>
  </view>

  <view class="panel enter">
    <view class="panel-head">
      <view class="title">登录</view>
      <view class="mode-badge">
        <text>{{mockMode ? 'Mock 模式' : '真实后端'}}</text>
      </view>
    </view>

    <view class="form">
      <input
        class="field"
        value="{{username}}"
        placeholder="校园账号"
        bindinput="onUsername"
      />
      <input
        class="field"
        value="{{password}}"
        password="{{!showPassword}}"
        placeholder="密码"
        bindinput="onPassword"
        bindconfirm="submit"
      />

      <view wx:if="{{error}}" class="error-banner">{{error}}</view>

      <button
        class="primary-button submit"
        loading="{{loading}}"
        disabled="{{loading}}"
        hover-class="button-pressed"
        bindtap="submit"
      >{{loading ? '正在登录…' : '登录'}}</button>
    </view>

    <view class="demo-note">演示账号: student_demo / 密码: Demo123456</view>
  </view>
</view>
