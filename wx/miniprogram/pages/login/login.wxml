<view class="login-page">
  <video wx:if="{{!reduceMotion && videoOk && videoSrc}}"
    class="bg-video"
    src="{{videoSrc}}"
    autoplay
    loop
    muted
    controls="{{false}}"
    show-center-play-btn="{{false}}"
    show-play-btn="{{false}}"
    show-fullscreen-btn="{{false}}"
    enable-progress-gesture="{{false}}"
    object-fit="cover"
    binderror="onVideoError"
  ></video>
  <image wx:if="{{reduceMotion || !videoOk || !videoSrc}}" class="bg-image" src="/assets/campus-login.jpg" mode="aspectFill"></image>
  <view class="bg-shade"></view>

  <scroll-view class="content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hero" style="padding-top: {{statusBarHeight + 20}}px;">
      <view class="brand">
        <view class="brand-mark"><view class="brand-mark-icon"></view></view>
        <view class="brand-text">
          <view class="brand-name">CampusMate AI</view>
          <view class="brand-tag">校园事务 · 温和陪伴</view>
        </view>
      </view>
      <view class="hero-title">欢迎回到校园</view>
      <text class="hero-copy">课程、通知与每一个重要截止，
都替你稳稳记着。</text>
    </view>

    <view class="form">
      <view class="form-title">登录 CampusMate</view>
      <view class="form-sub">使用学校统一身份账号继续。</view>

      <view class="login-field">
        <view class="login-field-label">账号</view>
        <view class="login-field-control {{usernameFocused ? 'is-focused' : ''}}">
          <view class="login-field-icon icon-person"></view>
          <input class="login-field-input" value="{{username}}" placeholder="学号 / 工号 / 用户名" placeholder-class="login-field-placeholder" bindinput="onUsername" bindfocus="onUserFocus" bindblur="onUserBlur" confirm-type="next" />
        </view>
      </view>

      <view class="login-field">
        <view class="login-field-label">密码</view>
        <view class="login-field-control {{passwordFocused ? 'is-focused' : ''}}">
          <view class="login-field-icon icon-lock"></view>
          <input class="login-field-input" value="{{password}}" password="{{!showPassword}}" placeholder="请输入密码" placeholder-class="login-field-placeholder" bindinput="onPassword" bindfocus="onPwdFocus" bindblur="onPwdBlur" bindconfirm="submit" confirm-type="done" />
          <view class="login-field-eye icon-eye-{{showPassword ? 'off' : 'on'}}" bindtap="togglePassword"></view>
        </view>
      </view>

      <view wx:if="{{error}}" class="error-banner">{{error}}</view>

      <view class="remember-row" bindtap="toggleRemember">
        <view class="remember-box {{rememberMe ? 'checked' : ''}}">
          <view wx:if="{{rememberMe}}" class="remember-check"></view>
        </view>
        <view class="remember-text">记住账号密码（下次自动登录）</view>
      </view>

      <view class="submit-btn {{loading ? 'is-loading' : ''}}" hover-class="submit-pressed" bindtap="submit">
        <view wx:if="{{loading}}" class="submit-spinner"></view>
        <block wx:else>
          <view class="submit-text">进入校园空间</view>
          <view class="submit-arrow"></view>
        </block>
      </view>

      <view class="form-foot">登录即表示你已阅读并同意校园数据使用说明</view>
    </view>
  </scroll-view>
</view>
