<!--
  Refactored WXML for the courses page.
  - A cleaner, card-based layout for the course list.
  - A simplified filtering experience.
  - Aligned with the Android app's design principles.
-->
<view class="page tab-page courses-page {{darkMode ? 'dark' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}">
  <campus-header
    title="我的课程"
    subtitle="本周共 {{courses.length}} 门课程"
    mode="{{mockMode ? 'Mock 数据' : '真实后端'}}"
  />

  <view class="page-body">
    <!-- Filters -->
    <view class="filters enter">
      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-row">
          <button
            wx:for="{{filters}}"
            wx:key="*this"
            class="filter-chip {{filter === item ? 'selected' : ''}}"
            data-filter="{{item}}"
            bindtap="chooseFilter"
          >{{item}}</button>
        </view>
      </scroll-view>
    </view>

    <!-- Loading/Error/Empty States -->
    <state-view
      wx:if="{{loading}}"
      state="loading"
      title="正在加载课程..."
      description="请稍候"
    />
    <state-view
      wx:elif="{{error}}"
      state="error"
      title="加载失败"
      description="{{error}}"
      actionText="重试"
      bindaction="load"
    />
    <state-view
      wx:elif="{{filtered.length === 0}}"
      state="empty"
      title="暂无课程"
      description="该分类下没有课程"
    />

    <!-- Course Cards -->
    <view wx:else class="course-grid">
      <view
        wx:for="{{filtered}}"
        wx:key="code"
        class="course-card enter"
        style="animation-delay: {{index * 50}}ms;"
      >
        <view class="card-header">
          <view class="course-name">{{item.name}}</view>
          <view class="course-type">{{item.type}}</view>
        </view>
        <view class="card-body">
          <view class="info-row">
            <image class="info-icon" src="/assets/icons/pin-white.svg" />
            <text>{{item.location}}</text>
          </view>
          <view class="info-row">
            <image class="info-icon" src="/assets/icons/clock-white.svg" />
            <text>{{item.weekday}} {{item.time}}</text>
          </view>
        </view>
        <view class="card-footer">
          <text>{{item.teacher}}</text>
          <view class="details-link">详情 ›</view>
        </view>
      </view>
    </view>
  </view>
</view>
