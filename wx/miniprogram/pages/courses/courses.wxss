.course-hero {
  min-height: 286rpx;
  padding: 26rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 22rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 18rpx;
  color: #ffffff;
  background: #2f6486;
}

.course-hero-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.course-hero-kicker {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 19rpx;
}

.hero-accent-dot {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 50%;
  background: var(--accent);
}

.course-hero-name {
  margin-top: 24rpx;
  overflow: hidden;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-hero-meta {
  margin-top: 10rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-hero-actions {
  margin-top: auto;
  display: flex;
  gap: 20rpx;
}

.course-hero-actions button {
  min-height: 40rpx;
  margin: 0;
  padding: 0;
  color: rgba(255, 255, 255, 0.9);
  background: transparent;
  font-size: 19rpx;
  line-height: 1;
}

.course-hero-actions button::before {
  content: '·';
  margin-right: 7rpx;
  color: var(--accent);
}

.course-hero-side {
  width: 88rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.course-hero-icon {
  width: 52rpx;
  height: 52rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.16);
  box-sizing: content-box;
}

.course-hero-count {
  color: rgba(255, 255, 255, 0.82);
  font-size: 18rpx;
}

.course-metrics {
  min-height: 108rpx;
  margin-top: 14rpx;
  padding: 10rpx 6rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  box-sizing: border-box;
}

.course-metric {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-align: center;
}

.metric-value {
  overflow: hidden;
  color: var(--text);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 740;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-value.primary { color: var(--primary); }
.metric-value.green { color: var(--success); }
.metric-value.orange { color: var(--accent); }
.metric-value.navy { color: #3c687f; font-size: 19rpx; }

.metric-label {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-divider {
  width: 1rpx;
  height: 44rpx;
  flex: none;
  background: var(--line);
}

.course-section-head {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.course-section-title {
  color: var(--text);
  font-size: 29rpx;
  font-weight: 730;
}

.course-section-count {
  color: var(--muted);
  font-size: 19rpx;
}

.filter-scroll {
  width: calc(100% + 56rpx);
  margin: 15rpx -28rpx 0;
}

.filter-row {
  padding: 0 28rpx 4rpx;
  display: inline-flex;
  gap: 9rpx;
  white-space: nowrap;
}

.filter-chip {
  height: 58rpx;
  min-width: 102rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  color: var(--muted);
  background: var(--surface);
  font-size: 19rpx;
  line-height: 58rpx;
  white-space: nowrap;
}

.filter-chip.selected {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-soft);
  font-weight: 680;
}

.course-list {
  margin-top: 14rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.course-card {
  min-width: 0;
  width: 100%;
  min-height: 122rpx;
  padding: 17rpx 15rpx 17rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 13rpx;
  border-top: 1rpx solid var(--line);
  background: var(--surface);
  box-sizing: border-box;
}

.course-card:first-child {
  border-top: 0;
}

.course-code-box {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 14rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 16rpx;
  font-weight: 800;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-main {
  min-width: 0;
  flex: 1;
}

.course-title-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.course-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--text);
  font-size: 23rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-type {
  max-width: 110rpx;
  flex: none;
  overflow: hidden;
  padding: 5rpx 7rpx;
  border-radius: 7rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 15rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-teacher {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta-row {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
  color: var(--muted);
  font-size: 16rpx;
}

.course-chevron {
  flex: none;
  color: var(--muted-light);
  font-size: 31rpx;
  line-height: 1;
}

@media (max-width: 350px) {
  .course-hero {
    padding: 23rpx;
  }

  .course-hero-side {
    width: 74rpx;
  }

  .course-hero-icon {
    width: 44rpx;
    height: 44rpx;
    padding: 13rpx;
  }

  .course-code-box {
    width: 62rpx;
    height: 62rpx;
  }

  .course-card {
    gap: 10rpx;
    padding-right: 10rpx;
    padding-left: 12rpx;
  }
}
