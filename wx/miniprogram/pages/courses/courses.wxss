/*
  Refactored stylesheet for the courses page.
*/
.courses-page .page-body {
  padding-top: 16rpx;
}

/* Filters */
.filters {
  margin-bottom: 24rpx;
}

.filter-scroll {
  width: 100%;
}

.filter-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 28rpx;
  white-space: nowrap;
}

.filter-chip {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 64rpx;
  background: var(--surface-subtle);
  color: var(--muted);
  border: 1rpx solid var(--line);
}

.filter-chip.selected {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
  border-color: var(--primary);
}

/* Course Grid */
.course-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24rpx;
  padding: 0 28rpx;
}

.course-card {
  border-radius: 24rpx;
  padding: 28rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(47, 100, 134, 0.2);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.course-name {
  font-size: 34rpx;
  font-weight: 700;
  flex: 1;
  line-height: 1.3;
}

.course-type {
  padding: 8rpx 14rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 16rpx 0;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.details-link {
  font-weight: 600;
  color: #fff;
}
