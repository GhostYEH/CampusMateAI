.course-hero {
  min-height: 328rpx;
  padding: 28rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 22rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #5268eb 0%, #7a80f2 100%);
}

.course-hero-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.course-hero-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 20rpx;
}

.hero-accent-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: #ffc35c;
}

.course-hero-name {
  margin-top: 22rpx;
  overflow: hidden;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 780;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-hero-meta {
  margin-top: 12rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-hero-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 24rpx;
}

.course-hero-actions button {
  min-height: 42rpx;
  margin: 0;
  padding: 0;
  color: rgba(255, 255, 255, 0.9);
  background: transparent;
  font-size: 19rpx;
  line-height: 1;
}

.course-hero-actions button::before {
  content: '·';
  margin-right: 8rpx;
  color: rgba(255, 255, 255, 0.58);
}

.course-hero-side {
  width: 106rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.course-hero-icon {
  width: 86rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.17);
  font-size: 32rpx;
  font-weight: 780;
}

.course-hero-count {
  color: rgba(255, 255, 255, 0.82);
  font-size: 19rpx;
}

.course-metrics {
  min-height: 112rpx;
  margin-top: 18rpx;
  padding: 12rpx 8rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--surface);
  box-sizing: border-box;
}

.course-metric {
  min-width: 0;
  flex: 1;
  text-align: center;
}

.metric-value {
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 780;
}

.metric-value.primary { color: var(--primary); }
.metric-value.green { color: #3d9b79; }
.metric-value.orange { color: #e08a4e; }
.metric-value.purple { color: #8665d8; }

.metric-label {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.metric-divider {
  width: 1rpx;
  height: 48rpx;
  flex: none;
  background: var(--line);
}

.course-section-head {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.course-section-title {
  font-size: 32rpx;
  font-weight: 780;
}

.course-section-count {
  color: var(--muted);
  font-size: 20rpx;
}

.filter-scroll {
  width: calc(100% + 56rpx);
  margin: 16rpx -28rpx 0;
}

.filter-row {
  padding: 0 28rpx 4rpx;
  display: inline-flex;
  gap: 12rpx;
  white-space: nowrap;
}

.filter-chip {
  height: 64rpx;
  min-width: 112rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  background: var(--surface);
  font-size: 21rpx;
  line-height: 64rpx;
  white-space: nowrap;
}

.filter-chip.selected {
  border-color: rgba(86, 105, 238, 0.25);
  color: #ffffff;
  background: var(--primary);
  font-weight: 700;
}

.course-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.course-card {
  min-width: 0;
  width: 100%;
  min-height: 126rpx;
  padding: 20rpx 16rpx 20rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  background: var(--surface);
  box-sizing: border-box;
}

.course-code-box {
  width: 78rpx;
  height: 78rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 22rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 17rpx;
  font-weight: 800;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-main {
  min-width: 0;
  flex: 1;
}

.course-title-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.course-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--text);
  font-size: 26rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-type {
  max-width: 118rpx;
  flex: none;
  overflow: hidden;
  padding: 5rpx 8rpx;
  border-radius: 8rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-teacher {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta-row {
  margin-top: 9rpx;
  display: flex;
  gap: 14rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.course-attendance {
  width: 70rpx;
  flex: none;
  text-align: center;
}

.attendance-bar {
  width: 62rpx;
  height: 8rpx;
  margin: 0 auto 7rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--primary-soft);
}

.attendance-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--primary);
}

.attendance-value {
  color: var(--text);
  font-size: 18rpx;
  font-weight: 720;
}

.attendance-label {
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 15rpx;
}

.course-chevron {
  flex: none;
  color: var(--muted);
  font-size: 34rpx;
  line-height: 1;
}

@media (max-width: 350px) {
  .course-hero {
    padding: 24rpx;
  }

  .course-hero-side {
    width: 82rpx;
  }

  .course-hero-icon {
    width: 70rpx;
    height: 70rpx;
  }

  .course-code-box {
    width: 68rpx;
    height: 68rpx;
  }

  .course-card {
    gap: 10rpx;
    padding-left: 12rpx;
    padding-right: 10rpx;
  }

  .course-attendance {
    width: 58rpx;
  }

  .attendance-bar {
    width: 52rpx;
  }
}
