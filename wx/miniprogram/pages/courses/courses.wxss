.courses-body{padding-top:12rpx}.next-course-card{padding:34rpx 30rpx 28rpx;border-radius:34rpx;color:#fff;background:linear-gradient(135deg,#5364ee,#7282ed)}.next-kicker{color:rgba(255,255,255,.73);font-size:21rpx}.next-title{margin-top:25rpx;font-size:39rpx;font-weight:800}.next-location{margin-top:20rpx;color:rgba(255,255,255,.75);font-size:22rpx}.next-links{margin-top:50rpx;display:flex;align-items:center;gap:23rpx;color:rgba(255,255,255,.82);font-size:18rpx}.next-links button{margin-left:auto;padding:0 20rpx;height:58rpx;border-radius:30rpx;color:var(--primary);background:#fff;font-size:20rpx;line-height:58rpx}
.week-strip{margin-top:18rpx;padding:20rpx 14rpx;display:grid;grid-template-columns:repeat(7,1fr);border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface)}.week-day{text-align:center;color:var(--muted);font-size:18rpx}.week-day>view:not(.day-dot){width:48rpx;height:48rpx;margin:9rpx auto 0;border-radius:50%;color:var(--text);font-size:20rpx;font-weight:700;line-height:48rpx}.week-day .day-dot{display:block;width:7rpx;height:7rpx;margin:7rpx auto 0;border-radius:50%;background:var(--line)}.week-day.active{color:var(--primary)}.week-day.active>view:not(.day-dot){color:#fff;background:var(--primary)}.week-day:nth-child(3) .day-dot,.week-day:nth-child(5) .day-dot{background:var(--accent)}
.course-stats{margin-top:18rpx;padding:20rpx 8rpx;display:grid;grid-template-columns:repeat(4,1fr);border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface)}.course-stats>view{display:flex;flex-direction:column;align-items:center;border-left:1rpx solid var(--line)}.course-stats>view:first-child{border-left:0}.course-stats .stat-value{font-size:23rpx;color:var(--primary);font-weight:700}.course-stats .teal{color:#32b99e}.course-stats .orange{color:#f49a44}.course-stats .violet{color:#8865e7}.course-stats text{margin-top:13rpx;color:var(--muted);font-size:17rpx}
.filter-scroll{width:100%;margin-top:18rpx;white-space:nowrap}.filter-row{display:inline-flex;gap:12rpx}.filter-chip{height:60rpx;margin:0;padding:0 22rpx;border:1rpx solid var(--line);border-radius:30rpx;color:var(--muted);background:var(--surface);font-size:20rpx;line-height:60rpx}.filter-chip.selected{border-color:var(--primary);color:#fff;background:var(--primary);font-weight:700}.list-heading{margin:26rpx 4rpx 14rpx;display:flex;align-items:center;justify-content:space-between}.list-title{font-size:31rpx;font-weight:760;color:var(--text)}.list-copy{margin-top:7rpx;color:var(--muted);font-size:19rpx}.list-heading>text{color:var(--muted);font-size:19rpx}
.course-list{display:flex;flex-direction:column;gap:14rpx}.course-card{min-height:142rpx;padding:23rpx 22rpx;display:flex;align-items:center;gap:17rpx;border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface);box-sizing:border-box}.course-glyph{width:66rpx;height:66rpx;flex:none;border-radius:17rpx;color:var(--primary);background:var(--primary-soft);font-size:30rpx;text-align:center;line-height:66rpx}.course-main{min-width:0;flex:1}.course-name{overflow:hidden;color:var(--text);font-size:24rpx;font-weight:730;text-overflow:ellipsis;white-space:nowrap}.course-name text{margin-left:8rpx;padding:7rpx 10rpx;border-radius:9rpx;color:var(--primary);background:var(--primary-soft);font-size:16rpx;font-weight:500}.course-teacher,.course-time{margin-top:9rpx;overflow:hidden;color:var(--muted);font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.attendance{width:64rpx;flex:none;text-align:center}.attendance-value{display:block;color:var(--primary);font-size:18rpx;font-weight:700}.attendance text{display:block;margin-top:16rpx;color:var(--muted);font-size:14rpx}.arrow{color:var(--muted);font-size:36rpx}
