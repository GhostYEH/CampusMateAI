.week-summary {
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  border-radius: 32rpx;
  color: #fff;
  background: var(--primary);
}

.week-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
}

.week-value {
  margin-top: 9rpx;
  font-size: 36rpx;
  font-weight: 730;
}

.week-copy {
  max-width: 355rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  line-height: 1.55;
}

.filter-scroll {
  width: calc(100% + 56rpx);
  margin: 24rpx -28rpx 0;
}

.filter-row {
  width: max-content;
  padding: 0 28rpx 5rpx;
  display: flex;
  gap: 12rpx;
}

.filter-chip {
  height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  background: var(--surface);
  font-size: 22rpx;
}

.filter-chip.selected {
  border-color: rgba(47, 100, 134, 0.25);
  color: var(--primary);
  background: var(--primary-soft);
  font-weight: 650;
}

.course-list {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.course-card {
  min-width: 0;
  padding: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  background: var(--surface);
}

.course-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.course-code {
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
}

.course-type {
  overflow: hidden;
  color: var(--muted);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-name {
  min-height: 78rpx;
  margin-top: 18rpx;
  font-size: 29rpx;
  line-height: 1.38;
  font-weight: 720;
}

.course-detail {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.detail-block + .detail-block {
  margin-top: 13rpx;
}

.detail-label {
  color: var(--muted);
  font-size: 18rpx;
}

.detail-value {
  margin-top: 5rpx;
  color: var(--text);
  font-size: 21rpx;
  line-height: 1.4;
}

.course-teacher {
  margin-top: 16rpx;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
}
