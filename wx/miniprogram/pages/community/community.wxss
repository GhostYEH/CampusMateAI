.community-body{padding-top:120px}.community-heading{display:flex;align-items:center;justify-content:space-between;gap:18px}.community-title{font-size:31px;font-weight:820;letter-spacing:-1px}.community-subtitle{margin-top:7px;color:var(--campus-muted);font-size:13px}.publish-entry{height:42px;margin:0;padding:0 18px;border-radius:14px;color:#fff;background:var(--campus-primary);font-size:13px;font-weight:700;line-height:42px}.community-notice{margin-top:22px;padding:20px;display:flex;align-items:center;gap:14px;border:1px solid #d9ddff;border-radius:20px;background:#f8f8ff}.notice-icon{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:15px;background:var(--campus-primary-soft)}.notice-icon image{width:26px;height:26px}.community-notice view view{font-size:17px;font-weight:760}.community-notice text{display:block;margin-top:6px;color:var(--campus-muted);font-size:12px;line-height:1.5}.composer{margin-top:20px;padding:18px;border:1px solid #cfd4ff;border-radius:20px;background:#fff}.composer-title,.composer-content{width:100%;box-sizing:border-box;border:1px solid var(--campus-line);border-radius:13px;background:#f8fafb;font-size:14px}.composer-title{height:46px;padding:0 13px}.composer-content{height:118px;margin-top:10px;padding:13px}.composer-actions{margin-top:12px;display:flex;justify-content:flex-end;gap:8px}.composer-actions button{height:38px;margin:0;padding:0 17px;border-radius:12px;color:var(--campus-muted);background:#f1f4f6;font-size:12px;line-height:38px}.composer-actions .send{color:#fff;background:var(--campus-primary)}.post-list{margin-top:18px;display:flex;flex-direction:column;gap:14px}.post-card{padding:20px;border:1px solid var(--campus-line);border-radius:20px;background:#fff}.post-top{display:flex;align-items:center}.post-avatar{width:42px;height:42px;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:linear-gradient(145deg,#596af0,#8070ee);font-size:17px;font-weight:700}.post-author{min-width:0;flex:1;margin-left:11px}.post-author view{font-size:14px;font-weight:700}.post-author text{display:block;margin-top:4px;color:var(--campus-muted);font-size:10px}.post-tag{padding:5px 9px;border-radius:999px;color:var(--campus-primary);background:var(--campus-primary-soft);font-size:10px}.post-title{margin-top:18px;font-size:18px;font-weight:780}.post-content{margin-top:9px;color:#43515b;font-size:13px;line-height:1.7}.post-stats{margin-top:18px;padding-top:13px;display:flex;gap:22px;border-top:1px solid var(--campus-line);color:var(--campus-muted);font-size:11px}

@import "community-forum.wxss";
