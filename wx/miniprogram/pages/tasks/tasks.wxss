.tasks-body{padding-top:10rpx}.task-summary{padding:28rpx 20rpx;display:grid;grid-template-columns:repeat(4,1fr) 108rpx;align-items:center;border:1rpx solid var(--line);border-radius:34rpx;background:var(--surface)}.task-summary>view{text-align:center}.task-summary text{display:block;color:var(--muted);font-size:18rpx}.task-summary strong{display:block;margin-top:15rpx;color:var(--text);font-size:37rpx}.task-summary i{display:block;width:28rpx;height:5rpx;margin:14rpx auto 0;border-radius:5rpx;background:var(--primary)}.task-summary .warm{color:var(--accent)}.task-summary .green{color:var(--success)}.task-summary .progress-badge{width:92rpx;height:92rpx;border:12rpx solid var(--primary-soft);border-radius:50%;display:flex;align-items:center;justify-content:center;justify-self:center;box-sizing:border-box}.progress-badge strong{margin:0;color:var(--primary);font-size:20rpx}
.date-layout{margin-top:20rpx;display:flex;gap:16rpx}.week-strip{min-width:0;flex:1;padding:20rpx 12rpx;display:grid;grid-template-columns:repeat(7,1fr);border:1rpx solid var(--line);border-radius:30rpx;background:var(--surface)}.week-day{text-align:center;color:var(--muted);font-size:17rpx}.week-day strong{display:block;width:45rpx;height:45rpx;margin:9rpx auto 0;border-radius:50%;color:var(--text);font-size:21rpx;line-height:45rpx}.week-day i{display:block;width:7rpx;height:7rpx;margin:8rpx auto 0;border-radius:50%;background:#a4a8f7}.week-day.active strong{color:#fff;background:var(--primary)}.date-layout>button{width:126rpx;margin:0;padding:0;border-radius:28rpx;color:var(--primary);background:var(--surface);font-size:32rpx}.date-layout>button text{display:block;color:var(--text);font-size:18rpx;font-weight:700}
.task-toolbar{margin-top:22rpx;padding:24rpx;border:1rpx solid var(--line);border-radius:32rpx;background:var(--surface)}.search-field{height:76rpx;padding:0 20rpx;display:flex;align-items:center;gap:14rpx;border:1rpx solid var(--line);border-radius:23rpx;color:var(--muted);font-size:37rpx}.search-field input{min-width:0;flex:1;color:var(--text);font-size:22rpx}.task-toolbar scroll-view{margin-top:18rpx;white-space:nowrap}.filters{display:inline-flex;gap:12rpx}.filter{height:56rpx;margin:0;padding:0 22rpx;border:1rpx solid var(--line);border-radius:28rpx;color:var(--muted);background:var(--surface);font-size:19rpx;line-height:56rpx}.filter.selected{border-color:var(--primary);color:#fff;background:var(--primary);font-weight:700}
.focus-card{margin-top:22rpx;padding:27rpx 30rpx;border:2rpx solid #d6d8ff;border-radius:34rpx;background:linear-gradient(135deg,#f5f5ff,#fff)}.dark .focus-card{background:var(--primary-soft)}.focus-kicker{color:var(--primary);font-size:22rpx;font-weight:750}.focus-row{margin-top:18rpx;display:flex;align-items:center;gap:18rpx}.focus-row>view{min-width:0;flex:1}.focus-row strong{display:block;overflow:hidden;color:var(--text);font-size:27rpx;text-overflow:ellipsis;white-space:nowrap}.focus-row text{display:block;margin-top:12rpx;color:var(--muted);font-size:19rpx}.focus-row button{margin:0;padding:0;color:var(--primary);background:transparent;font-size:22rpx;font-weight:700}.task-section-head{margin:30rpx 2rpx 14rpx;display:flex;justify-content:space-between;align-items:center}.task-section-title{font-size:33rpx;font-weight:780;color:var(--text)}.task-section-count{color:var(--muted);font-size:20rpx}.task-list{display:flex;flex-direction:column;gap:14rpx}.task-card{min-height:116rpx;padding:20rpx 22rpx;display:flex;align-items:center;gap:18rpx;border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface)}.check-button{width:38rpx;height:38rpx;flex:none;border:3rpx solid var(--primary);border-radius:6rpx}.check-button.checked{background:var(--success);border-color:var(--success)}.check-core{width:12rpx;height:12rpx;margin:10rpx;border-radius:2rpx;background:#fff;opacity:0}.checked .check-core{opacity:1}.task-main{min-width:0;flex:1}.task-title{overflow:hidden;color:var(--text);font-size:23rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.done .task-title{text-decoration:line-through;color:var(--muted)}.task-meta{margin-top:11rpx;color:var(--muted);font-size:18rpx}.task-meta text{padding:7rpx 10rpx;border-radius:9rpx;color:var(--primary);background:var(--primary-soft)}.delete-button{width:45rpx;margin:0;padding:0;color:var(--muted);background:transparent;font-size:30rpx}.floating-add{position:fixed;z-index:20;right:38rpx;bottom:calc(154rpx + env(safe-area-inset-bottom));height:78rpx;margin:0;padding:0 26rpx;border-radius:24rpx;color:#fff;background:var(--primary);box-shadow:0 12rpx 25rpx rgba(91,104,242,.28);font-size:22rpx;font-weight:750;line-height:78rpx}
.sheet-mask{position:fixed;z-index:50;inset:0;display:flex;align-items:flex-end;background:rgba(7,20,36,.46)}.sheet{width:100%;padding:18rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:36rpx 36rpx 0 0;background:var(--surface)}.sheet-handle{width:68rpx;height:7rpx;margin:0 auto 22rpx;border-radius:9rpx;background:var(--line)}.sheet-title{font-size:34rpx;font-weight:750;color:var(--text)}.sheet-copy{margin-top:6rpx;color:var(--muted);font-size:20rpx}.input-label{margin:22rpx 0 9rpx;color:var(--text);font-size:21rpx;font-weight:650}.sheet-actions{margin-top:24rpx;display:flex;gap:12rpx}.sheet-actions button{flex:1}
.summary-value{display:block;margin-top:15rpx;color:var(--text);font-size:37rpx;font-weight:700}.summary-line{display:block;width:28rpx;height:5rpx;margin:14rpx auto 0;border-radius:5rpx;background:var(--primary)}.progress-badge>view{color:var(--primary);font-size:20rpx;font-weight:700}.week-day .date-value{display:block;width:45rpx;height:45rpx;margin:9rpx auto 0;border-radius:50%;color:var(--text);font-size:21rpx;font-weight:700;line-height:45rpx}.week-day .date-dot{display:block;width:7rpx;height:7rpx;margin:8rpx auto 0;border-radius:50%;background:#a4a8f7}.week-day.active .date-value{color:#fff;background:var(--primary)}.focus-title{display:block;overflow:hidden;color:var(--text);font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.date-layout>button{display:flex;flex-direction:column;align-items:center;justify-content:center}.date-layout>button image{width:42rpx;height:42rpx}.search-field icon{flex:none}.delete-button{width:64rpx!important;color:var(--muted);font-size:17rpx!important}
.date-layout{margin-top:24rpx;gap:18rpx}.week-strip{padding:28rpx 14rpx}.week-day .date-value{width:56rpx;height:56rpx;line-height:56rpx}.date-layout>button{width:132rpx}.task-toolbar{margin-top:24rpx;padding:32rpx}.search-field{height:92rpx}.filter{height:68rpx;border-radius:34rpx;line-height:68rpx}.focus-card{margin-top:24rpx;padding:34rpx 36rpx}.focus-row{margin-top:22rpx}.task-card{min-height:148rpx;padding:25rpx 26rpx}.task-list{gap:18rpx}
