.task-hero {
  padding: 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30rpx;
  border: 1rpx solid var(--line);
  border-radius: 34rpx;
  background: var(--surface);
}

.hero-label {
  color: var(--muted);
  font-size: 21rpx;
}

.hero-value {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 760;
}

.hero-copy {
  max-width: 390rpx;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.progress-badge {
  width: 128rpx;
  height: 128rpx;
  flex: none;
  border: 12rpx solid var(--primary-soft);
  border-top-color: var(--primary);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.progress-value {
  font-size: 29rpx;
  font-weight: 720;
}

.progress-caption {
  margin-top: 3rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.task-toolbar {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.filters {
  padding: 7rpx;
  display: flex;
  gap: 5rpx;
  border-radius: 22rpx;
  background: var(--primary-soft);
}

.filter {
  height: 57rpx;
  margin: 0;
  padding: 0 17rpx;
  border-radius: 16rpx;
  color: var(--muted);
  background: transparent;
  font-size: 21rpx;
}

.filter.selected {
  color: var(--primary);
  background: var(--surface);
  font-weight: 650;
}

.add-button {
  min-height: 70rpx;
  margin: 0;
  padding: 0 23rpx;
  border-radius: 20rpx;
  color: #fff;
  background: var(--primary);
  font-size: 22rpx;
  font-weight: 650;
}

.task-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.task-card {
  min-height: 116rpx;
  padding: 20rpx 16rpx 20rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 17rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--surface);
  box-sizing: border-box;
  transition: background 220ms ease, border-color 220ms ease;
}

.task-card.done {
  border-color: rgba(78, 140, 106, 0.18);
  background: rgba(78, 140, 106, 0.06);
}

.check-button {
  width: 46rpx;
  height: 46rpx;
  min-height: 46rpx;
  flex: none;
  margin: 0;
  padding: 0;
  border: 3rpx solid var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.check-button.checked {
  border-color: var(--success);
  background: var(--success);
}

.check-core {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0;
}

.check-button.checked .check-core {
  opacity: 1;
}

.task-main {
  min-width: 0;
  flex: 1;
}

.task-title {
  overflow: hidden;
  max-height: 72rpx;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 650;
  text-overflow: ellipsis;
}

.done .task-title {
  color: var(--muted);
  text-decoration: line-through;
}

.task-meta {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.task-due {
  color: var(--accent);
}

.delete-button {
  width: 78rpx;
  min-height: 56rpx;
  flex: none;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  color: var(--muted);
  background: transparent;
  font-size: 20rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(7, 20, 36, 0.48);
}

.sheet {
  width: 100%;
  padding: 20rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--surface);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: var(--line);
}

.sheet-title {
  font-size: 38rpx;
  font-weight: 750;
}

.sheet-copy {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.input-label {
  margin: 25rpx 0 10rpx;
  font-size: 22rpx;
  font-weight: 650;
}

.sheet-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 14rpx;
}

.sheet-actions .secondary-button {
  flex: 0.7;
}

.sheet-actions .primary-button {
  flex: 1.3;
}

.task-hero {
  min-height: 164rpx;
  box-sizing: border-box;
}

.hero-priority {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: var(--text);
  font-size: 19rpx;
  font-weight: 600;
}

.priority-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: var(--accent);
}

.task-toolbar {
  min-width: 0;
  align-items: center;
}

.filter-scroll {
  min-width: 0;
  flex: 1;
  white-space: nowrap;
}

.filters {
  display: inline-flex;
  width: auto;
  white-space: nowrap;
}

.filter {
  flex: none;
  min-width: 106rpx;
  padding-right: 16rpx;
  padding-left: 16rpx;
}

.add-button {
  width: 148rpx;
  flex: none;
  padding-right: 0;
  padding-left: 0;
  white-space: nowrap;
}

.task-section-head {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-section-title {
  font-size: 29rpx;
  font-weight: 760;
}

.task-section-count {
  color: var(--muted);
  font-size: 20rpx;
}

.task-list {
  margin-top: 14rpx;
}

.task-card {
  min-height: 126rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  border-radius: 26rpx;
}

.task-title {
  font-size: 26rpx;
  line-height: 1.4;
}

.task-meta {
  overflow: hidden;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delete-button {
  width: 66rpx;
  color: var(--muted);
  font-size: 19rpx;
}

/* 微信 WebView 对 button 作为 flex 子项存在默认尺寸，勾选控件使用 view 并锁死几何尺寸。 */
.task-card {
  width: 100%;
  overflow: hidden;
}

.check-button {
  display: flex;
  width: 48rpx !important;
  height: 48rpx !important;
  min-width: 48rpx;
  max-width: 48rpx;
  min-height: 48rpx;
  max-height: 48rpx;
  flex: 0 0 48rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.task-main {
  width: 0;
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
}

.task-title {
  display: block;
  width: 100%;
}

.delete-button {
  width: 66rpx !important;
  min-width: 66rpx;
  max-width: 66rpx;
  flex: 0 0 66rpx;
  flex-shrink: 0;
}

@media (max-width: 350px) {
  .task-toolbar {
    gap: 10rpx;
  }

  .add-button {
    width: 132rpx;
    font-size: 20rpx;
  }

  .filter {
    min-width: 94rpx;
  }
}
