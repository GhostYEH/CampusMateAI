.task-hero {
  min-height: 166rpx;
  padding: 26rpx 24rpx 24rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  border: 1rpx solid #d7e6ee;
  border-left: 6rpx solid var(--primary);
  border-radius: 16rpx;
  background: var(--primary-ghost);
  box-sizing: border-box;
}

.hero-label {
  color: var(--muted);
  font-size: 19rpx;
}

.hero-value {
  margin-top: 8rpx;
  color: var(--text);
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 740;
}

.hero-copy {
  max-width: 390rpx;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.hero-priority {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--text);
  font-size: 18rpx;
  font-weight: 600;
}

.priority-dot {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 50%;
  background: var(--accent);
}

.progress-badge {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  box-sizing: border-box;
}

.progress-value {
  color: var(--primary);
  font-size: 29rpx;
  font-weight: 740;
}

.progress-caption {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.task-toolbar {
  min-width: 0;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-scroll {
  min-width: 0;
  flex: 1;
  white-space: nowrap;
}

.filters {
  display: inline-flex;
  gap: 8rpx;
  white-space: nowrap;
}

.filter {
  flex: none;
  min-width: 96rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 17rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  color: var(--muted);
  background: var(--surface);
  font-size: 20rpx;
  line-height: 58rpx;
}

.filter.selected {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-soft);
  font-weight: 680;
}

.add-button {
  width: 142rpx;
  min-height: 62rpx;
  flex: none;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  color: #ffffff;
  background: #2f6486;
  font-size: 20rpx;
  font-weight: 680;
  white-space: nowrap;
}

.task-section-head {
  margin-top: 25rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-section-title {
  color: var(--text);
  font-size: 29rpx;
  font-weight: 730;
}

.task-section-count {
  color: var(--muted);
  font-size: 19rpx;
}

.task-list {
  margin-top: 13rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.task-card {
  width: 100%;
  min-height: 112rpx;
  padding: 16rpx 15rpx 16rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  border-top: 1rpx solid var(--line);
  background: var(--surface);
  box-sizing: border-box;
  transition: background 180ms ease;
}

.task-card:first-child {
  border-top: 0;
}

.task-card.done {
  background: var(--success-soft);
}

.check-button {
  width: 46rpx !important;
  height: 46rpx !important;
  min-width: 46rpx;
  max-width: 46rpx;
  min-height: 46rpx;
  max-height: 46rpx;
  flex: 0 0 46rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--primary);
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.check-button.checked {
  border-color: var(--success);
  background: var(--success);
}

.check-core {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
  opacity: 0;
}

.check-button.checked .check-core {
  opacity: 1;
}

.task-main {
  width: 0;
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
}

.task-title {
  display: block;
  width: 100%;
  overflow: hidden;
  color: var(--text);
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.done .task-title {
  color: var(--muted);
  text-decoration: line-through;
}

.task-meta {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-due {
  color: var(--accent);
  font-weight: 660;
}

.delete-button {
  width: 62rpx !important;
  min-width: 62rpx;
  max-width: 62rpx;
  min-height: 54rpx;
  flex: 0 0 62rpx;
  margin: 0;
  padding: 0;
  border-radius: 9rpx;
  color: var(--muted);
  background: transparent;
  font-size: 18rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(7, 20, 36, 0.46);
}

.sheet {
  width: 100%;
  padding: 18rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--surface);
}

.sheet-handle {
  width: 68rpx;
  height: 7rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: var(--line);
}

.sheet-title {
  color: var(--text);
  font-size: 34rpx;
  font-weight: 730;
}

.sheet-copy {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.input-label {
  margin: 22rpx 0 9rpx;
  color: var(--text);
  font-size: 21rpx;
  font-weight: 650;
}

.sheet-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}

.sheet-actions .secondary-button {
  flex: 0.72;
}

.sheet-actions .primary-button {
  flex: 1.28;
}

@media (max-width: 350px) {
  .task-toolbar {
    gap: 8rpx;
  }

  .add-button {
    width: 128rpx;
    font-size: 19rpx;
  }

  .filter {
    min-width: 88rpx;
    padding-right: 13rpx;
    padding-left: 13rpx;
  }
}
