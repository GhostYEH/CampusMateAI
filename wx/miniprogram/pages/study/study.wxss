.timer-panel {
  padding: 30rpx;
  border-radius: 36rpx;
  color: #fff;
  background: var(--primary);
  text-align: center;
}

.duration-row {
  padding: 6rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
}

.duration {
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 15rpx;
  color: rgba(255, 255, 255, 0.68);
  background: transparent;
  font-size: 20rpx;
}

.duration.selected {
  color: var(--primary);
  background: #fff;
  font-weight: 650;
}

.timer-label {
  margin-top: 32rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
}

.timer-value {
  margin-top: 7rpx;
  font-size: 96rpx;
  line-height: 1.15;
  font-weight: 690;
  letter-spacing: 3rpx;
}

.timer-progress {
  height: 9rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.timer-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #fff;
  transition: width 280ms linear;
}

.timer-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  gap: 12rpx;
}

.reset-button,
.start-button {
  min-height: 76rpx;
}

.reset-button {
  color: #fff;
  background: rgba(255, 255, 255, 0.13);
}

.start-button {
  color: var(--primary);
  background: #fff;
}

.expression-panel,
.week-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 700;
}

.panel-subtitle {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.mock-label {
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.expression-result {
  margin-top: 24rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 24rpx;
  background: var(--background);
}

.expression-pulse {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  border: 7rpx solid var(--line);
  border-radius: 50%;
}

.expression-pulse.active {
  border-color: rgba(78, 140, 106, 0.25);
  background: var(--success);
  animation: signal 1.6s ease-out infinite;
}

.reduce-motion .expression-pulse.active {
  animation: none;
}

.expression-text {
  font-size: 23rpx;
  font-weight: 650;
}

.expression-confidence {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.science-note {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.55;
}

.feeling-panel {
  margin-top: 22rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}

.feeling-row {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 11rpx;
}

.feeling {
  height: 70rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  color: var(--muted);
  background: var(--surface);
  font-size: 21rpx;
}

.feeling.selected {
  border-color: rgba(47, 100, 134, 0.25);
  color: var(--primary);
  background: var(--primary-soft);
  font-weight: 650;
}

.week-change {
  color: var(--success);
  font-size: 20rpx;
}

.bar-chart {
  height: 220rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.bar-item {
  width: 54rpx;
  text-align: center;
}

.bar-track {
  height: 170rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--primary-soft);
}

.bar-fill {
  width: 100%;
  border-radius: 16rpx;
  background: var(--primary);
}

.bar-label {
  margin-top: 9rpx;
  color: var(--muted);
  font-size: 18rpx;
}

@keyframes signal {
  0% {
    box-shadow: 0 0 0 0 rgba(78, 140, 106, 0.26);
  }
  100% {
    box-shadow: 0 0 0 18rpx rgba(78, 140, 106, 0);
  }
}
