.timer-panel {
  padding: 24rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: #2f6486;
}

.duration-row {
  padding: 5rpx;
  display: flex;
  gap: 4rpx;
  border-radius: 11rpx;
  background: rgba(255, 255, 255, 0.12);
}

.duration {
  flex: 1;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  background: transparent;
  font-size: 19rpx;
}

.duration.selected {
  color: #214d69;
  background: #ffffff;
  font-weight: 680;
}

.timer-label {
  margin-top: 29rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
}

.timer-value {
  margin-top: 4rpx;
  font-size: 78rpx;
  line-height: 1.15;
  font-weight: 680;
  letter-spacing: 2rpx;
}

.timer-progress {
  height: 8rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.timer-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
  transition: width 280ms linear;
}

.timer-actions {
  margin-top: 23rpx;
  display: flex;
  gap: 10rpx;
}

.reset-button,
.start-button {
  min-height: 70rpx;
}

.reset-button {
  flex: 0.7;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

.start-button {
  flex: 1.3;
  color: #214d69;
  background: #ffffff;
}

.expression-panel,
.week-panel {
  margin-top: 16rpx;
  padding: 22rpx;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.panel-title {
  color: var(--text);
  font-size: 25rpx;
  font-weight: 700;
}

.panel-subtitle {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.5;
}

.mock-label {
  padding: 6rpx 9rpx;
  border: 1rpx solid var(--line);
  border-radius: 7rpx;
  color: var(--primary);
  background: var(--primary-soft);
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.expression-result {
  margin-top: 20rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--surface-subtle);
}

.expression-pulse {
  width: 30rpx;
  height: 30rpx;
  flex: none;
  border: 6rpx solid var(--line);
  border-radius: 50%;
}

.expression-pulse.active {
  border-color: rgba(78, 140, 106, 0.25);
  background: var(--success);
  animation: signal 1.6s ease-out infinite;
}

.reduce-motion .expression-pulse.active {
  animation: none;
}

.expression-text {
  color: var(--text);
  font-size: 21rpx;
  font-weight: 650;
}

.expression-confidence {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.science-note {
  margin-top: 13rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.55;
}

.feeling-panel {
  margin-top: 20rpx;
  padding: 0 0 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.feeling-row {
  margin-top: 15rpx;
  display: flex;
  gap: 9rpx;
}

.feeling {
  flex: 1;
  height: 62rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  color: var(--muted);
  background: var(--surface);
  font-size: 19rpx;
  white-space: nowrap;
}

.feeling.selected {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-soft);
  font-weight: 650;
}

.week-change {
  color: var(--success);
  font-size: 18rpx;
}

.bar-chart {
  height: 194rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.bar-item {
  width: 42rpx;
  text-align: center;
}

.bar-track {
  height: 148rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  border-radius: 9rpx;
  background: var(--primary-soft);
}

.bar-fill {
  width: 100%;
  border-radius: 9rpx;
  background: var(--primary);
}

.bar-label {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 17rpx;
}

@keyframes signal {
  0% { box-shadow: 0 0 0 0 rgba(78, 140, 106, 0.26); }
  100% { box-shadow: 0 0 0 18rpx rgba(78, 140, 106, 0); }
}
