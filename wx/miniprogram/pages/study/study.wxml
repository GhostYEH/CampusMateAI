<view class="campus-page focus-page {{darkMode ? 'dark' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}">
  <secondary-nav title="专注自习"></secondary-nav>
  <view class="campus-page-body focus-body">
    <view class="focus-timer-card campus-enter">
      <view class="focus-mode-tabs">
        <button
          wx:for="{{modes}}"
          wx:key="minutes"
          class="focus-mode {{targetMinutes === item.minutes ? 'focus-mode--active' : ''}}"
          data-minutes="{{item.minutes}}"
          bindtap="chooseDuration"
        >
          <image src="{{item.icon}}" mode="aspectFit"></image>
          <text>{{item.label}}</text>
        </button>
      </view>

      <view class="focus-ring" style="background: conic-gradient(#5B68F2 {{progress}}%, #E2E7EC 0);">
        <view class="focus-ring__inner">
          <view class="focus-time">{{displayTime}}</view>
          <view class="focus-status">{{statusText}}</view>
        </view>
      </view>

      <view class="focus-actions">
        <button wx:if="{{status !== 'idle'}}" class="focus-reset" bindtap="reset">重置</button>
        <button class="focus-primary" bindtap="toggleTimer">
          <image src="/assets/icons/focus-play.svg" mode="aspectFit"></image>
          <text>{{primaryAction}}</text>
        </button>
      </view>
    </view>

    <view class="assist-card campus-enter">
      <view class="assist-head">
        <view class="assist-icon"><image src="/assets/icons/focus-robot.svg" mode="aspectFit"></image></view>
        <view class="assist-title-wrap">
          <view class="assist-title">学习状态辅助</view>
          <view class="assist-subtitle">画面仅在本机处理，不保存，不上传</view>
        </view>
        <switch checked="{{assistanceEnabled}}" disabled="{{!assistanceAvailable}}" color="#5B68F2" bindchange="onAssistanceChange"></switch>
      </view>
      <view class="assist-state">
        <view><image src="/assets/icons/focus-cpu.svg"></image><text>本机 ONNX：状态由设备能力决定</text></view>
        <view><image src="/assets/icons/focus-eye.svg"></image><text>当前辅助观察：暂不可用</text></view>
        <view><image src="/assets/icons/focus-motion.svg"></image><text>动作识别准备中</text></view>
        <view><image src="/assets/icons/focus-smile.svg"></image><text>稳定表情：仅作本地提示</text></view>
        <view><image src="/assets/icons/focus-clock.svg"></image><text>本次专注时长：{{currentMinutes}} 分钟</text></view>
      </view>
    </view>

    <view class="feeling-card campus-enter">
      <view class="section-title">此刻学习感受</view>
      <view class="section-subtitle">主动记录比表情识别更重要</view>
      <view class="feeling-row">
        <button wx:for="{{feelings}}" wx:key="*this" class="feeling {{feeling === item ? 'selected' : ''}}" data-feeling="{{item}}" bindtap="chooseFeeling">{{item}}</button>
      </view>
    </view>

    <view class="goal-card campus-enter" bindtap="editGoal">
      <view class="goal-copy">
        <view class="section-title">今日自习目标</view>
        <view class="goal-value">{{todayMinutes}} / {{goalMinutes}} 分钟</view>
        <view class="goal-track"><view style="width: {{goalProgress}}%;"></view></view>
        <view class="goal-action">点击调整目标</view>
      </view>
      <image class="goal-art" src="/assets/secondary/focus-goal.png" mode="aspectFit"></image>
    </view>

    <view class="summary-grid campus-enter">
      <view><text>{{todayMinutes}}</text><label>今日分钟</label></view>
      <view><text>{{recordCount}}</text><label>专注次数</label></view>
      <view><text>{{streakDays}}</text><label>连续天数</label></view>
    </view>

    <view wx:if="{{recentLogs.length}}" class="recent-card campus-enter">
      <view class="section-title">最近专注</view>
      <view wx:for="{{recentLogs}}" wx:key="id" class="recent-row">
        <text>{{item.dateLabel}}</text><text>{{item.durationLabel}}</text>
      </view>
    </view>
  </view>
  <custom-tab-bar></custom-tab-bar>
</view>
