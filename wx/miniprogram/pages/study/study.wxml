<view class="page {{darkMode ? 'dark' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}">
  <campus-header
    title="学习陪伴"
    subtitle="用一段专注时间完成今天的任务"
    mode="{{mockMode ? 'Mock 识别' : '本地识别'}}"
    back
  />

  <view class="page-body">
    <view class="timer-panel enter">
      <view class="duration-row">
        <button class="duration {{targetMinutes === 15 ? 'selected' : ''}}" data-minutes="15" bindtap="chooseDuration">15 分钟</button>
        <button class="duration {{targetMinutes === 25 ? 'selected' : ''}}" data-minutes="25" bindtap="chooseDuration">25 分钟</button>
        <button class="duration {{targetMinutes === 45 ? 'selected' : ''}}" data-minutes="45" bindtap="chooseDuration">45 分钟</button>
      </view>
      <view class="timer-label">本次专注</view>
      <view class="timer-value">{{displayTime}}</view>
      <view class="timer-progress">
        <view class="timer-progress-fill" style="width: {{progress}}%;"></view>
      </view>
      <view class="timer-actions">
        <button class="secondary-button reset-button" bindtap="reset">重置</button>
        <button class="primary-button start-button" bindtap="toggleTimer">
          {{status === 'running' ? '暂停一下' : status === 'paused' ? '继续专注' : status === 'finishError' ? '重试同步' : status === 'finished' ? '再来一次' : '开始专注'}}
        </button>
      </view>
    </view>

    <view class="expression-panel surface enter enter-delay-1">
      <view class="panel-head">
        <view>
          <view class="panel-title">表情识别辅助</view>
          <view class="panel-subtitle">仅观察可见面部表情，不进行心理诊断</view>
        </view>
        <view class="mock-label">{{mockMode ? 'MOCK' : 'LOCAL'}}</view>
      </view>
      <view class="expression-result">
        <view class="expression-pulse {{status === 'running' ? 'active' : ''}}"></view>
        <view>
          <view class="expression-text">{{expression}}</view>
          <view wx:if="{{expressionConfidence}}" class="expression-confidence">{{expressionConfidence}}</view>
        </view>
      </view>
      <view class="science-note">低置信度时只显示“暂时无法稳定判断当前表情”，不会触发情绪安慰。</view>
    </view>

    <view class="feeling-panel enter enter-delay-2">
      <view class="panel-title">此刻学习感受</view>
      <view class="panel-subtitle">主动记录比单一表情结果更重要</view>
      <view class="feeling-row">
        <button
          wx:for="{{feelings}}"
          wx:key="*this"
          class="feeling {{feeling === item ? 'selected' : ''}}"
          data-feeling="{{item}}"
          bindtap="chooseFeeling"
        >{{item}}</button>
      </view>
    </view>

    <view class="week-panel surface enter enter-delay-3">
      <view class="panel-head">
        <view>
          <view class="panel-title">本周学习记录</view>
          <view class="panel-subtitle">累计 6 小时 25 分钟</view>
        </view>
        <view class="week-change">较上周 +12%</view>
      </view>
      <view class="bar-chart">
        <view wx:for="{{weekBars}}" wx:key="label" class="bar-item">
          <view class="bar-track">
            <view class="bar-fill" style="height: {{item.value}}%;"></view>
          </view>
          <view class="bar-label">{{item.label}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
