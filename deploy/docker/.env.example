# ====================================================
# CampusMate AI —— Docker 编排环境变量模板
# 用法：复制为同目录下的 .env 再按需填写：
#   cp deploy/docker/.env.example deploy/docker/.env
# 真实密钥只写进 .env（已被 .gitignore 忽略），禁止提交。
# ====================================================

# ===== 必填 =====
# backend 与 magicclass-service 共享的断言密钥。至少 32 位随机串。
# 生成：openssl rand -hex 32
MAGICCLASS_INTERNAL_SECRET=replace-with-a-random-secret-at-least-32-characters

# ===== 端口映射（改左边，改右边会破坏容器内约定）=====
WEB_PORT=5174
BACKEND_PORT=8000
MAGICCLASS_APP_PORT=3000

# ===== 应用环境 =====
# development 允许演示账号 seeding；production 会触发更严格的安全校验。
APP_ENV=development
AUTO_SEED_DEMO_USERS=true

# ===== CORS（浏览器直接打后端时用；经 Nginx 同源代理时通常无需改）=====
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ===== 浏览器可见的「学习空间」公开地址 =====
# 必须等于用户浏览器实际访问 magicclass-app 的地址。
MAGICCLASS_EMBED_ORIGIN=http://localhost:3000
# 允许内嵌课堂的父页面 Origin（构建期变量，改动后需重新 build）。
ALLOWED_FRAME_ANCESTORS=http://localhost:5174 http://127.0.0.1:5174

# ===== 后端密钥（也可继续放在 backend/.env 里，二者皆可）=====
# LLM Provider：none | openai_compatible
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 火山 RTC / Seeduplex、MiMo TTS、UAPI 等按需补充：
# VOLC_RTC_APP_ID=
# VOLC_RTC_APP_KEY=
# VOLC_ACCESS_KEY_ID=
# VOLC_SECRET_ACCESS_KEY=
# MIMO_API_KEY=
# UAPI_API_KEY=

# ===== 上游 magic class 应用（「学习空间」）=====
# 服务端默认模型，如 openai:gpt-5.5 / deepseek:deepseek-v4-pro。
MAGICCLASS_APP_DEFAULT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
XIAOMI_API_KEY=
XIAOMI_BASE_URL=
TTS_MIMO_API_KEY=
TTS_MIMO_BASE_URL=

# ===== 自研受管服务的可选 Provider =====
MAGICCLASS_PROVIDER_BASE_URL=
MAGICCLASS_PROVIDER_API_KEY=
MAGICCLASS_PROVIDER_MODEL=
MAGICCLASS_TTS_BASE_URL=
MAGICCLASS_TTS_API_KEY=

# ===== 构建期网络（只影响 docker build，不影响运行）=====
# 国内网络建议用镜像源加速：
# NPM_REGISTRY=https://registry.npmmirror.com
NPM_REGISTRY=
# 宿主机有代理时，容器内经 host.docker.internal 访问宿主机代理。
# 注意：Windows 下 host.docker.internal 由 Docker Desktop 解析；
# 代理软件需允许"来自局域网的连接"，否则容器连不上。
# 本机实测代理为 127.0.0.1:7897（Clash 系），示例：
# BUILD_HTTP_PROXY=http://host.docker.internal:7897
# BUILD_HTTPS_PROXY=http://host.docker.internal:7897
# BUILD_NO_PROXY=localhost,127.0.0.1
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=

