# ====================================================
# CampusMate AI —— Docker 编排环境变量模板
# 用法：复制为同目录下的 .env 再按需填写：
#   cp deploy/docker/.env.example deploy/docker/.env
# 真实密钥只写进 .env（已被 .gitignore 忽略），禁止提交。
# ====================================================

# ===== 必填 =====
# backend 与 magicclass-service 共享的断言密钥。至少 32 位随机串。
# 生成：openssl rand -hex 32
MAGICCLASS_INTERNAL_SECRET=replace-with-a-random-secret-at-least-32-characters

# ===== 端口映射（改左边，改右边会破坏容器内约定）=====
WEB_PORT=5174
BACKEND_PORT=8000
MAGICCLASS_APP_PORT=3000

# ===== 应用环境 =====
# development 允许演示账号 seeding；production 会触发更严格的安全校验。
APP_ENV=development
AUTO_SEED_DEMO_USERS=true

# ===== CORS（浏览器直接打后端时用；经 Nginx 同源代理时通常无需改）=====
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ===== 可信反向代理地址（uvicorn）=====
# 后端经 Nginx 容器代理时，只有来自可信代理的 X-Forwarded-For 才会被采信，
# 用于按真实客户端地址做限流（二维码创建、每日壁纸等）。
# 默认 172.28.0.2 就是本编排里 webreact(Nginx) 的固定容器地址（见
# docker-compose.yml 的固定子网与 ipv4_address），因此只信任真正的代理，
# 宿主直连 backend 端口无法靠伪造转发头绕过限流。
# 改了 webreact 的 ipv4_address 或子网时，这里要同步。
# 禁止设为 *（会无条件信任任何来源伪造的 XFF，导致限流可被绕过）。
FORWARDED_ALLOW_IPS=172.28.0.2

# ===== 浏览器可见的「学习空间」公开地址 =====
# 必须等于用户浏览器实际访问 magicclass-app 的地址。
MAGICCLASS_EMBED_ORIGIN=http://localhost:3000
# 允许内嵌课堂的父页面 Origin（构建期变量，改动后需重新 build）。
ALLOWED_FRAME_ANCESTORS=http://localhost:5174 http://127.0.0.1:5174

# ===== 可选：课堂 MP4 导出（video-export profile）=====
# 默认四服务部署不启动渲染服务；要启用：
#   1) 设 NEXT_PUBLIC_ENABLE_VIDEO_EXPORT=true（构建期，改后需 --build 重新构建 magicclass-app）；
#   2) 用 profile 启动：docker compose -f deploy/docker/docker-compose.yml --profile video-export up --build。
# 说明：
# - 渲染服务在容器网络内以 http://render-service:9000 暴露（compose 已固定，
#   无需在此配置）；magicclass-app 的能力接口会探测其 /health，未启动时自动降级为仅下载 ZIP。
# - 渲染镜像较重（含 Chromium + FFmpeg），默认 RENDER_RESOURCE_PROFILE=standard 需要 8 GiB 内存；
#   内存受限可设 RENDER_RESOURCE_PROFILE=low-memory 与 RENDER_SERVICE_MEMORY_LIMIT=4g。
# - 渲染服务需要 NET_ADMIN 安装出网封锁（compose 已配置），请勿改为 privileged 或关闭封锁。
NEXT_PUBLIC_ENABLE_VIDEO_EXPORT=
RENDER_RESOURCE_PROFILE=standard
RENDER_SERVICE_MEMORY_LIMIT=8g

# ===== 后端密钥（也可继续放在 backend/.env 里，二者皆可）=====
# backend 服务同时加载两个 env 文件，后者覆盖前者：
#   1) backend/.env        （既有用法；不存在则跳过）
#   2) 本文件 deploy/docker/.env（本目录；不存在则跳过）
# 覆盖规则（重要）：只要某个键在本文件里出现（哪怕是空的 `KEY=`），它就会
# **覆盖** backend/.env 里的同名值。因此：
#   - 不想覆盖 backend/.env 的键：保持**注释状态**（`# KEY=...`）或整行删除，
#     不要写成 `KEY=` —— 空值也会覆盖。
#   - 想覆盖：取消注释并填真实值。
# 下面的后端密钥默认全部注释，避免直接 `cp .env.example .env` 后把
# backend/.env 里已有的有效配置覆盖成空值。
# 真实密钥只写进本目录的 .env（已被 .gitignore 忽略），禁止提交。
#
# LLM Provider：none | openai_compatible
# 提示：若 LLM 跑在宿主机（如本地 vLLM/Ollama），容器内请用
#   LLM_BASE_URL=http://host.docker.internal:<port>/v1
# Windows/macOS 由 Docker Desktop 解析 host.docker.internal。
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# 火山 RTC / Seeduplex、MiMo TTS、UAPI 等按需填写（同样遵循上面的覆盖规则）：
# VOLC_RTC_APP_ID=
# VOLC_RTC_APP_KEY=
# VOLC_ACCESS_KEY_ID=
# VOLC_SECRET_ACCESS_KEY=
# VOLC_SEEDUPLEX_API_KEY=
# MIMO_API_KEY=
# UAPI_API_KEY=

# ===== 上游 magic class 应用（「学习空间」）=====
# 下面的键由 magicclass-app 的 environment: 以 ${X:-} 注入，留空即为“未设置”，
# 不会覆盖 backend/.env，属有意保持为空的默认值。
# 服务端默认模型，如 openai:gpt-5.5 / deepseek:deepseek-v4-pro。
MAGICCLASS_APP_DEFAULT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
XIAOMI_API_KEY=
XIAOMI_BASE_URL=
TTS_MIMO_API_KEY=
TTS_MIMO_BASE_URL=

# ===== 自研受管服务的可选 Provider =====
MAGICCLASS_PROVIDER_BASE_URL=
MAGICCLASS_PROVIDER_API_KEY=
MAGICCLASS_PROVIDER_MODEL=
MAGICCLASS_TTS_BASE_URL=
MAGICCLASS_TTS_API_KEY=

# ===== 构建期网络（只影响 docker build，不影响运行）=====
# 国内网络建议用镜像源加速：
# NPM_REGISTRY=https://registry.npmmirror.com
NPM_REGISTRY=
# 宿主机有代理时，容器内经 host.docker.internal 访问宿主机代理。
# 注意：Windows 下 host.docker.internal 由 Docker Desktop 解析；
# 代理软件需允许"来自局域网的连接"，否则容器连不上。
# 本机实测代理为 127.0.0.1:7897（Clash 系），示例：
# BUILD_HTTP_PROXY=http://host.docker.internal:7897
# BUILD_HTTPS_PROXY=http://host.docker.internal:7897
# BUILD_NO_PROXY=localhost,127.0.0.1
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=

