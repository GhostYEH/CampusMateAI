# OpenMAIC 部署环境模板（脱敏）
#
# 用法：
#   cp .env.openmaic.example .env.local     # 在 OpenMAIC 源码目录内
#   填入真实 Provider Key 与域名后，docker compose up -d --build
#
# 本文件只包含占位值，禁止提交任何真实密钥、Token、Cookie、域名或本机路径。
# 完整说明见 CampusMateAI 的 docs/openmaic-deployment.md

# ===== 访问控制 =====
# 方案 A（推荐）：留空，由网络层（反代/VPN/forward-auth）保护课堂子域。
# 启用后 openmaic_access cookie 为 HttpOnly+SameSite=Lax，跨站 iframe 不携带，
# 学生浏览器将无法内嵌课堂。
ACCESS_CODE=

# ===== iframe 放行（构建期变量，改动后必须重新 build）=====
# 值示例：https://campus.example.com
ALLOWED_FRAME_ANCESTORS=

# ===== 反代 =====
# 有可信反向代理时置 true，让客户端标识与 pollUrl 使用真实 host/proto
TRUST_PROXY_HEADERS=true

# ===== LLM（至少配置一个 Provider + DEFAULT_MODEL）=====
DEFAULT_MODEL=
# 示例：OPENAI_API_KEY= / DEEPSEEK_API_KEY= / QWEN_API_KEY= / ANTHROPIC_API_KEY=
# 可选：<PROVIDER>_BASE_URL= / <PROVIDER>_MODELS=

# ===== 可选能力：图像 =====
# 示例：IMAGE_OPENAI_API_KEY=
# 关闭某 Provider：IMAGE_<PREFIX>_ENABLED=false

# ===== 可选能力：语音合成 TTS =====
# 示例：TTS_OPENAI_API_KEY=
# 关闭某 Provider：TTS_<PREFIX>_ENABLED=false

# ===== 可选能力：语音识别 ASR =====
# 示例：ASR_OPENAI_API_KEY=
# 本地音视频抽取还需要系统 ffmpeg 与 ffprobe 在 PATH 上

# ===== 可选能力：联网检索 =====
# 示例：TAVILY_API_KEY= / EXA_API_KEY= / BOCHA_API_KEY= / SEARXNG_BASE_URL=

# ===== 持久化（本接入不使用；仅在需要 /api/stages 列表能力时配置）=====
# DATABASE_URL=postgres://openmaic:CHANGE_ME@postgres:5432/openmaic
# OPENMAIC_AGENT_RUNTIME_ENABLED=false

# ===== MP4 导出（本轮不接入，保留供将来启用）=====
# docker compose 已固定 RENDER_SERVICE_URL=http://render-service:9000
