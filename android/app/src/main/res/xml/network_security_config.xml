<?xml version="1.0" encoding="utf-8"?>
<!-- 网络安全配置 — 仅允许调试与本地后端使用明文 HTTP。
     生产环境若启用 HTTPS,可删除本文件与 Manifest 中的引用。

     背景:Android 9 (API 28) 起默认禁止明文 HTTP 流量。
     本项目后端为本地 FastAPI(http://),需要显式放行:
     - 10.0.2.2:Android 模拟器访问宿主机的特殊地址
     - 10.0.3.2:Genymotion 模拟器访问宿主机的特殊地址
     - localhost / 127.0.0.1:Web 端与本机调试 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
