# ====================================================
# CampusMate AI Backend - 环境变量示例
# 复制为 .env 并按需修改。禁止把真实 API Key 提交到 Git。
# ====================================================

# ===== 应用基础 =====
# development / test / production
# production 下禁止启用 AUTO_IMPORT_DEMO / AUTO_SEED_DEMO_USERS(详见 README 正式 Release 强约束)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# 应用版本号(仅用于健康检查展示)
APP_VERSION=0.2.0

# ===== 鉴权 =====
# 生产环境必须设置为至少 32 个字符的随机值，不能使用开发默认值。
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== 数据存储 =====
# SQLite 文件路径(相对 backend/ 根目录)。生产环境可换 PostgreSQL(预留迁移空间)。
DATABASE_URL=sqlite:///./data/app.db

# ===== 教务会话存储 =====
# auto: production 使用 encrypted_sqlite，其他环境使用 memory。
EDU_SESSION_STORE=auto
# AES-256 key：必须是恰好 32 bytes 的标准 Base64；示例文件保持为空。
EDU_SESSION_ENCRYPTION_KEY=
# 非敏感 key 标识，用于 envelope 版本识别与轮换。
EDU_SESSION_ENCRYPTION_KEY_ID=primary

# ===== 知识库 =====
# 知识库根目录(存放 demo/ 与上传文件)
KNOWLEDGE_BASE_PATH=./data/knowledge_base
EXPRESSION_CONTRIBUTION_PATH=./data/expression_contributions
MAX_EXPRESSION_CONTRIBUTION_MB=3
# 单个上传文件最大体积(MB)
MAX_UPLOAD_MB=10
# 允许上传的扩展名(逗号分隔,小写,不含点)
ALLOWED_EXTENSIONS=md,txt,pdf,docx
# 启动时是否自动导入 data/knowledge_base/demo 下的测试环境资料
# 默认关闭;仅 dev/test 显式开启;production 下设为 true 会抛 ValidationError
AUTO_IMPORT_DEMO=false

# ===== 多角色验收账号 seeding(dev/test) =====
# 启动时是否 seed 多角色验收账号(teacher_demo / student_demo / admin_demo 等)
# 默认关闭;仅 dev/test 显式开启;production 下设为 true 会抛 ValidationError
# 验收账号为普通用户,走完整真实业务流程,无特殊权限
AUTO_SEED_DEMO_USERS=false

# ===== LLM Provider =====
# none | openai_compatible
# - none: 不使用 LLM,所有抽取/问答走规则+检索摘要模式
# - openai_compatible: 兼容 OpenAI Chat Completions 协议
#   支持 OpenAI / DeepSeek / 通义 / Kimi / 讯飞星火 / 本地 vLLM 等
#
# DeepSeek 示例(支持模型: deepseek-v4-pro / deepseek-v4-flash):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-your_deepseek_api_key
#   LLM_MODEL=deepseek-v4-flash
#
# 讯飞星火 Lite 示例(APIPassword 格式为 APIKey:APISecret,整体作为 Bearer Token):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://spark-api-open.xf-yun.com/v1
#   LLM_API_KEY=your_api_key:your_api_secret
#   LLM_MODEL=lite
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 单次调用超时(秒)
LLM_TIMEOUT_SECONDS=30
# LLM 不可用时是否启用降级模式(检索摘要)
ENABLE_FALLBACK_MODE=true

# ===== MiMo TTS =====
# 真实密钥仅写入本机 .env，禁止提交到 Git。
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖
MIMO_TTS_TIMEOUT_SECONDS=60
MIMO_TTS_MAX_CHARS=4000
MIMO_TTS_SAMPLE_RATE=24000

# ===== Focus Realtime Voice / Volcengine RTC =====
# 仅后端读取。不要把 AppKey、AK、SK 或 VoiceChat 配置写入 Android、local.properties 或 Git。
# VOLC_RTC_APP_ID 可安全返回给 Android；其余变量均为 Secret。
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
# 从 RTC VoiceChat 控制台导出的 Config JSON。后端会注入 AppId、RoomId、TaskId、TargetUserId 与 Focus Prompt。
VOLC_RTC_VOICECHAT_CONFIG_JSON=
# Android Token 有效期（秒）；服务端仍是唯一签发方。
VOLC_RTC_TOKEN_TTL_SECONDS=1800
VOLC_RTC_AGENT_USER_ID=campusmate_focus_ai

# ===== Focus Realtime Voice / Seeduplex 3.0 =====
# 来自豆包语音控制台 API Key 管理；严禁进入 Android、APK 或 Git。
VOLC_SEEDUPLEX_API_KEY=
VOLC_SEEDUPLEX_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue

# ===== CORS =====
# 逗号分隔。* 表示允许任意源(仅开发环境)。
# 生产建议: http://localhost:*,http://127.0.0.1:*
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_REQUESTS=true
