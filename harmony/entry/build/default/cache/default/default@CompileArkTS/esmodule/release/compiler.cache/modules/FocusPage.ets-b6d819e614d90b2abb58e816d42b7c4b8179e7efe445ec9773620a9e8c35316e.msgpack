          }
        }.layoutWeight(1).height(48).backgroundColor(this.palette().primary).onClick(() => this.startClock())
        Button('ç»“æŸ').width(92).height(48).backgroundColor(this.palette().soft).fontColor(this.palette().primary)
          .onClick(() => { this.stopClock(); this.running = false; this.secondsLeft = this.totalSeconds(); this.onFinish(); })
      }.width('100%')
    }.width('100%').padding({ top: 20, left: 16, right: 16, bottom: 18 }).backgroundColor(this.palette().surface).borderRadius(22)
  }

  @Builder Record(item: StudySession) {
    Row({ space: 11 }) {
      Stack({ alignContent: Alignment.Center }) {
        SymbolGlyph($r('sys.symbol.stopwatch')).fontSize(19).fontColor([this.palette().primary])
      }.width(42).height(42).backgroundColor(this.palette().soft).borderRadius(13)
      Column({ space: 3 }) {
        Text(`${item.goal ?? 'ä¸“æ³¨å­¦ä¹ '} Â· ${item.started_at.substring(0, Math.min(10, item.started_at.length))}`).fontColor(this.palette().text).fontSize(12).fontWeight(FontWeight.Bold)
        Text(`${Math.max(1, Math.floor(item.duration_seconds / 60))} åˆ†é’Ÿ Â· ${item.status === 'completed' ? 'å·²å®Œæˆ' : 'è¿›è¡Œä¸­'}`).fontColor(this.palette().muted).fontSize(10)
      }.layoutWeight(1).alignItems(HorizontalAlign.Start)
    }.width('100%').padding({ top: 10, bottom: 10 })
  }

  build() {
    Column() {
      SecondaryHeader({ title: 'ä¸“æ³¨è‡ªä¹ ', subtitle: 'ä¸€æ¬¡åªåšä¸€ä»¶äº‹ï¼Œè®©æ³¨æ„åŠ›å›åˆ°å½“ä¸‹', darkMode: this.darkMode, onBack: () => this.onBack() })
      Scroll() {
        Column({ space: 13 }) {
          this.ModeTabs()
          this.TimerCard()
          Row({ space: 8 }) {
            SymbolGlyph($r('sys.symbol.shield_checkered')).fontSize(17).fontColor([this.palette().success])
            Column({ space: 2 }) {
              Text('å­¦ä¹ çŠ¶æ€è¾…åŠ©').fontColor(this.palette().text).fontSize(13).fontWeight(FontWeight.Bold)
              Text('é¸¿è’™ç«¯ä¸ä¸Šä¼ ç”»é¢ï¼Œä¸“æ³¨è®°å½•å·²çœŸå®åŒæ­¥åç«¯').fontColor(this.palette().muted).fontSize(10)
            }.layoutWeight(1).alignItems(HorizontalAlign.Start)
          }.width('100%').padding(13).backgroundColor(this.palette().surface).borderRadius(16)
          Text('ä¸“æ³¨è®°å½•').fontColor(this.palette().text).fontSize(16).fontWeight(FontWeight.Bold).width('100%')
          Column() {
            if (this.loading) { LoadingProgress().width(32).height(32).color(this.palette().primary).margin(28) }
            else if (this.sessions.length === 0) { Text('è¿˜æ²¡æœ‰ä¸“æ³¨è®°å½•').fontColor(this.palette().muted).fontSize(12).padding(28) }
            else {
              ForEach(this.sessions, (item: StudySession, index: number) => { this.Record(item); if (index < this.sessions.length - 1) { Divider().color(this.palette().line) } }, (item: StudySession) => item.id)
            }
          }.width('100%').padding({ left: 13, right: 13 }).backgroundColor(this.palette().surface).borderRadius(18)
          Blank().height(18)
        }.width('100%').padding({ left: 14, right: 14, bottom: 20 })
      }.layoutWeight(1).width('100%').scrollBar(BarState.Off)
    }.width('100%').height('100%').backgroundColor(this.palette().background)
  }
}
