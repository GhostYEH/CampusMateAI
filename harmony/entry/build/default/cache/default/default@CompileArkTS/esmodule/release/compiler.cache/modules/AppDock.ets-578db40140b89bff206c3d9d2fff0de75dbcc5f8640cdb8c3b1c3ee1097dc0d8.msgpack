//# sourceMappingURL=AppDock.js.mapÂ‘Ù0F:\demo1\harmony\entry\src\main\ets\ui\Theme.etsÙ2F:\demo1\harmony\entry\src\main\ets\ui\AppDock.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂ¶F:\demo1\harmony\entry°F:\demo1\harmony¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName­../ui/AppDock¥entry¶F:\demo1\harmony\entryÃÃÚ†import { CampusPalette, darkPalette, lightPalette } from './Theme';

interface DockItem {
  label: string;
  symbol: Resource;
  index: number;
}

@Component
export struct AppDock {
  @Prop activeTab: number = 0;
  @Prop darkMode: boolean = false;
  @Prop pendingCount: number = 0;
  onNavigate: (index: number) => void = () => {};

  palette(): CampusPalette {
    return this.darkMode ? darkPalette : lightPalette;
  }

  @Builder
  DockItemView(item: DockItem) {
    Column({ space: 2 }) {
      Stack({ alignContent: Alignment.Center }) {
        SymbolGlyph(item.symbol)
          .fontSize(21)
          .fontWeight(this.activeTab === item.index ? FontWeight.Bold : FontWeight.Medium)
          .fontColor([this.activeTab === item.index ? this.palette().primary : this.palette().muted])
        if (item.index === 2 && this.pendingCount > 0) {
          Text(this.pendingCount > 9 ? '9+' : this.pendingCount.toString())
            .fontColor('#FFFFFFFF')
            .fontSize(8)
            .fontWeight(FontWeight.Bold)
            .textAlign(TextAlign.Center)
            .width(16)
            .height(16)
            .backgroundColor('#FFED6E52')
            .borderRadius(8)
            .position({ x: 28, y: 0 })
        }
      }
      .width(42)
      .height(27)
      Text(item.label)
        .fontColor(this.activeTab === item.index ? this.palette().primary : this.palette().muted)
        .fontSize(item.index === 3 ? 8.5 : 10)
        .fontWeight(this.activeTab === item.index ? FontWeight.Bold : FontWeight.Medium)
        .maxLines(1)
    }
    .layoutWeight(1)
    .height(54)
    .justifyContent(FlexAlign.Center)
    .alignItems(HorizontalAlign.Center)
    .backgroundColor(this.activeTab === item.index ? this.palette().soft : Color.Transparent)
    .border({
      width: this.activeTab === item.index ? 1 : 0,
      color: this.activeTab === item.index ? this.palette().primary : Color.Transparent
    })
    .borderRadius(27)
    .margin({ left: 2, right: 2 })
    .onClick(() => this.onNavigate(item.index))
  }

  build() {
    Row() {
      ForEach([
        { label: 'é¦–é¡µ', symbol: $r('sys.symbol.house'), index: 0 },
        { label: 'è¯¾ç¨‹', symbol: $r('sys.symbol.book'), index: 1 },
        { label: 'å¾…åŠ', symbol: $r('sys.symbol.checkmark_circle'), index: 2 },
        { label: 'AI æ ¡å›­åŠ©æ‰‹', symbol: $r('sys.symbol.robot'), index: 3 },
        { label: 'æˆ‘çš„', symbol: $r('sys.symbol.person'), index: 4 }
      ], (item: DockItem) => {
        this.DockItemView(item)
      })
    }
    .width('100%')
    .height(76)
    .padding({ left: 7, right: 7, top: 7, bottom: 7 })
    .alignItems(VerticalAlign.Center)
    .backgroundColor(this.darkMode ? '#EB14272E' : '#EBFFFFFFFF')
    .border({ width: 1, color: this.palette().line })
    .borderRadius(38)
    .shadow({ radius: 18, color: this.darkMode ? '#66000000' : '#240B1830', offsetY: 6 })
    .margin({ left: 14, right: 14, bottom: 10 })
  }
}
