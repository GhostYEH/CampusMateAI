      }.width('100%')
      Text(item.title).fontColor(this.palette().text).fontSize(15).fontWeight(FontWeight.Bold).width('100%').maxLines(1)
      Text(item.summary ?? 'æš‚æ— æ´»åŠ¨ç®€ä»‹').fontColor(this.palette().muted).fontSize(10).width('100%').maxLines(2)
      Row({ space: 10 }) {
        Text(item.author_name ?? 'æ ¡å›­æ´»åŠ¨ä¸­å¿ƒ').fontColor(this.palette().primary).fontSize(10)
        Text(item.location ?? 'åœ°ç‚¹å¾…å®š').fontColor(this.palette().muted).fontSize(10)
      }.width('100%')
    }.width('100%').padding(13).backgroundColor(this.palette().surface).borderRadius(17)
  }

  @Builder FavoriteRow(item: FavoriteItem) {
    Row({ space: 11 }) {
      Stack({ alignContent: Alignment.Center }) { SymbolGlyph($r('sys.symbol.bookmark_fill')).fontSize(20).fontColor([this.palette().primary]) }
        .width(44).height(44).backgroundColor(this.palette().soft).borderRadius(13)
      Column({ space: 4 }) {
        Text(item.title).fontColor(this.palette().text).fontSize(13).fontWeight(FontWeight.Bold).maxLines(1)
        Text(item.subtitle ?? 'å·²ä¿å­˜åˆ°å½“å‰è´¦å·').fontColor(this.palette().muted).fontSize(10).maxLines(1)
        Text(`${item.type ?? 'å†…å®¹'} Â· æ”¶è—äº ${item.saved_at ?? ''}`).fontColor(this.palette().muted).fontSize(9)
      }.layoutWeight(1).alignItems(HorizontalAlign.Start)
    }.width('100%').padding({ top: 11, bottom: 11 })
  }

  build() {
    Column() {
      SecondaryHeader({ title: `æˆ‘çš„${this.title()}`, subtitle: 'å†…å®¹ä»…ä¿å­˜åœ¨å½“å‰ç™»å½•è´¦å·ä¸‹', darkMode: this.darkMode, onBack: () => this.onBack() })
      Column({ space: 12 }) {
        Row({ space: 8 }) {
          SymbolGlyph($r('sys.symbol.magnifyingglass')).fontSize(17).fontColor([this.palette().muted])
          TextInput({ placeholder: `æœç´¢${this.title()}`, text: this.query }).layoutWeight(1).height(43).backgroundColor(Color.Transparent)
            .fontColor(this.palette().text).placeholderColor(this.palette().muted).onChange((value: string) => this.query = value)
          Text('åˆ·æ–°').fontColor(this.palette().primary).fontSize(11).onClick(() => this.onRefresh())
        }.width('100%').height(50).padding({ left: 12, right: 12 }).backgroundColor(this.palette().surface)
          .border({ width: 1, color: this.palette().line }).borderRadius(16)
        if (this.loading) {
          LoadingProgress().width(34).height(34).color(this.palette().primary).margin({ top: 40 })
        } else if (this.section === 'files') {
          if (this.files.length === 0) { Text('æ²¡æœ‰æ‰¾åˆ°æ–‡ä»¶').fontColor(this.palette().muted).fontSize(12).padding(34) }
          else { Column() { ForEach(this.files, (item: PersonalFileItem, index: number) => { this.FileRow(item); if (index < this.files.length - 1) { Divider().color(this.palette().line) } }) }.padding({ left: 13, right: 13 }).backgroundColor(this.palette().surface).borderRadius(18) }
        } else if (this.section === 'activities') {
          if (this.activities.length === 0) { Text('æ²¡æœ‰æ‰¾åˆ°æ´»åŠ¨').fontColor(this.palette().muted).fontSize(12).padding(34) }
          else { Scroll() { Column({ space: 9 }) { ForEach(this.activities, (item: ActivityItem) => { this.ActivityRow(item) }) }.padding({ bottom: 20 }) }.layoutWeight(1).scrollBar(BarState.Off) }
        } else {
          if (this.favorites.length === 0) { Text('è¿˜æ²¡æœ‰æ”¶è—').fontColor(this.palette().muted).fontSize(12).padding(34) }
          else { Column() { ForEach(this.favorites, (item: FavoriteItem, index: number) => { this.FavoriteRow(item); if (index < this.favorites.length - 1) { Divider().color(this.palette().line) } }) }.padding({ left: 13, right: 13 }).backgroundColor(this.palette().surface).borderRadius(18) }
        }
      }.layoutWeight(1).width('100%').padding({ left: 14, right: 14, bottom: 18 })
    }.width('100%').height('100%').backgroundColor(this.palette().background)
  }
}
