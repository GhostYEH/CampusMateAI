//# sourceMappingURL=LoginScreen.js.mapÂÙBF:\demo1\harmony\entry\src\main\ets\features\login\LoginScreen.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂ¶F:\demo1\harmony\entry°F:\demo1\harmony¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName½../features/login/LoginScreen¥entry¶F:\demo1\harmony\entryÃÃÚ	const LOGIN_INK: string = '#111A31';
const LOGIN_BLUE_DEEP: string = '#3E50D9';
const LOGIN_WARM: string = '#FFA45B';
const FORM_TEXT: string = '#F8FAFF';
const FORM_MUTED: string = '#BDEBF0FF';

@Component
export struct LoginScreen {
  @Link username: string;
  @Link password: string;
  @Prop loading: boolean = false;
  @Prop error: string = '';
  @Prop reduceMotion: boolean = false;
  onSubmit: () => void = () => {};
  onInputChanged: () => void = () => {};

  @State showPassword: boolean = false;
  @State usernameFocused: boolean = false;
  @State passwordFocused: boolean = false;
  private videoController: VideoController = new VideoController();

  aboutToDisappear(): void {
    this.videoController.stop();
  }

  @Builder
  LoginBrand() {
    Row() {
      Stack({ alignContent: Alignment.Center }) {
        SymbolGlyph($r('sys.symbol.school'))
          .fontSize(23)
          .fontColor(['#FFFFFFFF'])
      }
      .width(40)
      .height(40)
      .borderRadius(13)
      .backgroundColor(LOGIN_WARM)

      Column({ space: 2 }) {
        Text('CampusMate AI')
          .fontColor('#FFFFFFFF')
          .fontSize(14)
          .fontWeight(FontWeight.Bold)
        Text('æ ¡å›­äº‹åŠ¡ Â· æ¸©å’Œé™ªä¼´')
          .fontColor('#B3FFFFFF')
          .fontSize(9.5)
      }
      .alignItems(HorizontalAlign.Start)
      .margin({ left: 10 })
    }
    .alignItems(VerticalAlign.Center)
  }

  @Builder
  LoginField(label: string, placeholder: string, symbol: Resource, isPassword: boolean) {
    Column({ space: 6 }) {
      Text(label)
        .fontColor(FORM_MUTED)
        .fontSize(11)
        .fontWeight(FontWeight.Medium)
        .width('100%')

      Row({ space: 11 }) {
        SymbolGlyph(symbol)
          .fontSize(18)
          .fontColor([FORM_MUTED])

        TextInput({
          placeholder: placeholder,
          text: isPassword ? this.password : this.username
        })
          .layoutWeight(1)
          .height(44)
          .fontSize(14)
          .fontColor(FORM_TEXT)
          .placeholderFont({ size: 13 })
          .placeholderColor('#75FFFFFF')
          .caretColor('#FFFFFFFF')
          .backgroundColor(Color.Transparent)
          .border({ width: 0 })
          .padding(0)
          .type(isPassword && !this.showPassword ? InputType.Password : InputType.Normal)
          .showPasswordIcon(false)
          .enterKeyType(isPassword ? EnterKeyType.Done : EnterKeyType.Next)
          .onFocus(() => {
            if (isPassword) {
              this.passwordFocused = true;
            } else {
              this.usernameFocused = true;
            }
          })
          .onBlur(() => {
            if (isPassword) {
              this.passwordFocused = false;
            } else {
              this.usernameFocused = false;
            }
          })
          .onChange((value: string) => {
            if (isPassword) {
              this.password = value;
            } else {
              this.username = value;
            }
            this.onInputChanged();
          })
          .onSubmit(() => {
            if (isPassword) {
              this.onSubmit();
            }
          })

        if (isPassword) {
          SymbolGlyph(this.showPassword ? $r('sys.symbol.eye_slash') : $r('sys.symbol.eye'))
            .fontSize(20)
            .fontColor([FORM_MUTED])
            .width(28)
            .height(44)
            .onClick(() => {
              this.showPassword = !this.showPassword;
            })
        }
      }
      .width('100%')
      .height(45)
      .alignItems(VerticalAlign.Center)

      Divider()
        .strokeWidth(1)
        .color((isPassword ? this.passwordFocused : this.usernameFocused) ? '#FFFFFFFF' : '#52FFFFFF')
    }
    .width('100%')
  }

  @Builder
  LoginContent() {
    Scroll() {
      Column() {
        Column() {
          this.LoginBrand()

