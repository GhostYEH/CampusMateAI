          this.LoginField('å¯†ç ', 'è¯·è¾“å…¥å¯†ç ', $r('sys.symbol.lock'), true)

          if (this.error.length > 0) {
            Text(this.error)
              .fontColor('#FFFFC5BF')
              .fontSize(11.5)
              .width('100%')
              .padding({ left: 12, right: 12, top: 9, bottom: 9 })
              .backgroundColor('#663E171A')
              .borderRadius(10)
          }

          Row({ space: 8 }) {
            if (this.loading) {
              LoadingProgress()
                .width(18)
                .height(18)
                .color(LOGIN_BLUE_DEEP)
            } else {
              Text('è¿›å…¥æ ¡å›­ç©ºé—´')
                .fontColor(LOGIN_BLUE_DEEP)
                .fontSize(14)
                .fontWeight(FontWeight.Bold)
              SymbolGlyph($r('sys.symbol.arrow_right'))
                .fontSize(17)
                .fontColor([LOGIN_BLUE_DEEP])
            }
          }
          .width('100%')
          .height(51)
          .justifyContent(FlexAlign.Center)
          .alignItems(VerticalAlign.Center)
          .backgroundColor('#FFFFFFFF')
          .borderRadius(14)
          .opacity(this.loading ? 0.82 : 1.0)
          .onClick(() => {
            if (!this.loading) {
              this.onSubmit();
            }
          })

          Text('ç™»å½•å³è¡¨ç¤ºä½ å·²é˜…è¯»å¹¶åŒæ„æ ¡å›­æ•°æ®ä½¿ç”¨è¯´æ˜')
            .fontColor('#7AFFFFFF')
            .fontSize(9.5)
            .width('100%')
            .textAlign(TextAlign.Center)
        }
        .width('100%')
        .alignItems(HorizontalAlign.Start)
        .padding({ left: 24, top: 18, right: 24, bottom: 24 })
      }
      .width('100%')
    }
    .width('100%')
    .height('100%')
    .scrollBar(BarState.Off)
  }

  build() {
    Stack() {
      Image($r('app.media.campus_login_poster'))
        .width('100%')
        .height('100%')
        .objectFit(ImageFit.Cover)
        .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])

      if (!this.reduceMotion) {
        Video({
          src: $r('app.media.login_campus'),
          previewUri: $r('app.media.campus_login_poster'),
          controller: this.videoController
        })
          .width('100%')
          .height('100%')
          .objectFit(ImageFit.Cover)
          .autoPlay(true)
          .muted(true)
          .controls(false)
          .loop(true)
          .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
      }

      Column() {}
        .width('100%')
        .height('100%')
        .linearGradient({
          angle: 180,
          colors: [
            ['#5C091632', 0.0],
            ['#52091632', 0.38],
            ['#C4091632', 0.68],
            ['#F0091632', 1.0]
          ]
        })
        .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])

      this.LoginContent()
    }
    .width('100%')
    .height('100%')
    .backgroundColor(LOGIN_INK)
  }
}
