      Row({ space: 8 }) {
        SymbolGlyph($r('sys.symbol.clock')).fontSize(18).fontColor([this.palette().primary])
        Text('èŠ‚æ¬¡').fontColor(this.palette().text).fontSize(15).fontWeight(FontWeight.Bold)
      }.width('100%')
      Row({ space: 6 }) {
        ForEach(['1-2èŠ‚','3-4èŠ‚','5-6èŠ‚','7-8èŠ‚'], (item: string) => { this.Chip(item, this.slot === item, () => this.slot = item) })
      }.width('100%')
      Divider().color(this.palette().line)
      Row({ space: 8 }) {
        SymbolGlyph($r('sys.symbol.person_2')).fontSize(18).fontColor([this.palette().primary])
        Text('å®¹é‡').fontColor(this.palette().text).fontSize(15).fontWeight(FontWeight.Bold)
      }.width('100%')
      Row({ space: 6 }) {
        ForEach(['å…¨éƒ¨å®¹é‡','>=40åº§','>=80åº§','>=100åº§'], (item: string) => { this.Chip(item, this.capacity === item, () => this.capacity = item) })
      }.width('100%')
      Divider().color(this.palette().line)
      Row({ space: 10 }) {
        SymbolGlyph($r('sys.symbol.computer')).fontSize(20).fontColor([this.palette().primary])
        Column({ space: 2 }) {
          Text('ä»…æ˜¾ç¤ºæœ‰å¤šåª’ä½“è®¾å¤‡').fontColor(this.palette().text).fontSize(13).fontWeight(FontWeight.Bold)
          Text('æŠ•å½±ã€éŸ³å“ç­‰æ•™å­¦è®¾å¤‡').fontColor(this.palette().muted).fontSize(10)
        }.layoutWeight(1).alignItems(HorizontalAlign.Start)
        Toggle({ type: ToggleType.Switch, isOn: this.multimedia }).onChange((value: boolean) => this.multimedia = value)
      }.width('100%')
    }.width('100%').padding(14).backgroundColor(this.palette().surface)
      .border({ width: 1, color: this.palette().line }).borderRadius(18)
  }

  @Builder ClassroomCard(item: ClassroomAvailability) {
