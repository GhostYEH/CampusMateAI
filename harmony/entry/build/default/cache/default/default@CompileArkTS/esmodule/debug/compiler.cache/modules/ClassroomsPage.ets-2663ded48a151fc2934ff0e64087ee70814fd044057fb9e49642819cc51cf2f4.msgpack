  build() {
    Column() {
      SecondaryHeader({ title: 'ç©ºæ•™å®¤æŸ¥è¯¢', subtitle: 'åŸºäºè¯¾ç¨‹å ç”¨æ•°æ®ï¼Œå¸®ä½ å¿«é€Ÿæ‰¾åˆ°å¯ç”¨æ•™å®¤', darkMode: this.darkMode, onBack: () => this.onBack() })
      Scroll() {
        Column({ space: 13 }) {
          Image($r('app.media.hero_classroom')).width('100%').height(170).objectFit(ImageFit.Cover).borderRadius(20)
          this.FilterPanel()
          Button({ type: ButtonType.Capsule }) {
            Row({ space: 8 }) {
              if (this.loading) { LoadingProgress().width(20).height(20).color('#FFFFFFFF') }
              else { SymbolGlyph($r('sys.symbol.magnifyingglass')).fontSize(18).fontColor(['#FFFFFFFF']) }
              Text(this.loading ? 'æ­£åœ¨æŸ¥è¯¢...' : 'æŸ¥è¯¢ç©ºé—²æ•™å®¤').fontColor('#FFFFFFFF').fontSize(15).fontWeight(FontWeight.Bold)
            }
          }.width('100%').height(52).backgroundColor(this.palette().primary).onClick(() => this.onQuery())
          Row() {
            Row({ space: 8 }) {
              Rect().width(5).height(24).fill(this.palette().primary).radius(3)
              Text('æ¨èç©ºæ•™å®¤').fontColor(this.palette().text).fontSize(17).fontWeight(FontWeight.Bold)
            }
            Blank()
            Text(`å…± ${this.classrooms.length} é—´å¯ç”¨`).fontColor(this.palette().muted).fontSize(10)
          }.width('100%').alignItems(VerticalAlign.Center)
          if (!this.loading && this.classrooms.length === 0) {
            Text('å½“å‰æ¡ä»¶ä¸‹æ²¡æœ‰å¯ç”¨æ•™å®¤ï¼Œè¯·è°ƒæ•´ç­›é€‰æ¡ä»¶ã€‚').fontColor(this.palette().muted).fontSize(12).padding({ top: 24, bottom: 28 })
          } else {
            ForEach(this.classrooms, (item: ClassroomAvailability) => { this.ClassroomCard(item) })
          }
        }.width('100%').padding({ left: 14, right: 14, bottom: 24 })
      }.layoutWeight(1).width('100%').scrollBar(BarState.Off)
    }.width('100%').height('100%').backgroundColor(this.palette().background)
  }
}
