  // 返回名字首字母(大写)。中文取拼音首字母, 非中文取原字符大写, 未覆盖中文回退 "#"。
  static of(name: string): string {
    if (name.length === 0) return "#";
    const ch: string = name.charAt(0);
    if (ch >= "A" && ch <= "Z") return ch;
    if (ch >= "a" && ch <= "z") return ch.toUpperCase();
    const fl: string | undefined = PinyinInitial.MAP[ch];
    return fl !== undefined ? fl : "#";
  }

  // 返回名字完整首字母串(每个字一字母), 用于搜索匹配。
  static initials(name: string): string {
    let result: string = "";
    for (let i = 0; i < name.length; i++) {
      const ch: string = name.charAt(i);
      if (ch >= "A" && ch <= "Z") { result += ch; continue; }
      if (ch >= "a" && ch <= "z") { result += ch.toUpperCase(); continue; }
      const fl: string | undefined = PinyinInitial.MAP[ch];
      result += fl !== undefined ? fl : "";
    }
    return result;
  }
