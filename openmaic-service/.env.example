# Bind to loopback or an internal network interface only.
OPENMAIC_HOST=127.0.0.1
OPENMAIC_PORT=4010

# Service-owned SQLite database. Required: the assertion replay records, and the
# workspace/stage/material/idempotency data that follows, live here. A relative
# path resolves against the openmaic-service directory, never against the
# caller's working directory. Only local file paths are accepted.
OPENMAIC_DATABASE_URL=./data/openmaic-service.db

# Shared secret for the short-lived CampusMate -> service assertions. Inject it
# through a secret manager in deployments and never commit a value. The service
# refuses to start when this is empty.
OPENMAIC_INTERNAL_SECRET=

# Optional external 3D/CDN origin. When unset, visualization3d scenes degrade
# explicitly ("widget_requires_external_cdn") instead of rendering blank.
OPENMAIC_EXTERNAL_CDN_URL=

# Optional OpenAI-compatible chat-completions endpoint used for stage generation
# and round-table discussion. Both BASE_URL and API_KEY must be set together;
# the URL must be an http(s) origin ending in the API root (usually /v1). When
# unset, generation degrades to the built-in local template and discussion
# answers 503 provider_unavailable.
# OPENMAIC_PROVIDER_BASE_URL=https://example-relay.example/v1
# OPENMAIC_PROVIDER_API_KEY=
OPENMAIC_PROVIDER_MODEL=muse-spark-1.3
OPENMAIC_PROVIDER_TIMEOUT_SECONDS=120

# Optional OpenAI-compatible TTS endpoint (MiMo TTS: model mimo-v2.5-tts,
# response choices[0].message.audio.data carries base64 WAV). Same pairing
# rules as the provider; when unset, speech synthesis answers 503
# provider_unavailable. Voice defaults to 苏打.
# OPENMAIC_TTS_BASE_URL=https://api.xiaomimimo.com/v1
# OPENMAIC_TTS_API_KEY=
OPENMAIC_TTS_MODEL=mimo-v2.5-tts
OPENMAIC_TTS_VOICE=苏打
OPENMAIC_TTS_TIMEOUT_SECONDS=180
